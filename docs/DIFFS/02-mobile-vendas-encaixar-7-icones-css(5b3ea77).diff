--- a/frontend/src/app/vendas/page.module.css
+++ b/frontend/src/app/vendas/page.module.css
@@ -3,3 +3,67 @@
     width: 100%;
   }
 }
+
+/* HBX mobile vendas visual filters: seven icon buttons, no score control. */
+@media (max-width: 820px) {
+  .mobileVendasVisualFilterScroller {
+    align-items: center !important;
+  }
+
+  .mobileVendasVisualFilterScroller > button,
+  .mobileVendasClearVisualFilters {
+    min-width: 0 !important;
+    box-sizing: border-box !important;
+  }
+
+  .mobileVendasVisualFilterScroller > button > .mobileVendasChannelIcon {
+    width: 25px !important;
+    height: 25px !important;
+  }
+
+  .mobileVendasChannelIcon > img,
+  .mobileVendasChannelAssetLight,
+  .mobileVendasChannelAssetDark,
+  .mobileVendasChannelIcon[data-channel] img,
+  .mobileVendasChannelIcon[data-channel][data-compact="true"] img {
+    width: 100% !important;
+    height: 100% !important;
+    max-width: 100% !important;
+    max-height: 100% !important;
+    object-fit: contain !important;
+    object-position: center !important;
+  }
+
+  .mobileVendasClearVisualFilters {
+    display: inline-grid !important;
+    place-items: center !important;
+    color: #dc2626 !important;
+    line-height: 0 !important;
+  }
+
+  .mobileVendasClearVisualFilters > svg {
+    width: 18px !important;
+    height: 18px !important;
+    fill: none !important;
+    stroke: currentColor !important;
+    stroke-width: 2.15 !important;
+    stroke-linecap: round !important;
+    stroke-linejoin: round !important;
+  }
+}
+
+@media (max-width: 430px) {
+  .mobileVendasVisualFilterScroller {
+    grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
+    gap: 4px !important;
+    padding: 8px !important;
+  }
+
+  .mobileVendasVisualFilterScroller > button,
+  .mobileVendasClearVisualFilters {
+    width: 100% !important;
+    height: 38px !important;
+    min-height: 38px !important;
+    padding: 0 !important;
+  }
+}
