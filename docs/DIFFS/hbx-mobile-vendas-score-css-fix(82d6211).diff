+.mobileVendasVisualFilterScroller > button[aria-disabled="true"] {
+  cursor: not-allowed;
+  opacity: 0.58;
+}
+
+.mobileVendasScoreIconFilter {
+  position: relative;
+  min-width: 48px !important;
+  color: #0b66ff !important;
+  font-weight: 950 !important;
+}
+
+.mobileVendasScoreIconFilter > strong {
+  display: grid;
+  width: 31px;
+  height: 31px;
+  place-items: center;
+  border-radius: 11px;
+  background: rgba(37, 99, 235, 0.1);
+  color: currentColor;
+  font-size: 0.86rem;
+  line-height: 1;
+}
+
+.mobileVendasScoreIconFilter > b {
+  position: absolute;
+  top: 2px;
+  right: 2px;
+  min-width: 14px;
+  height: 14px;
+  padding: 0 3px;
+  border-radius: 999px;
+  background: #0b66ff;
+  color: #ffffff !important;
+  font-size: 0.48rem !important;
+  line-height: 14px;
+}
+
+.mobileVendasScoreIconFilter > b::after {
+  content: none !important;
+}
+
+.mobileVendasScorePopover {
+  position: absolute;
+  top: calc(100% + 6px);
+  right: 9px;
+  z-index: 20;
+  display: grid;
+  gap: 8px;
+  min-width: 176px;
+  padding: 10px;
+  border: 1px solid rgba(37, 99, 235, 0.22);
+  border-radius: 15px;
+  background: rgba(255, 255, 255, 0.98);
+  box-shadow: 0 18px 36px -24px rgba(15, 23, 42, 0.42);
+}
+
+.mobileVendasScorePopover > div:first-child {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.mobileVendasScorePopover span {
+  color: #64748b;
+  font-size: 0.68rem;
+  font-weight: 850;
+}
+
+.mobileVendasScorePopover strong {
+  color: #0b66ff;
+  font-size: 0.82rem;
+  font-weight: 950;
+}
+
+.mobileVendasScorePopover > div:last-child {
+  display: grid;
+  grid-template-columns: 34px 34px minmax(0, 1fr);
+  gap: 6px;
+}
+
+.mobileVendasScorePopover button {
+  min-height: 32px;
+  border: 0;
+  border-radius: 10px;
+  background: #0f172a;
+  color: #ffffff;
+  font: inherit;
+  font-size: 0.72rem;
+  font-weight: 900;
+}
+
+.mobileVendasScorePopover button:disabled {
+  background: rgba(148, 163, 184, 0.34);
+  color: rgba(71, 85, 105, 0.66);
+}
+
+:global(html[data-hbx-mobile-theme="dark"]) .mobileVendasScorePopover {
+  border-color: rgba(96, 165, 250, 0.24);
+  background: rgba(7, 19, 39, 0.98);
+  box-shadow: 0 18px 36px -24px rgba(0, 0, 0, 0.82);
+}
+
+:global(html[data-hbx-mobile-theme="dark"]) .mobileVendasScorePopover span {
+  color: rgba(226, 234, 248, 0.72);
+}
+
+:global(html[data-hbx-mobile-theme="dark"]) .mobileVendasScorePopover strong {
+  color: #93c5fd;
+}
