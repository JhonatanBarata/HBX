-        # process not found
-    }
-}
-
-function Resolve-PidValue($value) {
-    if ($null -eq $value) { return 0 }
-    if ($value -is [array]) {
-        for ($i = $value.Count - 1; $i -ge 0; $i--) {
-            $resolved = Resolve-PidValue $value[$i]
-            if ($resolved -gt 0) { return $resolved }
