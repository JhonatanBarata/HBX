diff --git a/frontend/src/app/vendas/page.module.css b/frontend/src/app/vendas/page.module.css
index a0ac110..b54d8a2 100644
--- a/frontend/src/app/vendas/page.module.css
+++ b/frontend/src/app/vendas/page.module.css
@@ -10636,3 +10636,172 @@
     max-height: 68% !important;
   }
 }
+
+/* HBX mobile vendas filters: 8 compact slots, full-size icons and score popup. */
+@media (max-width: 430px) {
+  .mobileVendasVisualFilters {
+    position: relative !important;
+  }
+
+  .mobileVendasVisualFilterScroller {
+    grid-template-columns: repeat(8, minmax(0, 1fr)) !important;
+    gap: 4px !important;
+    padding: 8px 7px !important;
+  }
+
+  .mobileVendasVisualFilterScroller > button {
+    min-width: 0 !important;
+    height: 38px !important;
+    padding: 0 !important;
+  }
+
+  .mobileVendasVisualFilterScroller > button > .mobileVendasChannelIcon {
+    width: 31px !important;
+    height: 31px !important;
+    border-radius: 11px !important;
+  }
+
+  .mobileVendasChannelIcon > img,
+  .mobileVendasChannelAssetLight,
+  .mobileVendasChannelAssetDark {
+    width: 90% !important;
+    height: 90% !important;
+    max-width: 90% !important;
+    max-height: 90% !important;
+  }
+
+  .mobileVendasChannelIcon[data-channel="whatsapp"] img,
+  .mobileVendasChannelIcon[data-channel="instagram"] img,
+  .mobileVendasChannelIcon[data-channel="facebook"] img {
+    width: 95% !important;
+    height: 95% !important;
+    max-width: 95% !important;
+    max-height: 95% !important;
+  }
+
+  .mobileVendasChannelIcon[data-channel="phone"] img,
+  .mobileVendasChannelIcon[data-channel="email"] img,
+  .mobileVendasChannelIcon[data-channel="site"] img {
+    width: 88% !important;
+    height: 88% !important;
+    max-width: 88% !important;
+    max-height: 88% !important;
+  }
+
+  .mobileVendasScoreIconFilter {
+    position: relative !important;
+    color: #0b66ff !important;
+    font-weight: 950 !important;
+  }
+
+  .mobileVendasScoreIconFilter > strong {
+    display: grid !important;
+    width: 31px !important;
+    height: 31px !important;
+    place-items: center !important;
+    border-radius: 11px !important;
+    background: rgba(37, 99, 235, 0.1) !important;
+    color: currentColor !important;
+    font-size: 0.86rem !important;
+    line-height: 1 !important;
+  }
+
+  .mobileVendasScoreIconFilter > b {
+    position: absolute !important;
+    top: 2px !important;
+    right: 2px !important;
+    min-width: 14px !important;
+    height: 14px !important;
+    padding: 0 3px !important;
+    border-radius: 999px !important;
+    background: #0b66ff !important;
+    color: #ffffff !important;
+    font-size: 0.48rem !important;
+    line-height: 14px !important;
+  }
+
+  .mobileVendasScoreIconFilter > b::after {
+    content: none !important;
+  }
+
+  .mobileVendasClearVisualFilters svg {
+    width: 18px !important;
+    height: 18px !important;
+  }
+}
+
+@media (max-width: 820px) {
+  .mobileVendasVisualFilters {
+    position: relative !important;
+  }
+
+  .mobileVendasScorePopover {
+    position: absolute;
+    top: calc(100% + 6px);
+    right: 9px;
+    z-index: 20;
+    display: grid;
+    gap: 8px;
+    min-width: 176px;
+    padding: 10px;
+    border: 1px solid rgba(37, 99, 235, 0.22);
+    border-radius: 15px;
+    background: rgba(255, 255, 255, 0.98);
+    box-shadow: 0 18px 36px -24px rgba(15, 23, 42, 0.42);
+  }
+
+  .mobileVendasScorePopover > div:first-child {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 10px;
+  }
+
+  .mobileVendasScorePopover span {
+    color: #64748b;
+    font-size: 0.68rem;
+    font-weight: 850;
+  }
+
+  .mobileVendasScorePopover strong {
+    color: #0b66ff;
+    font-size: 0.82rem;
+    font-weight: 950;
+  }
+
+  .mobileVendasScorePopover > div:last-child {
+    display: grid;
+    grid-template-columns: 34px 34px minmax(0, 1fr);
+    gap: 6px;
+  }
+
+  .mobileVendasScorePopover button {
+    min-height: 32px;
+    border: 0;
+    border-radius: 10px;
+    background: #0f172a;
+    color: #ffffff;
+    font: inherit;
+    font-size: 0.72rem;
+    font-weight: 900;
+  }
+
+  .mobileVendasScorePopover button:disabled {
+    background: rgba(148, 163, 184, 0.34);
+    color: rgba(71, 85, 105, 0.66);
+  }
+
+  :global(html[data-hbx-mobile-theme="dark"]) .mobileVendasScorePopover {
+    border-color: rgba(96, 165, 250, 0.24);
+    background: rgba(7, 19, 39, 0.98);
+    box-shadow: 0 18px 36px -24px rgba(0, 0, 0, 0.82);
+  }
+
+  :global(html[data-hbx-mobile-theme="dark"]) .mobileVendasScorePopover span {
+    color: rgba(226, 234, 248, 0.72);
+  }
+
+  :global(html[data-hbx-mobile-theme="dark"]) .mobileVendasScorePopover strong {
+    color: #93c5fd;
+  }
+}
