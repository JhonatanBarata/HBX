Subject: master: refactor premium command center readability

diff --git a/frontend/src/app/master/_command-center/MasterCommandCenter.module.css b/frontend/src/app/master/_command-center/MasterCommandCenter.module.css
--- a/frontend/src/app/master/_command-center/MasterCommandCenter.module.css
+++ b/frontend/src/app/master/_command-center/MasterCommandCenter.module.css
@@ -0,0 +1,359 @@
+/* -------------------------------------------------------------------------- */
+/* MASTER PREMIUM READABILITY FIX - item 1 final                              */
+/* Append-only patch for docs/DIFFS watcher.                                  */
+/* -------------------------------------------------------------------------- */
+
+.masterShell {
+  --master-readable-text: #0f172a;
+  --master-readable-muted: #475569;
+  padding: 18px !important;
+  color: var(--master-readable-text) !important;
+  background:
+    radial-gradient(circle at 0% 0%, rgba(37, 99, 235, 0.15), transparent 420px),
+    radial-gradient(circle at 100% 0%, rgba(20, 184, 166, 0.14), transparent 390px),
+    linear-gradient(180deg, #f8fbff 0%, #edf4fa 48%, #e8f0f7 100%) !important;
+}
+
+.topCommandBar {
+  display: grid !important;
+  grid-template-columns: 310px minmax(620px, 1fr) 340px !important;
+  grid-template-areas: "identity workstation actions" !important;
+  gap: 16px !important;
+  align-items: stretch !important;
+  margin-bottom: 18px !important;
+}
+
+.commandIdentity {
+  grid-area: identity !important;
+  min-height: 178px !important;
+  padding: 22px !important;
+}
+
+.commandIdentity strong {
+  max-width: 245px !important;
+  font-size: 46px !important;
+  line-height: 0.9 !important;
+  letter-spacing: -0.075em !important;
+}
+
+.commandIdentity small {
+  margin-top: 8px !important;
+  font-size: 12px !important;
+  line-height: 1.35 !important;
+}
+
+.commandIdentityMeta {
+  margin-top: 14px !important;
+}
+
+.commandWorkstation {
+  grid-area: workstation !important;
+  min-height: 178px !important;
+  padding: 18px !important;
+  border: 1px solid rgba(120, 139, 164, 0.28) !important;
+  border-radius: 28px !important;
+  background:
+    radial-gradient(circle at 100% 0%, rgba(20, 184, 166, 0.12), transparent 300px),
+    rgba(255, 255, 255, 0.9) !important;
+  box-shadow: 0 22px 58px rgba(15, 23, 42, 0.10) !important;
+  backdrop-filter: blur(18px) !important;
+}
+
+.commandWorkstation .searchBox {
+  min-height: auto !important;
+  padding: 0 !important;
+  border: 0 !important;
+  background: transparent !important;
+  box-shadow: none !important;
+}
+
+.commandWorkstation .searchBox label {
+  display: block !important;
+  margin-bottom: 8px !important;
+  color: #64748b !important;
+  font-size: 12px !important;
+  font-weight: 950 !important;
+  letter-spacing: 0.16em !important;
+  text-transform: uppercase !important;
+}
+
+.commandWorkstation .searchBox input {
+  min-height: 58px !important;
+  border-radius: 18px !important;
+  border-color: rgba(100, 116, 139, 0.26) !important;
+  background: #ffffff !important;
+  color: #0f172a !important;
+  font-size: 16px !important;
+  font-weight: 850 !important;
+}
+
+.commandWorkstation .searchBox input::placeholder {
+  color: #94a3b8 !important;
+}
+
+.commandWorkstation .filterRail {
+  display: flex !important;
+  flex-wrap: wrap !important;
+  gap: 9px !important;
+  margin-top: 14px !important;
+  padding: 0 !important;
+}
+
+.commandWorkstation .filterButton {
+  min-height: 42px !important;
+  border-radius: 999px !important;
+  padding: 0 17px !important;
+  font-size: 12px !important;
+  font-weight: 950 !important;
+}
+
+.commandActionPanel {
+  grid-area: actions !important;
+  min-height: 178px !important;
+  padding: 16px !important;
+  border: 1px solid rgba(120, 139, 164, 0.28) !important;
+  border-radius: 28px !important;
+  background: rgba(255, 255, 255, 0.92) !important;
+  box-shadow: 0 22px 58px rgba(15, 23, 42, 0.10) !important;
+  backdrop-filter: blur(18px) !important;
+}
+
+.commandActionHeader {
+  display: flex !important;
+  flex-direction: column !important;
+  gap: 3px !important;
+  margin-bottom: 12px !important;
+}
+
+.commandActionHeader span {
+  display: block !important;
+  color: #64748b !important;
+  font-size: 11px !important;
+  font-weight: 950 !important;
+  letter-spacing: 0.12em !important;
+  text-transform: uppercase !important;
+}
+
+.commandActionHeader strong {
+  display: block !important;
+  color: #0f172a !important;
+  font-size: 18px !important;
+  line-height: 1.05 !important;
+  letter-spacing: -0.035em !important;
+}
+
+.commandActionPanel .commandActions {
+  display: grid !important;
+  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
+  gap: 8px !important;
+  align-items: stretch !important;
+}
+
+.commandActionPanel .actionButton {
+  width: 100% !important;
+  min-height: 40px !important;
+  border-radius: 13px !important;
+  padding: 0 10px !important;
+  font-size: 12px !important;
+  white-space: normal !important;
+  text-align: center !important;
+}
+
+.operationsSurface {
+  display: grid !important;
+  gap: 16px !important;
+}
+
+.kpiStrip {
+  display: grid !important;
+  grid-template-columns: repeat(6, minmax(170px, 1fr)) !important;
+  gap: 12px !important;
+  margin-bottom: 0 !important;
+}
+
+.kpiCard {
+  min-height: 132px !important;
+  padding: 18px !important;
+  border-radius: 24px !important;
+  background: rgba(255, 255, 255, 0.88) !important;
+}
+
+.kpiCard span {
+  color: #64748b !important;
+  font-size: 11px !important;
+  letter-spacing: 0.13em !important;
+}
+
+.kpiCard strong {
+  margin-top: 8px !important;
+  color: #0f172a !important;
+  font-size: 40px !important;
+  line-height: 1 !important;
+  letter-spacing: -0.06em !important;
+}
+
+.kpiCard small {
+  color: #475569 !important;
+  font-size: 12px !important;
+  font-weight: 850 !important;
+}
+
+.kpiCard[data-active="true"] span,
+.kpiCard[data-active="true"] strong,
+.kpiCard[data-active="true"] small {
+  color: #ffffff !important;
+}
+
+.commandLayout {
+  display: grid !important;
+  grid-template-columns: minmax(620px, 0.92fr) minmax(760px, 1.08fr) !important;
+  gap: 16px !important;
+  align-items: start !important;
+}
+
+.companyBoard {
+  position: sticky !important;
+  top: 14px !important;
+  max-height: calc(100vh - 28px) !important;
+  padding: 16px !important;
+  border-radius: 28px !important;
+  background: rgba(255, 255, 255, 0.9) !important;
+}
+
+.boardHeader {
+  display: flex !important;
+  justify-content: space-between !important;
+  gap: 12px !important;
+  align-items: flex-start !important;
+  margin-bottom: 14px !important;
+}
+
+.boardHeader strong {
+  color: #0f172a !important;
+  font-size: 24px !important;
+  line-height: 1 !important;
+}
+
+.boardHeader small {
+  color: #64748b !important;
+  font-size: 12px !important;
+  font-weight: 800 !important;
+}
+
+.companyRows {
+  gap: 12px !important;
+}
+
+.companyRow {
+  display: grid !important;
+  grid-template-columns: minmax(220px, 1fr) minmax(180px, 0.8fr) minmax(180px, 0.85fr) !important;
+  gap: 12px !important;
+  align-items: center !important;
+  padding: 17px !important;
+  border-radius: 22px !important;
+  background: rgba(255, 255, 255, 0.92) !important;
+}
+
+.companyMain strong {
+  color: #0f172a !important;
+  font-size: 17px !important;
+  line-height: 1.15 !important;
+}
+
+.companyMain span,
+.rowFacts,
+.rowNext {
+  color: #64748b !important;
+  font-size: 13px !important;
+  font-weight: 750 !important;
+}
+
+.rowStatus span {
+  color: #475569 !important;
+  font-weight: 850 !important;
+}
+
+.rowActions {
+  gap: 8px !important;
+}
+
+.rowActions .actionButton {
+  min-height: 38px !important;
+  padding: 0 14px !important;
+  border-radius: 12px !important;
+  font-size: 12px !important;
+}
+
+.inspector {
+  min-height: 520px !important;
+  padding: 18px !important;
+  border-radius: 28px !important;
+  background: rgba(255, 255, 255, 0.9) !important;
+}
+
+.emptyState,
+.loadingState {
+  min-height: 190px !important;
+  color: #64748b !important;
+  font-size: 15px !important;
+  font-weight: 850 !important;
+}
+
+.panelSection {
+  border-radius: 24px !important;
+}
+
+.companyHero {
+  border-radius: 28px !important;
+  padding: 30px !important;
+}
+
+.companyHero h2 {
+  font-size: clamp(42px, 4.8vw, 68px) !important;
+  line-height: 0.92 !important;
+}
+
+@media (max-width: 1540px) {
+  .topCommandBar {
+    grid-template-columns: 280px minmax(520px, 1fr) 300px !important;
+  }
+
+  .commandLayout {
+    grid-template-columns: minmax(540px, 0.9fr) minmax(620px, 1.1fr) !important;
+  }
+
+  .kpiStrip {
+    grid-template-columns: repeat(3, minmax(190px, 1fr)) !important;
+  }
+}
+
+@media (max-width: 1180px) {
+  .topCommandBar {
+    grid-template-columns: 1fr !important;
+    grid-template-areas:
+      "identity"
+      "workstation"
+      "actions" !important;
+  }
+
+  .commandLayout {
+    grid-template-columns: 1fr !important;
+  }
+
+  .companyBoard {
+    position: static !important;
+    max-height: none !important;
+  }
+
+  .commandActionPanel .commandActions {
+    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
+  }
+}
+
+@media (max-width: 760px) {
+  .kpiStrip,
+  .commandActionPanel .commandActions,
+  .companyRow {
+    grid-template-columns: 1fr !important;
+  }
+}
