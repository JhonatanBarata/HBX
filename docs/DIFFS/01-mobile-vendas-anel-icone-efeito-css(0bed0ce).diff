+
+@keyframes hbxMobileVendasEnrichmentRingSpin {
+  to {
+    rotate: 360deg;
+  }
+}
+
+@keyframes hbxMobileVendasEnrichmentBreath {
+  0%,
+  100% {
+    filter: saturate(1);
+    transform: translateY(-5px) scale(1);
+  }
+
+  50% {
+    filter: saturate(1.22);
+    transform: translateY(-5px) scale(1.045);
+  }
+}
+
+@keyframes hbxMobileVendasEnrichmentCoin {
+  0% {
+    transform: scale(0.88) rotateY(0deg);
+    background:
+      radial-gradient(circle at 32% 22%, rgba(255, 255, 255, 0.92) 0 10%, transparent 24%),
+      linear-gradient(145deg, #e5e7eb, #9ca3af);
+  }
+
+  42% {
+    transform: scale(0.93) rotateY(92deg);
+  }
+
+  58%,
+  100% {
+    transform: scale(0.88) rotateY(360deg);
+    background:
+      radial-gradient(circle at 32% 22%, #fff8d7 0 10%, transparent 24%),
+      linear-gradient(145deg, #fff0a5, #f2b83b);
+  }
+}
+
+@keyframes hbxMobileVendasEnrichmentCrown {
