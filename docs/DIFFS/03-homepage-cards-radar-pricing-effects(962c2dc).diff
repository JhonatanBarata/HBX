diff --git a/frontend/src/app/page.module.css b/frontend/src/app/page.module.css
--- a/frontend/src/app/page.module.css
+++ b/frontend/src/app/page.module.css
@@ -856,3 +856,144 @@
 }

 /* hbx-premium-layer-01-end */
+
+/* HBX homepage premium layer 02: cards, radar and pricing */
+.metric,
+.pipelineCard,
+.engineCard,
+.planCard,
+.proofCard,
+.engineBoard {
+  border-radius: var(--home-radius);
+  transform: translateZ(0);
+  animation: hbxCardRise 720ms var(--home-ease) both;
+  transition: transform 240ms var(--home-ease), border-color 240ms var(--home-ease), box-shadow 240ms var(--home-ease), background 240ms var(--home-ease);
+}
+
+.metric:nth-child(2),
+.pipelineCard:nth-child(2),
+.engineCard:nth-child(2),
+.planCard:nth-child(2),
+.proofCard:nth-child(2) {
+  animation-delay: 90ms;
+}
+
+.metric:nth-child(3),
+.pipelineCard:nth-child(3),
+.engineCard:nth-child(3),
+.planCard:nth-child(3),
+.proofCard:nth-child(3) {
+  animation-delay: 180ms;
+}
+
+.pipelineCard,
+.engineCard,
+.planCard,
+.proofCard {
+  position: relative;
+  overflow: hidden;
+}
+
+.pipelineCard::before,
+.engineCard::before,
+.planCard::before,
+.proofCard::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), transparent 34%, rgba(55, 213, 255, 0.08));
+  opacity: 0;
+  transition: opacity 240ms var(--home-ease);
+}
+
+.pipelineCard:hover,
+.engineCard:hover,
+.planCard:hover,
+.proofCard:hover,
+.metric:hover {
+  transform: translateY(-7px);
+  border-color: rgba(55, 213, 255, 0.32);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.12),
+    0 34px 86px rgba(0, 0, 0, 0.32),
+    0 0 46px rgba(55, 213, 255, 0.12);
+}
+
+.pipelineCard:hover::before,
+.engineCard:hover::before,
+.planCard:hover::before,
+.proofCard:hover::before {
+  opacity: 1;
+}
+
+.engineBoard {
+  position: relative;
+  overflow: hidden;
+  border-radius: 30px;
+}
+
+.engineBoard::after {
+  content: "";
+  position: absolute;
+  inset: -40%;
+  background: conic-gradient(from 180deg, transparent, rgba(55, 213, 255, 0.16), transparent, rgba(51, 227, 154, 0.12), transparent);
+  animation: hbxSpinSlow 12s linear infinite;
+  opacity: 0.55;
+  pointer-events: none;
+}
+
+.engineBoard > * {
+  position: relative;
+  z-index: 1;
+}
+
+.radarGrid {
+  border-radius: 24px;
+}
+
+.radarDot {
+  animation: hbxDotPulse 2.4s ease-in-out infinite;
+}
+
+.radarDot:nth-child(3n) {
+  animation-delay: 320ms;
+}
+
+.radarDot:nth-child(4n) {
+  animation-delay: 640ms;
+}
+
+.queueRow {
+  border-radius: 18px;
+  transition: transform 200ms var(--home-ease), background 200ms var(--home-ease), border-color 200ms var(--home-ease);
+}
+
+.queueRow:hover {
+  transform: translateX(6px);
+  border-color: rgba(51, 227, 154, 0.28);
+  background: rgba(255, 255, 255, 0.075);
+}
+
+.planCardFeatured {
+  transform: translateY(-10px);
+  background:
+    radial-gradient(circle at 90% 16%, rgba(255, 210, 117, 0.16), transparent 22%),
+    radial-gradient(circle at 24% 0%, rgba(55, 213, 255, 0.2), transparent 36%),
+    linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04)),
+    var(--home-panel-strong);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.12),
+    0 34px 90px rgba(55, 213, 255, 0.18),
+    0 0 0 1px rgba(55, 213, 255, 0.06);
+}
+
+.planCardFeatured:hover {
+  transform: translateY(-16px);
+}
+
+.planAction {
+  box-shadow: 0 18px 42px rgba(55, 213, 255, 0.18);
+}
+
+.planAction:hover {
+  filter: saturate(1.08);
+  box-shadow: 0 26px 60px rgba(55, 213, 255, 0.28);
+}
+
+/* hbx-premium-layer-02-end */
