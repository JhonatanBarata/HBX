diff --git a/frontend/src/app/vendas/page.module.css b/frontend/src/app/vendas/page.module.css
--- a/frontend/src/app/vendas/page.module.css
+++ b/frontend/src/app/vendas/page.module.css
@@ -10644,5 +10644,92 @@
   .mobileVendasClearVisualFilters {
     min-width: 0;
     width: 100%;
   }
 }
+/* HBX mobile vendas channel icon alignment override. */
+@media (max-width: 820px) {
+  .mobileVendasChannelIcon {
+    position: relative !important;
+    isolation: isolate !important;
+    display: inline-grid !important;
+    place-items: center !important;
+    flex: 0 0 auto !important;
+    overflow: hidden !important;
+    box-sizing: border-box !important;
+    line-height: 0 !important;
+    vertical-align: middle !important;
+  }
+
+  .mobileVendasChannelIcon::before {
+    pointer-events: none !important;
+  }
+
+  .mobileVendasChannelAssetLight,
+  .mobileVendasChannelAssetDark {
+    position: relative !important;
+    inset: auto !important;
+    z-index: 1 !important;
+    display: block;
+    width: 72% !important;
+    height: 72% !important;
+    max-width: 72% !important;
+    max-height: 72% !important;
+    object-fit: contain !important;
+    object-position: center !important;
+    margin: 0 !important;
+    padding: 0 !important;
+    transform: none !important;
+    flex: 0 0 auto !important;
+    line-height: 0 !important;
+  }
+
+  :global(html:not([data-hbx-mobile-theme="dark"])) .mobileVendasChannelAssetLight {
+    display: block !important;
+  }
+
+  :global(html:not([data-hbx-mobile-theme="dark"])) .mobileVendasChannelAssetDark {
+    display: none !important;
+  }
+
+  :global(html[data-hbx-mobile-theme="dark"]) .mobileVendasChannelAssetLight {
+    display: none !important;
+  }
+
+  :global(html[data-hbx-mobile-theme="dark"]) .mobileVendasChannelAssetDark {
+    display: block !important;
+  }
+
+  .mobileVendasVisualFilterScroller > button > .mobileVendasChannelIcon,
+  .mobileVendasRecommendedChannels .mobileVendasChannelIcon,
+  .leadCardChannelRow .mobileVendasChannelIcon {
+    align-self: center !important;
+    justify-self: center !important;
+  }
+
+  .mobileVendasChannelIcon[data-channel="whatsapp"] img,
+  .mobileVendasChannelIcon[data-channel="instagram"] img,
+  .mobileVendasChannelIcon[data-channel="facebook"] img {
+    width: 76% !important;
+    height: 76% !important;
+    max-width: 76% !important;
+    max-height: 76% !important;
+  }
+
+  .mobileVendasChannelIcon[data-channel="phone"] img,
+  .mobileVendasChannelIcon[data-channel="email"] img,
+  .mobileVendasChannelIcon[data-channel="site"] img {
+    width: 70% !important;
+    height: 70% !important;
+    max-width: 70% !important;
+    max-height: 70% !important;
+  }
+
+  .mobileVendasChannelIcon[data-channel="site"][data-compact="true"] img,
+  .mobileVendasChannelIcon[data-channel="email"][data-compact="true"] img,
+  .mobileVendasChannelIcon[data-channel="phone"][data-compact="true"] img {
+    width: 68% !important;
+    height: 68% !important;
+    max-width: 68% !important;
+    max-height: 68% !important;
+  }
+}
