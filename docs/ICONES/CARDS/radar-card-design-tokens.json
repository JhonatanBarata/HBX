  },
  "colors": {
    "brandBlue": "#2563EB",
    "cyan": "#0EA5E9",
    "success": "#16A34A",
    "warning": "#F59E0B",
    "danger": "#EF4444",
    "premiumPurple": "#7C3AED",
    "slate": "#64748B",
    "textDark": "#0F172A",
    "textMuted": "#64748B",
    "lightBg": "#F8FAFC",
    "lightCard": "#FFFFFF",
    "lightBorder": "#CBD5E1",
    "darkBg": "#020617",
    "darkPanel": "#0B1220",
    "darkCard": "#111827",
    "darkBorder": "#1E3A5F",
    "coinGold": "#F59E0B"
