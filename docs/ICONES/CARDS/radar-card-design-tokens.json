    "greenGlow": "0 0 0 1px rgba(22,163,74,0.45), 0 0 22px rgba(22,163,74,0.12)",
    "premiumGlow": "0 0 0 1px rgba(124,58,237,0.45), 0 0 22px rgba(124,58,237,0.14)"
  },
  "layout": {
    "desktop": {
      "collapsedMinHeight": 150,
      "expandedMinHeight": 520,
      "grid": "left data column + center insights + right quality/action column",
      "iconRow": "six contact icons: instagram, facebook, whatsapp, site, email, map"
    },
    "mobile": {
      "collapsedMinHeight": 260,
      "expandedMinHeight": 820,
      "grid": "stacked single column with two-column mini sections when >=390px",
      "iconRow": "scrollable or 3x2 icon grid"
    }
  },
  "statusPills": {
    "delivered": { "label": "Entregue", "color": "success", "icon": "hbx-card-icon-check" },
    "enriching": { "label": "Enriquecendo", "color": "brandBlue", "icon": "hbx-card-icon-loading" },
    "socialPartial": { "label": "Social parcial", "color": "slate", "icon": "hbx-card-icon-users" },
    "whatsappConfirmed": { "label": "WhatsApp confirmado", "color": "success", "icon": "hbx-card-icon-whatsapp" },
    "leadPlus": { "label": "Lead+", "color": "brandBlue", "icon": "hbx-card-icon-lead-plus" },
    "highConfidence": { "label": "Alta confiança", "color": "brandBlue", "icon": "hbx-card-icon-shield" },
    "highPriority": { "label": "Alta prioridade", "color": "warning", "icon": "hbx-card-icon-lightning" }
  },
  "fieldPriority": [
    "name",
    "city",
    "segment",
    "phone",
    "whatsappStatus",
    "instagramUrl",
    "facebookUrl",
    "website",
    "email",
    "cnpj",
    "address",
    "qualityScore",
    "opportunityReason",
