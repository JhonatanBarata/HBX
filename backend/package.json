{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run start:dev",
    "start": "node -r ./scripts/fix-direct-url dist/main.js",
    "start:prod": "node -r ./scripts/fix-direct-url dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only --require dotenv/config src/main.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma --no-hints",
    "prisma:validate": "prisma validate --schema=./prisma/schema.prisma",
    "test:prisma-contract": "node --test ./scripts/radar-schema-migration.contract.test.js ./scripts/radar-fabrica-prisma.contract.test.js",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "test:credits": "npm run build && node --test dist/credits/credit-action-config.service.test.js dist/credits/credit-action-usage.service.test.js dist/credits/credit-pack-catalog.test.js dist/credits/credit-pack-config.service.test.js dist/credits/credit-wallet.service.test.js dist/credits/credits.service.test.js dist/credits/credits-master-debit.controller.test.js dist/financeiro/financeiro-credit-reversal.test.js dist/commercial-plans/commercial-usage-limits.service.test.js",
    "test:indicacao": "npm run build && node --test dist/credits/indicacao.service.test.js",
    "test:profile-prospecting": "npm run build && node --test dist/auth/profile-prospecting-segments.test.js",
    "test:golive-critical": "npm run build && node --test dist/auth/roles.guard.test.js dist/integrations/external-webhook-ledger.service.test.js dist/auth/signup-risk.test.js dist/access/seller-access-governance.test.js dist/companies/company-operational-status.service.test.js dist/companies/company-operational-status.presentation.test.js dist/commercial-plans/plan-proration.util.test.js dist/commercial-plans/seat-billing.util.test.js dist/commercial-plans/trial-usage.test.js",
    "test:master-event": "npm run build && node --test dist/common/master-event.test.js",
    "test:master-cockpit": "npm run build && node --test dist/master-cockpit/master-cockpit.service.test.js",
    "test:master-alert": "npm run build && node --test dist/master-alert/master-alert.routes.test.js dist/master-alert/master-alert.service.test.js dist/master-alert/master-watch.service.test.js",
    "test:meta-templates": "npm run build && node --test dist/hbx-recovery/hbx-recovery.service.test.js",
    "test:whatsapp-channel": "npm run build && node --test dist/messaging/whatsapp-channel.test.js",
    "test:inbox-smoke": "npm run build && node --test dist/inbox/inbox.service.test.js",
    "test:mission-queue": "npm run build && node --test dist/webscraping/radar/missions/radar-mission-queue.service.test.js",
    "test:cobranca-whats": "npm run build && node --test dist/logistica/logistica-cobranca-aviso.service.test.js",
    "test:score-fiado": "npm run build && node --test dist/logistica/logistica-score.test.js",
    "test:resumo-diario": "npm run build && node --test dist/logistica/resumo-diario.service.test.js",
    "test:logistica-billing": "npm run build && node --test dist/logistica/logistica-route-billing.service.test.js dist/logistica/logistica-tracked-billing.service.test.js dist/logistica/logistica-tracking-bonus.service.test.js",
    "test:logistica-offline": "npm run build && node --test dist/logistica/logistica-offline-grant.test.js",
    "test:logistica-admin-route": "npm run build && node --test dist/logistica/logistica-admin-route.service.test.js",
    "test:logistica-mobile": "npm run build && node --test dist/logistica/logistica-mobile.service.test.js",
    "test:auvo-scaffold": "npm run build && node --test dist/integrations/auvo/auvo.integration.service.test.js dist/integrations/auvo/auvo.client.test.js dist/integrations/auvo/auvo.mapper.test.js",
    "test:whatsapp-hotfix": "npm run build && node --test dist/hbx-recovery/hbx-recovery.service.test.js dist/messaging/whatsapp-channel.test.js dist/inbox/inbox.service.test.js dist/messaging/conversations.service.test.js dist/messaging/messaging.service.test.js dist/customer-profile/customer-profile.service.test.js dist/integrations/integration-secrets.service.test.js dist/integrations/integration-connections.service.test.js",
    "smoke:integration-connections": "npm run build && node ./scripts/integration-connections-smoke.js",
    "diagnose:vendas-prospecting": "node ./scripts/diagnose-vendas-prospecting.js",
    "backfill:commercial-automation": "node ./scripts/backfill-commercial-automation.js",
    "lint:tenant-scope": "node ./scripts/check-tenant-scope.mjs",
    "test:tenant-guard": "npm run build && node --test dist/prisma/tenant-context.test.js dist/prisma/tenant-guard.extension.test.js",
    "test:company-deletion": "npm run build && node --test dist/companies/company-deletion-completeness.integration.test.js",
    "test:automation": "npm run build && node --test dist/automation/characterization/inbound-precedence.test.js dist/automation/characterization/assistant-claim.test.js dist/automation/automation-overview.service.test.js dist/automation/agent.service.test.js dist/automation/outbound-orchestrator.service.test.js",
    "prisma:migrate": "prisma migrate dev --name init --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=./prisma/schema.prisma",
    "bootstrap:system-master": "node ./scripts/bootstrap-system-master.js",
    "seed:structural": "node ./scripts/structural-seed.js",
    "seed:dev": "node ./scripts/seed-dev.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.6.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^3.0.5",
    "nodemailer": "^6.9.15",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.10.0",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "prisma": "5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
