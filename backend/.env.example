# Server
APP_PORT=3000

# Prisma (PostgreSQL)
# Local dev: DATABASE_URL and DIRECT_URL can point to the same local Postgres.
# Render + Supabase: set both to the Session pooler URL on port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hbx_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hbx_dev?schema=public"

# Frontend URL used in password reset emails
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Transactional email (real SMTP)
# Example for HBX using a real Gmail mailbox as SMTP relay and a branded public sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=barataimports@gmail.com
SMTP_PASS=
MAIL_FROM="HBX <jhonatan@hbxsystem.com.br>"
MAIL_FROM_NAME=HBX
MAIL_REPLY_TO=jhonatan@hbxsystem.com.br

# Optional comma-separated allowlist for browser origins.
# Leave empty in local development to accept localhost defaults.
CORS_ALLOWED_ORIGINS=

# JWT secret used to sign access tokens. Generate a strong random value in production.
# Example: use Render's generated secret or a 32+ byte base64 string.
JWT_SECRET="change-me-to-a-strong-secret"

# Required to encrypt IntegrationConnection credentials at rest.
# Use a strong random secret and keep it stable across restarts/environments that share the same database.
INTEGRATION_SECRET_KEY="change-me-to-a-strong-integration-secret"

# AUVO real HTTP adapter
# These vars are optional in local dev, but required for real homologation.
# Keep endpoint paths explicit until the official AUVO contract is validated in your environment.
AUVO_API_BASE_URL=
AUVO_AUTH_MODE=app_key_token_query
AUVO_APP_KEY=
AUVO_EXTERNAL_ACCOUNT_ID=
AUVO_TEST_PATH=
AUVO_CUSTOMERS_PATH=
AUVO_TASKS_PATH=
AUVO_UPDATED_SINCE_PARAM=updatedAt
AUVO_PAGE_PARAM=page
AUVO_PAGE_SIZE_PARAM=pageSize
AUVO_PAGE_SIZE=100
AUVO_PENDING_STATUS_PARAM=status
AUVO_PENDING_STATUS_VALUES=PENDING,OPEN,SCHEDULED,IN_PROGRESS
AUVO_TIMEOUT_MS=15000
AUVO_RETRY_ATTEMPTS=2
AUVO_RETRY_BACKOFF_MS=400

# TAGPLUS real HTTP adapter
# Keep endpoint paths explicit until the official TagPlus contract is validated in your environment.
TAGPLUS_API_BASE_URL=
TAGPLUS_AUTH_MODE=bearer_token
TAGPLUS_EXTERNAL_ACCOUNT_ID=
TAGPLUS_TEST_PATH=
TAGPLUS_CUSTOMERS_PATH=
TAGPLUS_RECEIVABLES_PATH=
TAGPLUS_UPDATED_SINCE_PARAM=updatedAt
TAGPLUS_PAGE_PARAM=page
TAGPLUS_PAGE_SIZE_PARAM=pageSize
TAGPLUS_PAGE_SIZE=100
TAGPLUS_TIMEOUT_MS=15000
TAGPLUS_RETRY_ATTEMPTS=2
TAGPLUS_RETRY_BACKOFF_MS=400

# Bootstrap the built-in system master user on application startup.
# Keep enabled in local development; consider disabling in hardened production once the account is provisioned.
BOOTSTRAP_SYSTEM_MASTER=true
SYSTEM_MASTER_USERNAME=jhonatan.barata
SYSTEM_MASTER_EMAIL=master@hbx.local
# Local fallback only; set explicitly if you enable bootstrap outside localhost.
SYSTEM_MASTER_PASSWORD=master4961

# Protected internal operational endpoints (e.g. SMTP test)
INTERNAL_SECRET=

# Rate limiting (defaults: 120 req / 60s)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

# Local-only helper: when true and SMTP is not configured, signup confirmation may expose a direct confirmation link
AUTH_DEBUG_CONFIRMATION_LINK=false

# Local-only helper: when true and SMTP is not configured, recover-password returns a preview link
AUTH_DEBUG_RESET_LINK=false

# WhatsApp Cloud API
# Turn on only when configured
WHATSAPP_ENABLED=false
# Optional dev-only fallback. Never used in production.
WHATSAPP_ALLOW_GLOBAL_FALLBACK=false

# Meta Graph API
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook (Meta subscription)
WHATSAPP_VERIFY_TOKEN=

# Optional: validate webhook signature (x-hub-signature-256)
WHATSAPP_APP_SECRET=

# Optional template fallback for Follow Up when outside 24h window
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=pt_BR

# Optional template fallback for Webscraping when outside 24h window
WHATSAPP_WEBSCRAPING_TEMPLATE_NAME=
WHATSAPP_WEBSCRAPING_TEMPLATE_LANGUAGE=pt_BR

# Optional template fallback for HBX Recovery when outside 24h window
WHATSAPP_HBX_RECOVERY_TEMPLATE_NAME=
WHATSAPP_HBX_RECOVERY_TEMPLATE_LANGUAGE=pt_BR

# WhatsApp modal engine for the HBX QR-first flow.
# HBX points the modal engine only through the dedicated WHATSAPP_MODAL_* vars below.
WHATSAPP_MODAL_ENABLED=true
WHATSAPP_MODAL_INTERNAL_URL=http://187.127.249.180:8080
WHATSAPP_MODAL_API_KEY=HBX_WEBWHATS_2026_249180_SECURE_KEY
WHATSAPP_MODAL_TIMEOUT_MS=15000

# Optional template for Support module
WHATSAPP_SUPPORT_TEMPLATE_NAME=
WHATSAPP_SUPPORT_TEMPLATE_LANGUAGE=pt_BR

# Temporary WhatsApp QR provider (kept separate from the official Meta route)
WHATSAPP_TEMPORARY_API_URL=
WHATSAPP_TEMPORARY_API_KEY=
WHATSAPP_TEMPORARY_INSTANCE_PREFIX=hbx-temp

# Modules system
WEBSCRAPING_URL=/hbx/webscraping
WEBSCRAPING_INTERNAL_URL=http://localhost:8501
