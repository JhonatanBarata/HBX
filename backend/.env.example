# Server
APP_PORT=3000
PUBLIC_API_BASE_URL=https://api.hbxsystem.com.br

# Payment provider used by Financeiro.
# Use "mercadopago" for real/test gateway calls.
# Local UI development can use "mock" with NODE_ENV=development to approve charges/subscriptions without calling Mercado Pago.
PAYMENTS_PROVIDER=mercadopago

# Prisma (PostgreSQL)
# Local dev: DATABASE_URL and DIRECT_URL can point to the same local Postgres.
# Render + Supabase: set both to the Session pooler URL on port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hbx_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hbx_dev?schema=public"

# Frontend URL used in password reset emails
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Transactional email (real SMTP)
# Example for HBX using a real Gmail mailbox as SMTP relay and a branded public sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=barataimports@gmail.com
SMTP_PASS=
MAIL_FROM="HBX <jhonatan@hbxsystem.com.br>"
MAIL_FROM_NAME=HBX
MAIL_REPLY_TO=jhonatan@hbxsystem.com.br

# Optional comma-separated allowlist for browser origins.
# Leave empty in local development to accept localhost defaults.
CORS_ALLOWED_ORIGINS=

# JWT secret used to sign access tokens. Generate a strong random value in production.
# Example: use Render's generated secret or a 32+ byte base64 string.
JWT_SECRET="change-me-to-a-strong-secret"

# Required to encrypt IntegrationConnection credentials at rest.
# Use a strong random secret and keep it stable across restarts/environments that share the same database.
INTEGRATION_SECRET_KEY="change-me-to-a-strong-integration-secret"

# AUVO real HTTP adapter
# These vars are optional in local dev, but required for real homologation.
# Keep endpoint paths explicit until the official AUVO contract is validated in your environment.
AUVO_API_BASE_URL=
AUVO_AUTH_MODE=app_key_token_query
AUVO_APP_KEY=
AUVO_EXTERNAL_ACCOUNT_ID=
AUVO_TEST_PATH=
AUVO_CUSTOMERS_PATH=
AUVO_TASKS_PATH=
AUVO_UPDATED_SINCE_PARAM=updatedAt
AUVO_PAGE_PARAM=page
AUVO_PAGE_SIZE_PARAM=pageSize
AUVO_PAGE_SIZE=100
AUVO_PENDING_STATUS_PARAM=status
AUVO_PENDING_STATUS_VALUES=PENDING,OPEN,SCHEDULED,IN_PROGRESS
AUVO_TIMEOUT_MS=15000
AUVO_RETRY_ATTEMPTS=2
AUVO_RETRY_BACKOFF_MS=400

# TAGPLUS real HTTP adapter
# Keep endpoint paths explicit until the official TagPlus contract is validated in your environment.
TAGPLUS_API_BASE_URL=
TAGPLUS_AUTH_MODE=bearer_token
TAGPLUS_EXTERNAL_ACCOUNT_ID=
TAGPLUS_TEST_PATH=
TAGPLUS_CUSTOMERS_PATH=
TAGPLUS_RECEIVABLES_PATH=
TAGPLUS_UPDATED_SINCE_PARAM=updatedAt
TAGPLUS_PAGE_PARAM=page
TAGPLUS_PAGE_SIZE_PARAM=pageSize
TAGPLUS_PAGE_SIZE=100
TAGPLUS_TIMEOUT_MS=15000
TAGPLUS_RETRY_ATTEMPTS=2
TAGPLUS_RETRY_BACKOFF_MS=400

# Bootstrap the built-in system master user on application startup.
# Keep enabled in local development; consider disabling in hardened production once the account is provisioned.
BOOTSTRAP_SYSTEM_MASTER=true
SYSTEM_MASTER_USERNAME=jhonatan.barata
SYSTEM_MASTER_EMAIL=master@hbx.local
# Local fallback only; set explicitly if you enable bootstrap outside localhost.
SYSTEM_MASTER_PASSWORD=change-me-to-a-strong-master-password

# Alerta do master para pedidos de HBX Full (implantação assistida, sem self-checkout).
# E-mail: se vazio, usa o e-mail do usuário system_master. WhatsApp: precisa do número
# destino (default = nº do dono) E da empresa HBX com WhatsApp conectado que ENVIA o aviso.
MASTER_ALERT_EMAIL=
MASTER_ALERT_WHATSAPP_TO=19997024884
MASTER_ALERT_WA_COMPANY_ID=

# CONFIRMACAO-TELEFONE F1 (docs/PLANEJAMENTOS/CREDITOS/CONFIRMACAO-TELEFONE.md) —
# envio LIVE do código de confirmação por WhatsApp. TODAS as flags nascem OFF.
#   LIVE_WHATSAPP_CONFIRM=false → mestra do disparo live. OFF: em produção o código
#     NÃO é enviado (gated-TODO); em dev/build sai só no log/preview. ON: envia pelo
#     chip do Master via rotina do app (WebwhatsBridgeService.sendText), com guardrails
#     (cooldown 60s/telefone, teto/hora, disjuntor — sem loop de retry).
#   WHATSAPP_CONFIRM_WA_COMPANY_ID: empresa HBX conectada que ENVIA o código. Vazio =
#     usa MASTER_ALERT_WA_COMPANY_ID (mesmo chip do Master). 0/vazio = não envia.
LIVE_WHATSAPP_CONFIRM=false
WHATSAPP_CONFIRM_WA_COMPANY_ID=

# Copiloto no lead (docs → CHECKLIST-ATIVACAO §6). Painel de IA na página do lead
# reusando o assistente local. OFF → painel some, página intacta. Default ON local;
# decisão de prod do dono. Depende de HBX_LLM_CLASSIFIER_ENABLED ligado (endpoints IA).
HBX_COPILOTO_ENABLED=true

# E-mail v1 no lead (docs → CHECKLIST-ATIVACAO §6). Secret dedicado da cifra AES-256-GCM
# das credenciais SMTP do usuário. AUSENTE = feature OFF graciosa (NUNCA crash no boot).
# Gerar 32+ bytes aleatórios. Requer a migration 20260711140000_lead_email_v1 aplicada.
HBX_EMAIL_CRED_SECRET=

# Protected internal operational endpoints (e.g. SMTP test)
INTERNAL_SECRET=

# Rate limiting (defaults: 120 req / 60s)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

# Local-only helper: when true and SMTP is not configured, signup confirmation may expose a direct confirmation link
AUTH_DEBUG_CONFIRMATION_LINK=false

# Local-only helper: when true and SMTP is not configured, recover-password returns a preview link
AUTH_DEBUG_RESET_LINK=false

# Gmail OAuth — projeto Google SEPARADO do login (escopo gmail.send, sem leitura de caixa).
# Crie um OAuth 2.0 Client ID (tipo "Web application") no Google Cloud Console,
# adicione GMAIL_OAUTH_REDIRECT_URI como URI de redirecionamento autorizado.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://api.hbxsystem.com.br/company-email/gmail/callback

# WhatsApp Cloud API
# Turn on only when configured
WHATSAPP_ENABLED=false
# Optional dev-only fallback. Never used in production.
WHATSAPP_ALLOW_GLOBAL_FALLBACK=false

# Meta Graph API
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook (Meta subscription)
WHATSAPP_VERIFY_TOKEN=

# Optional: validate webhook signature (x-hub-signature-256)
WHATSAPP_APP_SECRET=

# Optional template fallback for Follow Up when outside 24h window
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=pt_BR

# Optional template fallback for Webscraping when outside 24h window
WHATSAPP_WEBSCRAPING_TEMPLATE_NAME=
WHATSAPP_WEBSCRAPING_TEMPLATE_LANGUAGE=pt_BR

# Optional template fallback for HBX Recovery when outside 24h window
WHATSAPP_HBX_RECOVERY_TEMPLATE_NAME=
WHATSAPP_HBX_RECOVERY_TEMPLATE_LANGUAGE=pt_BR

# WhatsApp modal engine for the HBX QR-first flow.
# Use only the dedicated WHATSAPP_MODAL_* vars below for the Hostinger engine.
WHATSAPP_MODAL_ENABLED=true
WHATSAPP_MODAL_INTERNAL_URL=http://host.docker.internal:8080
WHATSAPP_MODAL_API_KEY=
WHATSAPP_MODAL_TIMEOUT_MS=15000

# Optional template for Support module
WHATSAPP_SUPPORT_TEMPLATE_NAME=
WHATSAPP_SUPPORT_TEMPLATE_LANGUAGE=pt_BR

# Temporary WhatsApp QR provider (kept separate from the official Meta route)
WHATSAPP_TEMPORARY_API_URL=
WHATSAPP_TEMPORARY_API_KEY=
WHATSAPP_TEMPORARY_INSTANCE_PREFIX=hbx-temp

# Brave Search API — tier grátis, L3 site/CNPJ discovery; sem chave cai no Bing/DDG.
BRAVE_SEARCH_API_KEY=

# Governor FÍSICO por fonte (SourceBudgetService — Sprint 3 MOTOR-RFB-FILA).
# Pago = FAIL-CLOSED (sem contador não chama); grátis = fail-open. <=0 = sem teto.
HBX_BRAVE_MONTHLY_CAP=900
HBX_GOOGLE_PLACES_DAILY_CAP=200
HBX_BRASILAPI_MIN_INTERVAL_MS=700
# Teto de CONCORRÊNCIA por fonte grátis (ddg/bing/searxng) + clamp da frota dentro da elasticidade.
# Dado medido: 20 motores na mesma fonte = timeout; 6-8 = ótimo. GATE G2: número final é do dono.
HBX_SOURCE_FREE_MAX_CONCURRENCY=8
# Override por fonte (opcional): HBX_SOURCE_DDG_MAX_CONCURRENCY / _BING_ / _SEARXNG_

# Enriquecimento de leads — providers pagos/premium
# Ambos desligados por padrão (torneira fechada). Ligar só após amarrar ao plano pago.
# AVISO: sem SERPER_API_KEY/BRAVE_SEARCH_API_KEY setado no motor Python,
# nenhum provider pago dispara mesmo com HBX_ENRICH_ALLOW_PAID=true.
HBX_ENRICH_ALLOW_PAID=false
HBX_ENRICH_ALLOW_PREMIUM=false

# Modules system
WEBSCRAPING_URL=/hbx/webscraping
WEBSCRAPING_INTERNAL_URL=http://webscraping:8501
HBX_SCRAPING_ENGINE_URL=http://hbx-scraping-engine:8001
HBX_WEB_SEARCH_MAX_RESULTS=10
HBX_WEB_SEARCH_TIMEOUT_SECONDS=30

# Lead Harvest / Email Lab rollout flags.
# Keep false by default; enable one gate at a time after checklist validation.
HBX_LEAD_HARVEST_IMPORT_ENABLED=false
HBX_LOCAL_LAB_IMPORT_ENABLED=false
HBX_EMAIL_SMART_ENRICH_V2_ENABLED=false
HBX_PAID_ENRICHMENT_LEDGER_ENABLED=false
HBX_GOOGLE_PAID_FALLBACK_ENABLED=false
HBX_EMAIL_PROVIDER_FALLBACK_ENABLED=false

# CRÉDITOS (carteira pré-paga que substitui o paywall por tier — docs/PLANEJAMENTOS/CREDITOS).
# S1 só cria a carteira/ledger (schema + saldo atômico); nada no runtime de vendas debita
# ainda. Deixe false até o S2 (débito shadow) provar em prod. NÃO ligar no .env da VPS antes disso.
HBX_CREDITS_ENABLED=false

# ROTA RASTREADA — kill-switch global. Default OFF; o toggle por empresa pode
# ficar salvo, mas o modo efetivo continua ESSENTIAL enquanto esta flag estiver OFF.
HBX_LOGISTICA_TRACKING_ENABLED=false

# CONFIRMACAO-TELEFONE F2 — brinde de boas-vindas amarrado ao TELEFONE VERIFICADO.
# Default OFF: o brinde sai só com a identidade confirmada (atual). ON: exige também
# o telefone do cadastro VERIFICADO por código (Company.contactPhoneVerifiedAt) e o
# dedup anti-farra passa a comparar telefone PROVADO (não digitado). NÃO ligar antes
# do F1 (LIVE_WHATSAPP_CONFIRM) provado em prod, senão ninguém verifica e ninguém ganha.
HBX_CREDITS_REQUIRE_VERIFIED_PHONE=false

# R2 — Módulo desacoplado de plano (kill-switch puro do master, docs/PLANEJAMENTOS/CREDITOS).
# FASE 2 (REMOÇÃO, 05/07): esta flag NÃO TEM MAIS EFEITO — resolveCompanyModuleAccessPolicy
# sempre libera módulos via SystemModule.defaultEnabled/CompanyModule (kill-switch do master),
# nunca mais deriva de COMMERCIAL_PLAN_MODULE_KEYS. Mantida só por retrocompat de .env já
# publicado; pode ser removida numa faxina futura sem mudar comportamento nenhum.
HBX_MODULES_KILLSWITCH_ONLY=false

# HBX AI Assistant flags (backend only).
# Visual can be enabled without OpenAI; smart replies require OPENAI_API_KEY.
HBX_AI_ASSISTANT_VISUAL_ENABLED=false
HBX_AI_SMART_REPLIES_ENABLED=false
HBX_AI_AUTO_SEND_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Google OAuth (login social)
# Criar projeto em console.cloud.google.com → Credenciais → ID de cliente OAuth 2.0
# Tipo: Aplicativo da Web. Origens JS autorizadas: https://hbxsystem.com.br e https://app.hbxsystem.com.br
# URI de redirecionamento: não é necessário (fluxo id_token, sem redirect)
# Ambas as variáveis precisam ter o mesmo Client ID (o secret não é usado neste fluxo)
GOOGLE_CLIENT_ID=
