  portoOrigem  CadastroPorto @relation("TransitTimeOrigem", fields: [portoOrigemId], references: [id], onDelete: Cascade)
  portoDestino CadastroPorto @relation("TransitTimeDestino", fields: [portoDestinoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, portoOrigemId, portoDestinoId])
  @@index([empresaId])
