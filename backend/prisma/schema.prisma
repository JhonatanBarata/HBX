model User {
  id              Int              @id @default(autoincrement())
  username        String?          @unique
  email           String?          @unique
  emailConfirmedAt DateTime?
  emailConfirmationToken String?   @unique
  emailConfirmationSentAt DateTime?
  emailConfirmationExpiresAt DateTime?
  password        String
  googleId        String?          @unique
  mustChangePassword Boolean     @default(false)
  // Boas-vindas (primeiro acesso, 14/06): null = ainda não viu/dispensou o
  // tutorial; preenchido = resolvido. Existentes nascem resolvidos (backfill no
  // runtime-ensure); novos nascem null = pendentes. Re-armado na troca de senha.
  tutorialCompletedAt DateTime?
  // Ativação / onboarding (28/06, Camada 1): carimbos dos marcos da jornada por
  // papel. JSON = { events: { "<event>": ISO } }. Fonte da verdade do checklist
  // de primeiros passos; o GET também DERIVA dos dados reais (lead puxado, chip
  // conectado, venda fechada) p/ auto-curar quem já fez antes deste recurso.
  onboardingStateJson String?
  name            String?
  phone           String?
  commissionPercent Float          @default(0)
  // Teto de comissão por fechamento (PR13062026007). 0 = sem teto. Admin digita no
  // cadastro do vendedor; o VENDEDOR nunca vê o valor (só a comissão já capada).
  // mensal = limite da comissão recorrente; setup = limite da comissão de implantação.
  commissionMonthlyCap Float       @default(0)
  setupCommissionCap   Float       @default(0)
  // Régua única (PR13062026007 P1): separa Dono (true) de Gerente (false) dentro
  // do papel ADMIN. Gerente = ADMIN que NÃO vê cobrança/plano.
  canViewBilling  Boolean          @default(true)
  canRegisterHbxSellers Boolean    @default(false)
  sellerReferralCommissionPercent Float @default(0)
  referredByUserId Int?
  referredByCommissionPercentSnapshot Float @default(0)
  sellerDistributionMode String     @default("learning")
  sellerDistributionPausedUntil DateTime?
  sellerDistributionDailyLimitOverride Int?
  sellerDistributionNote String?
  sellerDistributionUpdatedAt DateTime?
  // Preferência de segmento/região do vendedor (14/06). Self-service: o próprio
  // vendedor edita (PATCH /profile/preferred-segments). Vira o default do "Puxar
  // leads". JSON canônico = { "segments": string[], "cityRegion": string|null };
  // o leitor tolera também o formato bare-array legado. Aditivo/nullable.
  preferredSegmentsJson String?
  // Afinidade observada (17/06): contador de ações por segmento { "<seg>": N }.
  // Só alimenta o boost ao atingir 3 ações — nunca é "preferência" com 1 ou 2.
  segmentAffinityJson String?
  // Sellers Brains (17/06): null = push ligado; preenchido = push mutado (sino vermelho).
  brainPushMutedAt DateTime?
  // Radar Automático (18/06): JSON = { active, city, state, segment, alcance, quantos }.
  // null = nunca configurado (botão apagado). Persiste mesmo offline — "reserva no estoque".
  radarSellerStandingOrderJson String?
  botAccessEnabled  Boolean  @default(false)
  referredByUser  User?            @relation("UserSellerReferralNetwork", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers   User[]           @relation("UserSellerReferralNetwork")
  company         Company?         @relation(fields: [companyId], references: [id])
  companyId       Int?
  role            String           @default("USER")
  isSystemMaster  Boolean          @default(false)
  isActive        Boolean          @default(true)
  currentSession  AuthSession?     @relation("CurrentUserSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  currentSessionId String?         @unique
  sessionVersion  Int              @default(0)
  themePreferenceConfig    String?
  notificationPrefsJson    String?
  avatarUrl                String?
  deactivatedAt   DateTime?
  retentionUntil  DateTime?
  createdAt       DateTime         @default(now())
  authSessions    AuthSession[]    @relation("UserAuthSessions")
  productVersions ProductVersion[]
  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")
  passwordResets  PasswordReset[]
  deletionRecords        DeletionRecord[]
  techAssistantInteractions TechAssistantInteraction[]
  masterContextSessions MasterAssumedContextSession[] @relation("MasterAssumedContextUser")
  masterContextEndedSessions MasterAssumedContextSession[] @relation("MasterAssumedContextEndedByUser")
  masterSupportAuditLogs MasterSupportAuditLog[] @relation("MasterSupportAuditLogUser")
  teamPolicyAuditLogsAsActor TeamPolicyAuditLog[] @relation("TeamPolicyAuditLogActor")
  teamPolicyAuditLogsAsTarget TeamPolicyAuditLog[] @relation("TeamPolicyAuditLogTarget")
  webscrapingSearchHistories WebscrapingSearchHistory[]
  webscrapingSearchRuns WebscrapingSearchRun[]
  webscrapingCampaigns WebscrapingCampaign[]
  webscrapingUsageLogs WebscrapingUsageLog[]
  radarLeadEventsCreated RadarLeadEvent[] @relation("RadarLeadEventCreatedBy")
  nightFactoryRewardClaims NightFactoryRewardClaim[]
  salesProfiles SalesProfile[]
  vendasCardComplaints VendasCardComplaint[]
  createdMasterNotices MasterNotice[] @relation("MasterNoticeCreatedBy")
  masterNoticeAcks MasterNoticeAck[]
  billableSeatUsages CompanyBillableSeatUsage[]
  radarDistributionDailyUsages RadarDistributionDailyUsage[]
  sellerOnboardings SellerOnboarding[] @relation("SellerOnboardingUser")
  createdSellerOnboardings SellerOnboarding[] @relation("SellerOnboardingCreatedBy")
  partnerContracts PartnerContract[] @relation("PartnerContractPartner")
  approvedPartnerContracts PartnerContract[] @relation("PartnerContractApprovedBy")
  hbxReferralCandidates HbxPartnerReferralCandidate[] @relation("HbxReferralCandidateReferrer")
  reviewedHbxReferralCandidates HbxPartnerReferralCandidate[] @relation("HbxReferralCandidateReviewedBy")
  convertedHbxReferralCandidates HbxPartnerReferralCandidate[] @relation("HbxReferralCandidateConvertedUser")
  teamPolicy UserTeamPolicy? @relation("UserTeamPolicyUser")
  referredUserTeamPolicies UserTeamPolicy[] @relation("UserTeamPolicyReferrer")
  whatsappConnectionSessions WhatsAppConnectionSession[]
  gmailConnection GmailConnection?

  @@index([referredByUserId])
  @@index([canRegisterHbxSellers])
}

