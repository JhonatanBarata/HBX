  @@index([expiresAt])
}

model Product {
  id          Int              @id @default(autoincrement())
  kind        String           @default("tenant_product")
  status      String           @default("active")
  sku         String?
  name        String
  description String?
  category    String?
  price       Float
  priceCents  Int?
  currency    String           @default("BRL")
  billingCycle String?
  saleMode    String           @default("internal")
  planKey     String?
  externalUrl String?
  allowDiscount Boolean        @default(false)
  maxDiscountPercent Float?
  minPriceCents Int?
  defaultCommissionPercent Float?
  sortOrder   Int              @default(0)
  stock       Int              @default(0)
  company     Company?         @relation(fields: [companyId], references: [id])
  companyId   Int?
  categoryRef Category?        @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  metadataJson String?
  sourceConnection   IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId String?
  externalSource     String?
  externalProductId  String?
  sourceUpdatedAt    DateTime?
  createdBy     User?    @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId Int?
  updatedBy     User?    @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByUserId Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    ProductVersion[]
  vendasLeads VendasLead[]

  @@index([companyId, status, sortOrder])
  @@index([companyId, kind, status])
  @@index([companyId, planKey])
  @@index([companyId, sku])
  @@index([sourceConnectionId, externalProductId])
  @@index([companyId, externalSource, externalProductId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model AutoReplyRule {
  id              Int                 @id @default(autoincrement())
  company         Company             @relation(fields: [companyId], references: [id])
  companyId       Int
  enabled         Boolean             @default(true)
  priority        Int                 @default(0)
  // SQLite doesn't support Prisma enums; store match type as string: EXACT | CONTAINS
  matchType       String              @default("EXACT")
  pattern         String
  caseInsensitive Boolean             @default(true)
  responses       AutoReplyResponse[]
  createdAt       DateTime            @default(now())
}

model AutoReplyResponse {
  id           Int           @id @default(autoincrement())
  rule         AutoReplyRule @relation(fields: [ruleId], references: [id])
  ruleId       Int
  order        Int
  delaySeconds Int           @default(0)
  template     String
}

model InboundMessage {
  id         Int      @id @default(autoincrement())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  Int
  from       String
  body       String
  receivedAt DateTime @default(now())
}

model OutboundMessage {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
  whatsappEndpoint   CompanyWhatsAppEndpoint? @relation(fields: [whatsappEndpointId], references: [id])
  whatsappEndpointId String?
  contactId String?
  to        String
  messageType String @default("text") // text | template
  templateName String?
  templateLanguage String?
  templateComponents String?
  sourceModule String?
  body      String
  // SQLite doesn't support Prisma enums; store status as string: PENDING | SENDING | SENT | FAILED
  status    String  @default("PENDING")

  // WhatsApp Cloud API correlation
  provider           String?   @default("WHATSAPP_CLOUD")
  providerMessageId  String?   @unique
  deliveryStatus     String? // sent | delivered | read | failed
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  lastWebhookAt      DateTime?
  lastWebhookPayload String?

  attemptCount  Int               @default(0)
  maxAttempts   Int               @default(3)
  nextAttemptAt DateTime          @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())
  attempts      OutboundAttempt[]

  message CompanyMessage? @relation("OutboundMessageMessage")

  @@index([companyId, whatsappEndpointId, nextAttemptAt])
}

model OutboundAttempt {
  id           Int             @id @default(autoincrement())
  message      OutboundMessage @relation(fields: [messageId], references: [id])
  messageId    Int
  attemptNo    Int
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  success      Boolean         @default(false)
  httpStatus   Int?
  requestBody  String?
  responseBody String?
  error        String?
}

model WhatsAppWebhookEvent {
  id                Int      @id @default(autoincrement())
  receivedAt        DateTime @default(now())
  kind              String // verify | messages | statuses | unknown
  companyId         Int?
  providerMessageId String?
  payload           String
}

model WhatsAppAuditLog {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  scope     String
  event     String
  level     String   @default("INFO")
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, scope, event])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model ProductVersion {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  data      String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
  version   Int
  createdAt DateTime @default(now())
}

model SatisfactionSurvey {
  id             String   @id @default(uuid())
  conversationId String
  rating         Int?
  feedback       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model CadastroFornecedor {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  paisId    Int?
  portoOrigemId Int?
  portoDestinoId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pais         CadastroPais?  @relation("FornecedorPais", fields: [paisId], references: [id])
  portoOrigem  CadastroPorto? @relation("FornecedorPortoOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto? @relation("FornecedorPortoDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroPais {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portos CadastroPorto[]
  fornecedores CadastroFornecedor[] @relation("FornecedorPais")

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model CadastroPorto {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  paisId    Int?
  pais      CadastroPais? @relation(fields: [paisId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitTimesOrigem  CadastroTransitTime[] @relation("TransitTimeOrigem")
  transitTimesDestino CadastroTransitTime[] @relation("TransitTimeDestino")
  fornecedoresOrigem  CadastroFornecedor[] @relation("FornecedorPortoOrigem")
  fornecedoresDestino CadastroFornecedor[] @relation("FornecedorPortoDestino")

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroTransitTime {
  id             Int      @id @default(autoincrement())
  company        Company  @relation(fields: [empresaId], references: [id])
  empresaId      Int
  portoOrigemId  Int
  portoDestinoId Int
  dias           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portoOrigem  CadastroPorto @relation("TransitTimeOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto @relation("TransitTimeDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, portoOrigemId, portoDestinoId])
  @@index([empresaId])
}

// Base local de dados abertos do CNPJ (Receita Federal) que alimenta a fonte
// cnpj_public do Radar. Importada via scripts/import-cnpj-dataset.js.
// Descoberta apenas: contato sai daqui como dado cadastral, nunca inventado.
model CnpjPublicCompany {
  id              String    @id @default(cuid())
  cnpj            String    @unique
  razaoSocial     String
  nomeFantasia    String?
  situacao        String    @default("ativa")
  cnae            String?
  cnaeDescription String?
  porte           String?
  matrizFilial    String?
  openedAt        DateTime?
  phone           String?
  phoneDigits     String?
  email           String?
  website         String?
  address         String?
  city            String?
  state           String?
  normalizedCity  String    @default("")
  // nomeFantasia + razaoSocial + cnae normalizados (minusculo, sem acento) p/ matching de segmento
  searchText      String    @default("")
  rawJson         String?
  importedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([normalizedCity, state])
  @@index([state, cnae])
  @@index([phoneDigits])
}
