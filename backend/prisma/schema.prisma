// PR1 (30/06, docs/PLANEJAMENTOS/PR30062026/arvore-final-owner-enriquecimento.md): tabela normalizada
// p/ BUSCA EM LOTE de contatos descobertos (email/phone/social). ADITIVA — populada a partir do
// metadataJson existente do RadarLeadPool (backfill) + escrita dupla nos pontos que descobrem contato
// novo. NÃO é a fonte do presenter (metadataJson continua sendo); serve só consulta/filtro/export.
model LeadContact {
  id                  String   @id @default(cuid())
  radarLead           RadarLeadPool @relation(fields: [radarLeadId], references: [id], onDelete: Cascade)
  radarLeadId         String
  kind                String   // 'email' | 'phone' | 'whatsapp' | 'instagram' | 'facebook'
  value               String
  valueNormalized     String
  rank                Int      @default(1) // 1..N, ordem de descoberta/confiança
  source              String?  // de onde veio: 'website_crawl' | 'cnpj_l4' | 'owner_social' | 'metadataJson_backfill' | etc
  confidence          Int?     @default(0)
  claimedByCompanyId  Int?     // null = não reivindicado por nenhuma empresa ainda (chave do #15)
  createdByMissionId  String?
  evidenceId          String?
  evidenceUrl         String?
  evidenceHash        String?
  createdAt           DateTime @default(now())

  @@index([radarLeadId, kind, rank])
  @@index([kind, valueNormalized])
  @@index([claimedByCompanyId])
  @@index([createdByMissionId])
  @@unique([radarLeadId, kind, valueNormalized])
}

// WORM-16 (02/07, docs/PLANEJAMENTOS/worm/16-tela-contatos-empresas-crm.md): contato por PESSOA
// (nome + cargo), separado do LeadContact (que é por CANAL). O sócio do QSA da Receita
// (CnpjPublicPartner) é o caso primário — pessoa com NOME e CARGO, mas normalmente SEM
// telefone/e-mail (o dump RFB não traz). Por isso NÃO cabe no LeadContact (que exige
// kind/value de um canal) nem passa pelo gate anti-alucinação de telefone/e-mail (o nome
// cadastral da Receita é dado oficial, não canal scrapeado). ADITIVA: populada por backfill dos
// blobs (metadataJson people/ownerNames) + QSA existente, sem destruir o blob; NÃO é fonte do
// presenter (metadataJson continua a evidência) — serve consulta/filtro/export e o card lê
// meta.people. Idempotência por (radarLeadId, personKey).
model LeadPerson {
  id           String   @id @default(cuid())
  radarLead    RadarLeadPool @relation(fields: [radarLeadId], references: [id], onDelete: Cascade)
  radarLeadId  String
  name         String
  role         String?  // cargo/qualificação (ex.: "Sócio-Administrador") — do QSA quando houver
  // canais opcionais e ADITIVOS: só preenchidos quando a fonte já os traz (ex.: ownerPhone do L4).
  // Canal scrapeado real continua em LeadContact via LeadContactWriteService (caminho único).
  phoneDigits  String?
  email        String?
  source       String   // 'receita_qsa' | 'crawl' | 'manual' | 'ia'
  // chave de idempotência dentro do lead: source + nome normalizado (sem acento/caixa).
  personKey    String
  rank         Int      @default(1)
  createdByMissionId String?
  evidenceId   String?
  evidenceUrl  String?
  evidenceHash String?
  createdAt    DateTime @default(now())

  @@unique([radarLeadId, personKey])
  @@index([radarLeadId, rank])
  @@index([createdByMissionId])
}

// DISJUNTOR MENSAL do Brave (30/06 — incidente "estourou 1000"): contador persistente de chamadas
// Brave por mês. O `searchBrave` (radar-web-enrichment.service.ts — gargalo único por onde TODA chamada
// Brave passa) corta duro no teto (env HBX_BRAVE_MONTHLY_CAP, default 900) e degrada gracioso (devolve
// []). Persistente = sobrevive a restart/recreate (contador em memória zerava → a trava virava inútil).
// yearMonth = "YYYY-MM".
model BraveApiUsage {
  yearMonth String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// FREIO ÚNICO POR FONTE (Sprint 3 MOTOR-RFB-FILA, 02/07) — generaliza o disjuntor do Brave num
// contador persistente por fonte × período, lido/gravado SÓ pelo SourceBudgetService
// (backend/src/webscraping/source-budget/). yearMonth guarda a CHAVE DO PERÍODO: "YYYY-MM" p/ cap
// mensal (brave), "YYYY-MM-DD" p/ cap diário (google_places). BraveApiUsage acima fica de pé como
// compat até o cutover; a migration copia o histórico dele pra cá.
model SourceApiUsage {
  source    String
  yearMonth String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([source, yearMonth])
}

// FREIO do zap-gate (W4, PR02072026 — docs/PLANEJAMENTOS/PR02072026/W4-freio-zapgate.md): cache
// TTL persistente do resultado de "número tem WhatsApp?" checado no motor Webwhats. Chave = número
// (phoneDigits), NÃO radarLeadId — o mesmo número aparece em vários LeadContact/leads e o freio
// precisa deduplicar globalmente, não por linha. Lido/gravado SÓ pelo ZapCheckGuardService
// (backend/src/messaging/zap-check-guard.service.ts), que intercepta
// WebwhatsBridgeService.checkWhatsappNumbers — porta única por onde passa TODO check de WhatsApp
// (Radar via applyRadarWhatsappCheck, Vendas, Inbox). TTL default 168h (HBX_ZAP_CHECK_TTL_HOURS).
model WhatsappNumberCheckCache {
