// INTENTENGINE S1 (docs/PLANEJAMENTOS/INTENTENGINE/INTENTENGINE-sprint1.md).
// Log estruturado de CADA decisão do motor de intenção único (IntentEngineService).
// Cria o dataset real (texto → rótulo → fonte ia/keyword) que decide upgrade de
// modelo/GPU com dados em vez de achismo. Gravado BEST-EFFORT: falha no insert nunca
// quebra a classificação. `flow` = prospeccao | atendimento | simulador; `source` =
// ai | keyword; `label` = kind do ProspectingIntentClassification. Aditiva.
model IntentDecision {
  id             Int      @id @default(autoincrement())
  companyId      Int
  conversationId Int?
  flow           String
  textPreview    String
  source         String
  label          String
  confidence     Float
  latencyMs      Int?
  model          String?
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
}

// INTENTENGINE S3 (docs/PLANEJAMENTOS/INTENTENGINE/INTENTENGINE-sprint3.md).
// Config do bot versionada e auditada — sai da tabela emprestada (HbxRecoveryFlowStage
// reaproveitada como chave-valor JSON, sem histórico/autor/rollback). domain identifica
// qual config: atendimento_bot | atendimento_agenda | bot_master_switch | recovery_bot.
// Leitura = MAIOR version por (companyId, domain); escrita = SEMPRE INSERT de nova version
// (nunca update) → histórico de graça. Rollback = regravar a versão anterior como nova
// versão (nunca apaga linha). Lido/gravado só pelo BotConfigStoreService
// (backend/src/bot/config/bot-config-store.service.ts), que faz dual-read: BotConfig
// primeiro, fallback pro canal mágico legado se não houver linha (migração lazy).
model BotConfig {
  id              String   @id @default(cuid())
  companyId       Int
  domain          String
  version         Int
  payload         String
  updatedByUserId Int?
  createdAt       DateTime @default(now())

  @@unique([companyId, domain, version])
  @@index([companyId, domain, createdAt])
}

// GATEWAY-WA S2 (docs/PLANEJAMENTOS/GATEWAY-WA/GATEWAY-WA-sprint-2-outbox.md).
// Cursor persistido do consumer da outbox durável do motor Webwhats. Linha ÚNICA (chave por
// `name` constante = "webwhats_outbox"): guarda o último `cursor` (id serial do EventOutbox do
// motor) já processado com sucesso. Sobrevive a restart do backend — no publish o consumer
// retoma de onde parou em vez de reprocessar a fila inteira. Aditiva; lida/gravada só pelo
// WebwhatsOutboxConsumerService (backend/src/messaging/webwhats-outbox-consumer.service.ts).
model WebwhatsEventCursor {
  name      String   @id
  cursor    BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("WebwhatsEventCursor")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model ProductVersion {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  data      String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
  version   Int
  createdAt DateTime @default(now())
}

// SatisfactionSurvey (pesquisa de satisfação/NPS) APOSENTADO com o Inbox legado
// (multi-tenancy Sprint 2, 03/07). Feature morta: sem writer vivo, tabela sempre
// vazia. A leitura órfã no gerencial foi removida junto.

model CadastroFornecedor {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId Int
  nome      String
  paisId    Int?
  portoOrigemId Int?
  portoDestinoId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pais         CadastroPais?  @relation("FornecedorPais", fields: [paisId], references: [id])
  portoOrigem  CadastroPorto? @relation("FornecedorPortoOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto? @relation("FornecedorPortoDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroPais {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portos CadastroPorto[]
  fornecedores CadastroFornecedor[] @relation("FornecedorPais")

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model CadastroPorto {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId Int
  nome      String
  paisId    Int?
  pais      CadastroPais? @relation(fields: [paisId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitTimesOrigem  CadastroTransitTime[] @relation("TransitTimeOrigem")
  transitTimesDestino CadastroTransitTime[] @relation("TransitTimeDestino")
  fornecedoresOrigem  CadastroFornecedor[] @relation("FornecedorPortoOrigem")
  fornecedoresDestino CadastroFornecedor[] @relation("FornecedorPortoDestino")

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroTransitTime {
  id             Int      @id @default(autoincrement())
  company        Company  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId      Int
  portoOrigemId  Int
  portoDestinoId Int
  dias           Int
  createdAt      DateTime @default(now())
