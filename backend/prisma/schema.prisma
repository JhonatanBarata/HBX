// Inbox legado (Customer global / Conversation@InboxConversation /
// Message@InboxMessage / SatisfactionSurvey) APOSENTADO em 03/07 (multi-tenancy
// Sprint 2). Nunca teve escrita viva — o atendimento real usa CompanyConversation /
// CompanyMessage (@@map "Message") / AtendimentoCustomer / CustomerProfile, todos com
// companyId. As 4 tabelas estavam VAZIAS (censo local + prod = 0 linhas). Dropadas na
// migration 20260703_drop_legacy_inbox. Removidos daqui pra encolher a cascata de
// deleção e zerar o passivo LGPD de PII global sem finalidade (art. 15/16 LGPD).

model AtendimentoCustomer {
