datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Role enum removed for broader connector compatibility; store role as string

model Company {
  id                      Int       @id @default(autoincrement())
  name                    String
  entityType              String    @default("PJ") // PF | PJ
  slug                    String?   @unique
  trialModuleSelection    String? // vendas | recovery
  selectedPlanKey         String? // hbx_lite | hbx_padrao | hbx_melhor
  signupUsesPublicEmail   Boolean   @default(false)
  acquisitionSource       String?
  acquisitionSourceDetail String?
  referralReferrerName    String?
  referralCode            String?
  referralDiscountConsumedAt DateTime?
  primaryContactName      String?
  contactEmail            String?
  contactPhone            String?
  taxDocument             String?
  whatsappNumber          String?
  whatsappPhoneNumberId   String?   @unique
  whatsappWabaId          String?
  whatsappAccessToken     String?
  whatsappDisplayNumber   String?
  whatsappStatus          String? // CONNECTED | DISCONNECTED | ERROR
  whatsappStatusError     String?
  whatsappStatusUpdatedAt DateTime?
  whatsappConnectionMode  String    @default("NONE") // NONE | TEMPORARY | OFFICIAL
  whatsappTemporaryStatus String    @default("NOT_CONNECTED") // NOT_CONNECTED | TEMPORARY | ATTENTION
  whatsappTemporaryInstanceKey String?
  whatsappTemporaryProvider String?
  whatsappTemporaryPairingCode String?
  whatsappTemporaryQrCodeData String?
  whatsappTemporaryDisplayNumber String?
  whatsappTemporaryLastSyncAt DateTime?
  whatsappTemporaryConnectedAt DateTime?
  whatsappTemporaryStatusError String?
  whatsappModalStatus      String?
  whatsappModalProvider    String?
  whatsappModalPhone       String?
  whatsappModalConnectedAt DateTime?
  whatsappModalLastError   String?
  whatsappModalUpdatedAt   DateTime?
  currentWhatsappConnectionSessionId String?
  whatsappMigrationInterestStatus String @default("NONE") // NONE | REQUESTED | CONTACTED | RESOLVED
  whatsappMigrationInterestAt DateTime?
  whatsappMigrationInterestSource String?
  whatsappMigrationWorkflowStatus String @default("NONE") // NONE | REQUESTED | CONTACTED | RESOLVED
  whatsappMigrationLastContactAt DateTime?
  whatsappMigrationInternalNote String?
  mercadoPagoAccessToken    String?
  mercadoPagoStatus         String? // CONNECTED | DISCONNECTED | ERROR
  mercadoPagoStatusError    String?
  mercadoPagoStatusUpdatedAt DateTime?
  mercadoPagoAccountEmail   String?
  mercadoPagoUserId         String?
  useMasterMercadoPagoToken Boolean   @default(false)
  useMasterWhatsAppToken    Boolean   @default(false)
  masterMercadoPagoCredentialKey String?
  masterWhatsAppCredentialKey    String?
  timezone                String?   @default("America/Sao_Paulo")
  onboardingStatus        String    @default("active_paid") // pending_email_confirmation | active_trial | active_paid | suspended
  isActive                Boolean   @default(true)
  paymentStatus           String    @default("PENDING") // PENDING | TRIAL | PAID | OVERDUE | EXPIRED | DISABLED
  paymentMethod           String    @default("NONE") // NONE | CARD | PIX | BOLETO | MANUAL
  billingCycle           String    @default("MONTHLY") // MONTHLY | ANNUAL
  subscriptionStatus      String    @default("trialing") // trialing | active | past_due | canceled | expired
  billingProvider         String    @default("manual") // manual | mercadopago | stripe | apple | google
  premiumAccess           Boolean   @default(false)
  themePreferenceConfig   String?
  billingCardBrand        String?
  billingCardLast4        String?
  billingCardHolderName   String?
  billingCardExpMonth     Int?
  billingCardExpYear      Int?
  billingCardUpdatedAt    DateTime?
  manualDiscountPercent   Float     @default(0)
  freeMonths              Int       @default(0)
  trialStartsAt           DateTime?
  trialEndsAt             DateTime?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd   DateTime?
  billingGraceStartedAt DateTime?
  billingGraceEndsAt    DateTime?
  billingGraceReason    String?
  billingGraceEmailStage Int      @default(0)
  billingGraceLastEmailAt DateTime?
  billingGraceLastFailureAt DateTime?
  deactivatedAt           DateTime?
  createdAt               DateTime  @default(now())
  products                Product[]
  users                   User[]
  plan                    Plan?     @relation(fields: [planId], references: [id])
  planId                  Int?

  conversations CompanyConversation[]
  messages      CompanyMessage[]
  currentWhatsappConnectionSession WhatsAppConnectionSession? @relation("CompanyCurrentWhatsappConnectionSession", fields: [currentWhatsappConnectionSessionId], references: [id], onDelete: SetNull)
  whatsappConnectionSessions WhatsAppConnectionSession[] @relation("CompanyWhatsappConnectionSessions")
  atendimentoAppointments AtendimentoAppointment[]
  inboxConversations Conversation[]

  autoReplyRules       AutoReplyRule[]
  inboundMessages      InboundMessage[]
  outboundMessages     OutboundMessage[]
  conversationSessions ConversationSession[]
  orderDrafts          OrderDraft[]
  companyModules       CompanyModule[]
  importacoes          Importacao[]
  importacaoPermissoes ImportacaoPermissao[]
  alertasImportacao    AlertaImportacao[]
  cadastroFornecedores CadastroFornecedor[]
  cadastroPaises       CadastroPais[]
  cadastroPortos       CadastroPorto[]
  cadastroTransitTimes CadastroTransitTime[]
  deletionRecords      DeletionRecord[]
  whatsappAuditLogs    WhatsAppAuditLog[]
  hbxRecoveryCustomers HbxRecoveryCustomer[]
  hbxRecoveryFlowStages HbxRecoveryFlowStage[]
  hbxRecoveryPayments  HbxRecoveryPayment[]
  financeiroCharges    FinanceiroCharge[]
  companySubscriptions CompanySubscription[]
  customerProfiles     CustomerProfile[]
  debtCases            DebtCase[]
  integrationConnections IntegrationConnection[]
  integrationSyncRuns  IntegrationSyncRun[]
  auvoExternalRecords  AuvoExternalRecord[]
  whatsappEndpoints    CompanyWhatsAppEndpoint[]
  techAssistantInteractions TechAssistantInteraction[]
  masterAssumedContextSessions MasterAssumedContextSession[]
  masterSupportAuditLogs MasterSupportAuditLog[]
  atendimentoCustomers AtendimentoCustomer[]
  webscrapingSearchHistories WebscrapingSearchHistory[]
  webscrapingSearchRuns WebscrapingSearchRun[]
  webscrapingSearchRunItems WebscrapingSearchRunItem[]
  webscrapingCampaigns WebscrapingCampaign[]
  hbxEngineLocks HbxEngineLock[]
  webscrapingUsageLogs WebscrapingUsageLog[]
  radarLeadPools RadarLeadPool[]
  radarLeadCompanyStates RadarLeadCompanyState[]
  radarLeadEvents RadarLeadEvent[]
  vendasLeads         VendasLead[]
  vendasAutomationCampaigns VendasAutomationCampaign[]
  vendasAutomationJobs VendasAutomationJob[]
  commercialEntitlements CompanyCommercialEntitlement[]
  commercialUsageLogs CompanyCommercialUsageLog[]
  trialPhoneUsages    TrialPhoneUsage[]
  nightFactoryRewardClaims NightFactoryRewardClaim[]

  @@index([currentWhatsappConnectionSessionId])
}

model WhatsAppConnectionSession {
  id              String    @id @default(cuid())
  company         Company   @relation("CompanyWhatsappConnectionSessions", fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  provider        String    @default("webwhats") // webwhats | meta
  tenantKey       String
  phoneNormalized String?
  displayPhone    String?
  status          String    @default("active") // active | disconnected | archived
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  metadataJson    String?

  currentForCompanies Company[] @relation("CompanyCurrentWhatsappConnectionSession")
  conversations CompanyConversation[]
  messages      CompanyMessage[]

  @@index([companyId, status])
  @@index([companyId, provider, phoneNormalized, status])
  @@index([companyId, tenantKey, status])
}

model NightFactoryRewardClaim {
  id              String   @id @default(cuid())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       Int?
  scopeKey        String
  leadIdsJson     String
  claimedAt       DateTime @default(now())
  nextAvailableAt DateTime
  windowKey       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadataJson    String?

  @@index([userId])
  @@index([companyId])
  @@index([scopeKey, claimedAt])
  @@index([scopeKey, nextAvailableAt])
  @@index([windowKey])
}

model CompanyCommercialEntitlement {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  key                String
  status             String   @default("active") // active | trialing | canceled | unavailable | blocked | paid | manual | pending_checkout
  source             String   @default("system") // trial | checkout | manual | migration | system
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  metadataJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, status])
  @@index([key, status])
}

model CompanyCommercialUsageLog {
  id           String   @id @default(cuid())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    Int
  userId       Int?
  planKey      String?
  eventType    String
  source       String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([companyId, eventType, createdAt])
  @@index([planKey, eventType, createdAt])
}

model TrialPhoneUsage {
  id                 String   @id @default(cuid())
  phoneNormalized    String   @unique
  company            Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId          Int?
  firstTrialStartsAt DateTime?
  firstTrialEndsAt   DateTime?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt
  source             String   @default("qr_pair")
  metadataJson       String?

  @@index([companyId])
}

model CompanyWhatsAppEndpoint {
  id                      String   @id @default(cuid())
  company                 Company  @relation(fields: [companyId], references: [id])
  companyId               Int
  label                   String?
  moduleKey               String?
  whatsappNumber          String?
  whatsappPhoneNumberId   String?  @unique
  whatsappWabaId          String?
  whatsappAccessToken     String?
  whatsappDisplayNumber   String?
  whatsappStatus          String? // CONNECTED | DISCONNECTED | ERROR
  whatsappStatusError     String?
  whatsappStatusUpdatedAt DateTime?
  isActive                Boolean  @default(true)
  isPrimary               Boolean  @default(false)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  outboundMessages        OutboundMessage[]

  @@index([companyId, moduleKey])
  @@index([companyId, isActive, sortOrder])
}

model CommercialPlanProviderMapping {
  id             String   @id @default(cuid())
  planKey        String
  billingCycle   String
  provider       String   @default("mercadopago")
  providerPlanId String
  amount         Float
  currency       String   @default("BRL")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([planKey, billingCycle, provider])
  @@index([provider, providerPlanId])
  @@index([active, provider])
}

model CompanySubscription {
  id                        String   @id @default(cuid())
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId                 Int
  provider                  String   @default("mercadopago")
  providerPreapprovalId     String?  @unique
  providerPreapprovalPlanId String?
  planKey                   String
  billingCycle              String
  status                    String   @default("pending") // pending | authorized | active | paused | canceled | past_due | blocked
  payerEmail                String?
  billingContactPhone       String?
  cardBrand                 String?
  cardLast4                 String?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  nextBillingAt             DateTime?
  cancelAtPeriodEnd         Boolean  @default(false)
  canceledAt                DateTime?
  lastProviderStatus        String?
  providerPayloadJson       String?
  createdByUserId           Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([companyId, status])
  @@index([provider, providerPreapprovalPlanId])
  @@index([provider, status])
}

model HbxRecoveryCustomer {
  id                  String   @id @default(cuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           Int
  customerProfile     CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  customerProfileId   String?
  name                String
  clientName          String?
  whatsappNumber      String
  openAmount          Float    @default(0)
  workdaySaleDay      Int
  recurringDelays     Int      @default(0)
  paymentHistoryScore Int      @default(5)
  totalPaid           Float    @default(0)
  averageDelay        Float    @default(0)
  automationEnabled   Boolean  @default(true)
  lastContact         String?
  status              String   @default("OVERDUE") // OVERDUE | PAID
  paymentHistory      String? // JSON serialized
  delayHistory        String? // JSON serialized
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  payments            HbxRecoveryPayment[]

  @@index([companyId, status])
  @@index([companyId, openAmount])
  @@index([customerProfileId])
}

model HbxRecoveryPayment {
  id                     String   @id @default(cuid())
  company                Company  @relation(fields: [companyId], references: [id])
  companyId              Int
  customer               HbxRecoveryCustomer @relation(fields: [customerId], references: [id])
  customerId             String
  debtCase               DebtCase? @relation(fields: [debtCaseId], references: [id])
  debtCaseId             String?
  conversationId         Int?
  amount                 Float
  currency               String   @default("BRL")
  description            String
  chargeType             String   @default("avista") // avista | parcelado
  installmentCount       Int      @default(1)
  installmentValue       Float?
  serviceDate            DateTime?
  serviceDescription     String?
  status                 String   @default("pending") // pending | approved | released | cancelled | failed | refunded | partially_refunded
  lifecycle              String   @default("in_progress") // paid | in_progress | finalized | cancelled
  paymentUrl             String?
  linkExpiresAt          DateTime?
  externalReference      String?
  mpPreferenceId         String?
  mpPaymentId            String?  @unique
  mpMerchantOrderId      String?
  notificationUrl        String?
  paidAt                 DateTime?
  refundedAt             DateTime?
  refundAmount           Float    @default(0)
  appliedToCustomerAmount Float   @default(0)
  reversedAmount         Float    @default(0)
  providerPayload        String?
  createdByUserId        Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, lifecycle, createdAt])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, conversationId, createdAt])
  @@index([debtCaseId, createdAt])
  @@index([externalReference])
}

model FinanceiroCharge {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         Int
  amount            Float
  currency          String   @default("BRL")
  description       String
  billingCycle      String   @default("MONTHLY") // MONTHLY | ANNUAL
  paymentMethod     String   @default("PIX") // PIX | CARD | BOLETO | BONUS
  status            String   @default("pending") // pending | approved | cancelled | failed | refunded | partially_refunded
  lifecycle         String   @default("in_progress") // in_progress | paid | cancelled | finalized
  competence        String?
  externalReference String?  @unique
  mpPreferenceId    String?
  mpPaymentId       String?  @unique
  mpMerchantOrderId String?
  notificationUrl   String?
  paymentUrl        String?
  pixQrCode         String?
  pixQrCodeBase64   String?
  pixTicketUrl      String?
  ledgerEntryId     String?
  paidAt            DateTime?
  refundedAt        DateTime?
  refundAmount      Float    @default(0)
  providerPayload   String?
  lastWebhookAt     DateTime?
  lastWebhookPayload String?
  createdByUserId   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, lifecycle, createdAt])
  @@index([companyId, status, createdAt])
}

model HbxRecoveryFlowStage {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  title     String
  channel   String   @default("WhatsApp API")
  template  String
  daysAfter Int      @default(0)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, sortOrder])
  @@index([companyId, enabled])
}

model CompanyConversation {
  id            Int      @id @default(autoincrement())
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     Int
  whatsappConnectionSession WhatsAppConnectionSession? @relation(fields: [whatsappConnectionSessionId], references: [id], onDelete: SetNull)
  whatsappConnectionSessionId String?
  sourcePhoneNormalized String?
  sourceTenantKey String?
  channel       String   @default("whatsapp")
  contact       String
  currentFlow   String   @default("cobranca_recovery")
  currentStep   String   @default("novo")
  flowResult    String?
  botActive     Boolean  @default(false)
  humanAssigned Boolean  @default(false)
  assignedUserId Int?
  metadata      String?
  lastInteractionAt DateTime @default(now())
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages CompanyMessage[]
  atendimentoAppointments AtendimentoAppointment[]

  @@unique([companyId, channel, contact, whatsappConnectionSessionId])
  @@index([companyId, channel, contact])
  @@index([companyId, whatsappConnectionSessionId])
  @@index([companyId, lastMessageAt])
  @@index([companyId, botActive, humanAssigned, lastInteractionAt])
  @@map("Conversation")
}

model AtendimentoAppointment {
  id                    Int      @id @default(autoincrement())
  company               Company  @relation(fields: [companyId], references: [id])
  companyId             Int
  conversation          CompanyConversation? @relation(fields: [conversationId], references: [id])
  conversationId        Int?
  customerName          String?
  customerPhone         String
  agendaGroupId         String
  responsibleName       String?
  responsibleEmail      String?
  startsAt              DateTime
  endsAt                DateTime
  timezone              String   @default("America/Sao_Paulo")
  status                String   @default("confirmed") // confirmed | canceled
  source                String   @default("whatsapp_atendimento")
  googleCalendarEventId String?
  calendarSyncStatus    String   @default("not_configured") // not_configured | pending | synced | failed
  metadata              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId, customerPhone, status, startsAt])
  @@index([companyId, agendaGroupId, status, startsAt])
  @@index([conversationId, startsAt])
}

model InboxTrashMeticulousPurgeJob {
  id                         String    @id @default(cuid())
  companyId                  Int
  startedByUserId            Int?
  status                     String    @default("idle") // idle | running | paused | paused_provider_unhealthy | paused_after_restart | canceled | completed | failed
  mode                       String    @default("dry_run") // dry_run | real
  dryRun                     Boolean   @default(true)
  olderThanHours             Int       @default(24)
  limit                      Int?
  delayMs                    Int       @default(120000)
  jitterMinMs                Int       @default(5000)
  jitterMaxMs                Int       @default(20000)
  candidateIdsJson           String    @default("[]")
  previewJson                String    @default("[]")
  totalCandidates            Int       @default(0)
  currentIndex               Int       @default(0)
  currentConversationId      Int?
  currentPhone               String?
  currentLastCustomerWords   String?
  currentDetectedReason      String?
  processed                  Int       @default(0)
  markedNegative             Int       @default(0)
  purged                     Int       @default(0)
  skipped                    Int       @default(0)
  errorsJson                 String    @default("[]")
  lastError                  String?
  providerStatus             String?
  providerHealthJson         String?
  nextRunAt                  DateTime?
  startedAt                  DateTime  @default(now())
  finishedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([companyId, status])
  @@index([status, nextRunAt])
}

model CompanyMessage {
  id             Int                 @id @default(autoincrement())
  company        Company             @relation(fields: [companyId], references: [id])
  companyId      Int
  conversation   CompanyConversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  whatsappConnectionSession WhatsAppConnectionSession? @relation(fields: [whatsappConnectionSessionId], references: [id], onDelete: SetNull)
  whatsappConnectionSessionId String?
  sourcePhoneNormalized String?
  sourceTenantKey String?

  contactId   String?
  direction String // INBOUND | OUTBOUND
  messageType String   @default("text") // text | template
  body      String
  senderType String @default("system") // bot | human | client | system
  isComplaint Boolean @default(false)
  variablesJson String?
  status    String   @default("RECEIVED") // RECEIVED | QUEUED | SENDING | SENT | DELIVERED | READ | FAILED
  error     String?
  timestamp DateTime @default(now())
  sourceModule String?

  provider          String? @default("WHATSAPP_CLOUD")
  providerMessageId String? @unique
  rawPayload        String?

  outboundMessageId Int?             @unique
  outboundMessage   OutboundMessage? @relation("OutboundMessageMessage", fields: [outboundMessageId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, whatsappConnectionSessionId, timestamp])
  @@index([companyId, conversationId, timestamp])
  @@index([conversationId, senderType, timestamp])
  @@map("Message")
}

model Customer {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model AtendimentoCustomer {
  id                  String   @id @default(cuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           Int
  customerProfile     CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  customerProfileId   String?
  name                String?
  phone               String
  phoneNormalized     String
  registrationOrigin  String   @default("whatsapp_bot") // whatsapp_bot | manual | recovery_to_atendimento
  registrationStatus  String   @default("pending_confirmation") // pending_confirmation | confirmed | manual
  route               String   @default("atendimento") // atendimento | recovery
  notes               String?
  lastMessageAt       DateTime?
  conversationId      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, phoneNormalized])
  @@index([companyId, registrationStatus])
  @@index([companyId, registrationOrigin])
  @@index([companyId, updatedAt])
  @@index([customerProfileId])
}

model CustomerProfile {
  id                   String   @id @default(cuid())
  company              Company  @relation(fields: [companyId], references: [id])
  companyId            Int
  sourceConnection     IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId   String?
  name                 String?
  profileName          String?
  nameSource           String?
  nameConfirmed        Boolean  @default(false)
  phone                String?
  phoneNormalized      String?
  email                String?
  document             String?
  externalSource       String?
  externalCustomerId   String?
  status               String   @default("active")
  notes                String?
  firstInboundAt       DateTime?
  lastInboundAt        DateTime?
  botOff               Boolean  @default(false)
  botOffReason         String?
  botOffAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  atendimentoCustomers AtendimentoCustomer[]
  hbxRecoveryCustomers HbxRecoveryCustomer[]
  debtCases            DebtCase[]
  vendasLeads          VendasLead[]

  @@unique([companyId, phoneNormalized])
  @@index([companyId, document])
  @@index([sourceConnectionId, externalCustomerId])
  @@index([companyId, status])
}

model DebtCase {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id])
  companyId          Int
  customerProfile    CustomerProfile @relation(fields: [customerProfileId], references: [id])
  customerProfileId  String
  sourceConnection   IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId String?
  sourceProvider     String
  externalDebtId     String?
  amount             Float    @default(0)
  dueDate            DateTime?
  paidAt             DateTime?
  status             String   @default("open")
  rawPayloadJson     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  payments           HbxRecoveryPayment[]

  @@index([companyId, customerProfileId])
  @@index([companyId, status])
  @@index([sourceConnectionId, externalDebtId])
}

model IntegrationConnection {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id])
  companyId          Int
  provider           String
  instanceName       String
  secretCiphertext   String?
  secretPreview      String?
  status             String   @default("DISCONNECTED")
  lastTestedAt       DateTime?
  lastTestStatus     String?
  lastTestMessage    String?
  lastSyncAt         DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customerProfiles   CustomerProfile[]
  debtCases          DebtCase[]
  syncRuns           IntegrationSyncRun[]
  auvoExternalRecords AuvoExternalRecord[]

  @@index([companyId, provider, isActive])
  @@index([companyId, status, lastSyncAt])
}

model IntegrationSyncRun {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
