model RadarMission {
  id             String    @id @default(cuid())
  stage          String    // enrich_lead | enrich_search_item
  status         String    @default("queued") // queued | leased | completed | dead | canceled
  priority       Int       @default(0)
  payloadVersion Int       @default(1)
  payloadJson    Json
  dedupeKey      String?
  correlationId  String?
  company        Company?  @relation("RadarMissionCompany", fields: [companyId], references: [id], onDelete: SetNull)
  companyId      Int?
  radarLead      RadarLeadPool? @relation("RadarMissionRadarLead", fields: [radarLeadId], references: [id], onDelete: SetNull)
  radarLeadId    String?
  requestedBy    User?     @relation("RadarMissionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByUserId Int?
  runId          String?
  workVersion    Int?
  consumerKind   String    @default("vps")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextAttemptAt  DateTime  @default(now())
  leaseId        String?
  leasedBy       String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  startedAt      DateTime?
  lastPhase      String?
  lastError      String?
  resultJson     Json?
  receiptJson    Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([stage, dedupeKey])
  @@unique([stage, radarLeadId, workVersion])
  @@index([stage, status, nextAttemptAt])
  @@index([consumerKind, status, nextAttemptAt, priority])
  @@index([radarLeadId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([runId, status])
  @@index([status, leaseExpiresAt])
  @@index([correlationId, status])
}

// Trilha WORM do contrato local_deep_enrich_v1. A migration instala gatilhos
// que recusam UPDATE/DELETE; o Prisma apenas materializa a leitura operacional.
model RadarLocalEnrichmentAudit {
  id                     String   @id
  missionId              String   @unique
  radarLeadId            String
  companyId              Int?
  workerId               String
  contractVersion        String
  workVersion            Int
  requestHash            String
  requestBodyFingerprint String
  resultHash             String
  beforeJson             Json
  deltaJson              Json
  createdContactIds      Json
  createdPersonIds       Json
  vendasLeadIds          Json
  evidenceJson           Json
  receiptJson            Json
  startedAt              DateTime
  committedAt            DateTime @default(now())
  durationMs             Int

  @@index([radarLeadId, committedAt])
  @@index([companyId, committedAt])
  @@index([workerId, committedAt])
}

// Cada reversão também é append-only. A função de reversão nunca é concedida
// ao worker; o Gate D vincula seu papel NOLOGIN apenas ao System Master.
model RadarLocalEnrichmentReversal {
  id                String   @id
  missionId         String   @unique
  auditId           String
  requestedBy       String
  reason            String
  removedContactIds Json
  removedPersonIds  Json
  restoredJson      Json
  skippedJson       Json
  receiptJson       Json
  createdAt         DateTime @default(now())

  @@index([auditId])
  @@index([createdAt])
}

// Estado durável da corrida da fábrica de enriquecimento. O backend e o card do Owner
// compartilham a linha canônica key="main"; o modelo precisa existir no Prisma Client.
model RadarFabricaRun {
  id               String    @id @default(cuid())
  key              String    @unique @default("main")
  running          Boolean   @default(false)
  stopRequested    Boolean   @default(false)
  budget           Int       @default(0)
  processed        Int       @default(0)
  materialized     Int       @default(0)
  contactsWritten  Int       @default(0)
  paidAttempts     Int       @default(0)
  lastLeadId       String?
  lastError        String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model HarvestImportBatch {
  id              String   @id @default(cuid())
  batchId         String   @unique
  companyId       Int?
  requestedByUserId Int?
  sourceMode      String
  sourceName      String
  requestedBy     String?
  city            String?
  state           String?
  segment         String?
  targetEmails    Int?
  providersJson   String   @default("[]")
  statsJson       String?
  status          String   @default("received") // received | validated | imported | partial | rejected
  receivedCount   Int      @default(0)
  acceptedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  duplicateCount  Int      @default(0)
  negativeCount   Int      @default(0)
  optOutCount     Int      @default(0)
  resultJson      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           HarvestImportItem[]

  @@index([companyId, createdAt])
  @@index([status, createdAt])
}

model HarvestImportItem {
  id                String   @id @default(cuid())
  importBatch       HarvestImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importBatchId     String
  externalId        String
  kind              String   // lead | email
  normalizedEmail   String?
  normalizedPhone   String?
  normalizedDomain  String?
  companyName       String?
  website           String?
  sourceUrl         String
  sourceProvider    String
  confidence        Int      @default(0)
  status            String   @default("accepted") // accepted | rejected | duplicate | negative | opt_out
  rejectReason      String?
  payloadJson       String?
  importedRadarLeadId String?
  importedVendasLeadId String?
  createdAt         DateTime @default(now())

  @@unique([importBatchId, externalId, kind])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedDomain])
  @@index([status, createdAt])
}

model RadarStockConfig {
  id                String   @id @default(cuid())
  normalizedCity    String
  state             String   @default("")
  normalizedSegment String
  desiredStock      Int      @default(300)
  minimumStock      Int      @default(80)
  engine            String   @default("hbx")
  targetType        String   @default("pj")
  filtersJson       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([normalizedCity, state, normalizedSegment])
  @@index([normalizedCity, normalizedSegment])
}

model VendasLead {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  customerProfileId String?
  sourceType        String   @default("manual") // manual | webscraping
  primarySource     String   @default("manual")
  sourceHistoryId   String?
  // Ponto de não-retorno da aquisição Radar: uma saga paga materializa no
  // máximo um card core e recovery só confia neste vínculo explícito.
  claimOperationId  String?  @unique
  // Snapshot canônico dos contatos adquiridos (até 3 telefones + 3 e-mails,
  // com origem/rank). Não depende de CustomerProfile/Inbox auxiliares.
  contactSnapshotJson String?
  sourceSignature   String?
  timesSeen         Int      @default(1)
  name              String?
  phone             String?
  phoneNormalized   String?
  email             String?
  address           String?
  website           String?
  rating            Float?
  reviews           Int      @default(0)
  opportunityScore  Int?     // score de oportunidade herdado do Radar (snapshot p/ card do Vendas — B2 PR13062026008)
  leadTemperature   String?  // frio | morno | quente — grau de calor do lead (Fase 1 PR14062026013)
  city              String?
  state             String?
  segment           String?
  status            String   @default("novo") // novo | contato | retorno | qualificado | encerrado
  pipelineStage     String?  @default("prospeccao")
  outcome           String?  @default("open")
  nextAction        String?
  returnAt          DateTime?
  shortNote         String?
  lastContactAt     DateTime?
  attemptCount      Int      @default(0)
  lastResult        String?
  wasClosedBefore   Boolean  @default(false)
  closedAt          DateTime?
  createdByUserId   Int?
  assignedUserId    Int?
  assignedByUserId  Int?
  assignedAt        DateTime?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId         Int?
  productKindSnapshot String?
  productNameSnapshot String?
  productPriceCentsSnapshot Int?
  productCurrencySnapshot String?
  productBillingCycleSnapshot String?
  productCommissionPercentSnapshot Float?
  productPlanKeySnapshot String?
  commissionPercentSnapshot Float @default(0)
  saleStatus        String   @default("none") // none | activation_pending | trial_started | sale_confirmed | inactive | canceled
  saleValue         Float    @default(0)
  salePlanKey       String?
  saleConfirmedAt   DateTime?
  saleCanceledAt    DateTime?
  commissionStatus  String   @default("none") // none | pending | payable | paid | canceled
  commissionBaseAmount Float @default(0)
  commissionAmount  Float    @default(0)
  commissionDueAt   DateTime?
  commissionPaidAt  DateTime?
  commissionRecurring Boolean @default(false)
  commissionNote    String?
  // Implantação (one-time, negociado por negócio) — PR13062026005.
  // Paralelo ao saleValue mensal; comissão one-time, NÃO entra no recurring.
  setupValue            Float?
  setupCommissionAmount Float?
  setupCommissionStatus String?  // none | pending | payable | paid | canceled
  commissionLinkedCompanyId Int?
  commissionLinkedAt DateTime?
  commissionAutoSyncedAt DateTime?
  commissionSyncSource String?
  commissionPayoutId String?
  // E5 (PLAN12062026001): caso de cancelamento — comissão só estorna com
  // decisão do master; saldo a restituir filtra a triagem.
  cancellationCaseStatus       String?   // open | resolved
  cancellationCaseOpenedAt     DateTime?
  cancellationCaseRefundAmount Float?
  cancellationCaseResolution   String?   // kept | reversed | unlinked
  cancellationCaseResolvedAt   DateTime?
  cancellationCaseResolvedByUserId Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  timelineEvents    VendasLeadTimelineEvent[]
  conversations     CompanyConversation[]
  cockpitState      VendasLeadCockpitState?
  automationJobs    VendasAutomationJob[]
  automationEnrollments AutomationEnrollment[]
  automationStepRuns AutomationStepRun[]
  automationLedgerEvents AutomationLedgerEvent[]
  emailOutboundMessages EmailOutboundMessage[]
  radarCompanyStates RadarLeadCompanyState[]
  commissionReceivables VendasCommissionReceivable[]
  atividades        Atividade[]

  @@unique([companyId, phoneNormalized])
  @@index([companyId, status, returnAt])
  @@index([companyId, updatedAt])
  @@index([companyId, claimOperationId])
  @@index([assignedUserId, status])
  @@index([assignedUserId, commissionStatus])
  @@index([companyId, saleStatus])
  @@index([commissionLinkedCompanyId])
  @@index([commissionPayoutId])
  @@index([companyId, cancellationCaseStatus])
  @@index([customerProfileId])
  @@index([productId])
  @@index([companyId, productId])
}

model VendasLeadCockpitState {
  lead                       VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId                     String     @id
  companyId                  Int
  conversationId             Int?
  engagementState            String     @default("no_conversation")
  hasInboundMessage          Boolean    @default(false)
  hasInboundReply            Boolean    @default(false)
  firstSuccessfulOutboundAt  DateTime?
  lastSuccessfulOutboundAt   DateTime?
  lastOutboundAt             DateTime?
  lastOutboundStatus         String?
  lastInboundAt              DateTime?
  lastMessageId              Int?
  lastMessageAt              DateTime?
  lastMessageDirection       String?
  lastMessageStatus          String?
  lastMessagePreview         String?
  lastFailureAt              DateTime?
  lastFailureReason          String?
  version                     Int        @default(1)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  @@index([companyId, engagementState])
  @@index([companyId, conversationId])
}

model VendasCommissionPayout {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  sellerUserId    Int?
  status          String   @default("paid") // paid | canceled
  leadCount       Int      @default(0)
  totalAmount     Float    @default(0)
  referenceLabel  String?
  notes           String?
  paidAt          DateTime?
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, paidAt])
  @@index([sellerUserId, paidAt])
}

model VendasCommissionReceivable {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  lead            VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  sellerUserId    Int?
  linkedCompanyId Int?
  cycleKey        String
  kind            String   @default("recurring") // recurring
  status          String   @default("payable") // payable | paid | canceled
  baseAmount      Float    @default(0)
  commissionPercent Float  @default(0)
  amount          Float    @default(0)
  dueAt           DateTime?
  paidAt          DateTime?
  payoutId        String?
  source          String   @default("hbx_recurring")
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([leadId, cycleKey, kind])
  @@index([companyId, status, dueAt])
  @@index([sellerUserId, status, dueAt])
  @@index([linkedCompanyId])
  @@index([payoutId])
  @@index([cycleKey])
}

model VendasLeadTimelineEvent {
  id              String     @id @default(cuid())
  lead            VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  eventType       String
  title           String
  description     String?
  sourceType      String?
  statusFrom      String?
  statusTo        String?
  resultLabel     String?
  returnAt        DateTime?
  createdByUserId Int?
  idempotencyKey  String?
  createdAt       DateTime   @default(now())

  @@unique([leadId, idempotencyKey])
  @@index([leadId, createdAt])
}

// WORM-12 (02/07, docs/PLANEJAMENTOS/worm/12-tela-atividades-agenda.md): agenda do
// vendedor. Cada Atividade e uma tarefa datada amarrada a um card (VendasLead) — a
// tela "Hoje" a le por responsavel+vencimento. Concluir (realizadaEm+resultado) escreve
// UM evento na VendasLeadTimelineEvent (reuso; sem timeline nova) e alimenta o
// engajamento/termometro do card (WORM-10). WORM-13 cria por automacao via criadaPor.
model Atividade {
  id             String     @id @default(cuid())
  lead           VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String
  companyId      Int
  tipo           String     @default("ligacao") // ligacao | reuniao | visita | mensagem
  titulo         String
  vencimento     DateTime
  duracao        Int?       // minutos; null = "dia inteiro"
  responsavelId  Int?       // User.id — vendedor dono da tarefa
  realizadaEm    DateTime?  // null = pendente; preenchido ao concluir
  resultado      String?    // sim | nao | remarcar (ou texto livre) — alimenta engajamento
  criadaPor      String     @default("user") // user | automacao | ia
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyId, responsavelId, vencimento])
  @@index([leadId])
  @@index([companyId, realizadaEm, vencimento])
}

// WORM-15 (02/07) — pesquisa SALVA nomeada pelo usuario (diferente do
// WebscrapingSearchHistory, que e historico automatico de busca). Guarda um
// recorte de filtros do Radar (filtroJson = subset de RadarFiltersInput) para
// re-rodar depois (`POST /saved-search/:id/run` reusa listRadarLeadsForUser).
// assignedSellerId (vendedor "dono" do recorte) e so INFORMATIVO — o hook que
// alimentava standing-order foi removido (LIMPEZA-DESTRUTIVA L4, 04/07).
// Colunas Int cruas (companyId/ownerId/assignedSellerId) sem back-relation,
// mesmo padrao do Atividade — migration escrita a mao (banco dev desligado).
model SavedSearch {
  id               String   @id @default(cuid())
  companyId        Int
  ownerId          Int      // User.id que criou a pesquisa
  nome             String
  filtroJson       String   // JSON com o recorte de filtros do Radar
  assignedSellerId Int?     // User.id do vendedor "dono do recorte" (opcional)
  lastRunAt        DateTime? // ultima vez que rodou
  lastCount        Int?     // quantos leads a ultima execucao devolveu
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, ownerId, createdAt])
  @@index([companyId, assignedSellerId])
}

model SalesProfile {
  id                      String   @id @default(cuid())
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId               Int
  user                    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  Int?
  profileName             String   @default("Perfil de Venda")
  whatDoYouSell           String?
  offerCategory           String?
  targetAudienceJson      String?
  targetSegmentsJson      String?
  avoidSegmentsJson       String?
  preferredCitiesJson     String?
  preferredStatesJson     String?
  preferredChannelsJson   String?
  leadPreferencesJson     String?
  ticketRange             String?
  salesGoal               String?
  negativeRulesJson       String?
  weeklyAutoUpdateEnabled Boolean  @default(false)
  source                  String   @default("manual") // manual | weekly_auto | admin | system_default
  lastAppliedAt           DateTime?
  lastSuggestedAt         DateTime?
  suggestedProfileJson    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, weeklyAutoUpdateEnabled])
}

model VendasAutomationCampaign {
  id                         String   @id @default(cuid())
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId                  Int
  createdByUserId            Int?
  status                     String   @default("running") // running | paused | canceled | done | error
  city                       String
  state                      String?
  segment                    String
  engine                     String   @default("hbx")
  targetType                 String   @default("pj")
  filtersJson                String?
  searchSignature            String?
  messageTemplate            String
  intervalMinutes            Int      @default(20)
  dailyLimit                 Int      @default(15)
  minLeadBuffer              Int      @default(15)
  desiredLeadBuffer          Int      @default(60)
  maxAttemptsPerLead         Int      @default(1)
  workingHoursStart          String   @default("09:00")
  workingHoursEnd            String   @default("17:30")
  typingSeconds              Int      @default(8)
  typingVarianceSeconds      Int      @default(12)
  positiveIntentKeywordsJson String?
  negativeIntentKeywordsJson String?
  optOutMessage              String?
  websiteFallbackEnabled     Boolean  @default(true)
  lastScrapeAt               DateTime?
  lastStatusText             String?
  lastError                  String?
  // Régua (PR13062026007, 5º muro fail-closed): automação que contata humano só
  // dispara com triagem CONFIRMADA por dono/gerente. null = NUNCA dispara (default
  // seguro). O worker (findNextDueJob) exige triagemConfirmedAt != null.
  triagemConfirmedAt         DateTime?
  triagemConfirmedByUserId   Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  jobs                       VendasAutomationJob[]

  @@index([companyId, status, updatedAt])
  @@index([companyId, createdAt])
}

model VendasAutomationJob {
  id             String                    @id @default(cuid())
  campaign       VendasAutomationCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      Int
  lead           VendasLead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String
  conversationId Int?
  status         String                    @default("pending") // pending | scheduled | sending | sent | replied_positive | replied_negative | no_response_archived | failed | skipped | canceled
  scheduledAt    DateTime?
  sentAt         DateTime?
  repliedAt      DateTime?
  archivedAt     DateTime?
  attemptNumber  Int                       @default(1)
  classification String?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([companyId, status, scheduledAt])
  @@index([campaignId, status, scheduledAt])
  @@index([leadId, status])
  @@index([conversationId])
}

// Fase 3 — execução canônica das automações comerciais. Campanha e Cadência
// continuam sendo as definições; este modelo representa a inscrição operacional
// e conserva um snapshot do que estava aprovado quando ela começou.
model AutomationEnrollment {
  id                     String   @id @default(cuid())
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId              Int
  lead                   VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId                 String
  definitionKind         String   // prospecting_campaign | cadence
  definitionId           String
  definitionSnapshotJson String?
  legacySource           String?
  legacyExecutionId      String?
  status                 String   @default("active") // active | paused | completed | canceled | failed
  // "commercial" enquanto ativa/pausada; null em estado terminal. A unique
  // abaixo garante no banco somente uma automação comercial por lead.
  activeCommercialSlot   String?
  currentStep            Int      @default(0)
  nextStepAt             DateTime?
  startedAt              DateTime @default(now())
  pausedAt               DateTime?
  completedAt            DateTime?
  canceledAt             DateTime?
  stopReason             String?
  lastError              String?
  version                Int      @default(1)
  metadataJson           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  stepRuns               AutomationStepRun[]
  ledgerEvents           AutomationLedgerEvent[]

  @@unique([companyId, leadId, activeCommercialSlot])
  @@index([companyId, definitionKind, definitionId, leadId])
  @@index([companyId, status, nextStepAt])
  @@index([leadId, status])
}

// Uma tentativa lógica de passo. Retry físico continua em OutboundAttempt; o
// mesmo passo nunca cria outra mensagem apenas porque o provedor será tentado de
// novo. leaseUntil permite claim atômico e recuperação entre réplicas.
model AutomationStepRun {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  lead              VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId            String
  enrollment        AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId      String
  stepKey            String
  sequence           Int      @default(0)
  attemptNumber      Int      @default(1)
  channel            String
  purpose            String   @default("commercial_contact")
  status             String   @default("scheduled") // scheduled | claimed | queued | dispatching | succeeded | failed | canceled | skipped
  idempotencyKey     String
  scheduledAt        DateTime?
  claimedAt          DateTime?
  leaseUntil         DateTime?
  queuedAt           DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  outboundMessage    OutboundMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  outboundMessageId  Int?     @unique
  emailOutboundMessage EmailOutboundMessage?
  errorCode          String?
  errorMessage       String?
  metadataJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  ledgerEvents       AutomationLedgerEvent[]

  @@unique([companyId, idempotencyKey])
  @@unique([enrollmentId, stepKey, attemptNumber])
  @@index([companyId, status, scheduledAt])
  @@index([enrollmentId, status])
}

// Trilha técnica append-only. Não substitui a timeline comercial do vendedor e
// não armazena corpo integral da mensagem nem payload bruto do provedor.
model AutomationLedgerEvent {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  lead            VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  enrollment      AutomationEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  enrollmentId    String?
  stepRun         AutomationStepRun? @relation(fields: [stepRunId], references: [id], onDelete: SetNull)
  stepRunId       String?
  eventType       String
  source          String
  statusFrom      String?
  statusTo        String?
  idempotencyKey  String
  occurredAt      DateTime @default(now())
  metadataJson    String?
  createdAt       DateTime @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, leadId, occurredAt])
  @@index([enrollmentId, occurredAt])
  @@index([stepRunId, occurredAt])
}

// ================================================================
// WORM-13 (02/07) — Automacoes: cadencia com PERSONA + gatilhos + rotinas.
// A EMBALAGEM: o cliente nao monta fluxo, ESCOLHE uma PERSONALIDADE de cadencia
// (Conservador/Moderado/Agressivo). Cada passo e {dia, canal, template}. O canal
// WhatsApp NAO usa API crua: o runner reusa o caminho ja provado do bot de
// prospeccao (ConversationsService.queueOutboundForCompany, sourceModule
// 'vendas_prospeccao_bot') — que ja tem disjuntor, 1 numero=1 conexao, teto
// diario/warmup. "Agressiva" = mais TOQUES (email/atividade), NUNCA mais pressao
// no chip: o teto de WhatsApp/dia e tecnico e fixo, nao configuravel pelo cliente.
// TODO auto-disparo fica atras da flag HBX_CADENCIA_RUNNER_ENABLED (default OFF).
// Colunas Int cruas (companyId/etc) sem back-relation, mesmo padrao do Atividade/
// SavedSearch — migration escrita a mao (banco dev desligado).
model Cadencia {
  id          String   @id @default(cuid())
  companyId   Int
  ownerId     Int?     // User.id que criou/aplicou
  nome        String
  persona     String   @default("conservador") // conservador | moderado | agressivo | custom
  descricao   String?
  passosJson  String   // JSON [{dia:int, canal:'whats'|'email'|'atividade', titulo?, corpo?, templateId?, atividadeTipo?}]
  ativa       Boolean  @default(true)
  isSeed      Boolean  @default(false) // seed de persona (nao editavel/removivel pela UI)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inscricoes  CadenciaInscricao[]

  @@index([companyId, ativa, createdAt])
}

// Um lead INSCRITO numa cadencia. O runner diario avanca currentStep respeitando
// os dias (nextStepAt) e os tetos de chip. Unico por (cadencia,lead) ativo — o
// runner nao inscreve duas vezes o mesmo lead na mesma cadencia.
model CadenciaInscricao {
  id           String   @id @default(cuid())
  cadencia     Cadencia @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)
  cadenciaId   String
  companyId    Int
  leadId       String
  responsavelId Int?    // vendedor dono (para atividades/notificacao)
  status       String   @default("ativa") // ativa | concluida | pausada | cancelada
  currentStep  Int      @default(0) // proximo passo a executar (indice no passosJson)
  startedAt    DateTime @default(now())
  nextStepAt   DateTime // quando o proximo passo fica devido
  lastStepAt   DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([cadenciaId, leadId])
  @@index([companyId, status, nextStepAt])
  @@index([leadId, status])
}

// 13b — Gatilho reativo: evento (ex.: lead respondeu WhatsApp) -> acoes. As acoes
// sao seguras e reusam superficies existentes: mover status (funil), criar
// atividade (hook WORM-12) e notificar vendedor (timeline/realtime). Nenhuma acao
// dispara WhatsApp automatico (o inbound ja significa que o humano falou; o bot de
// atendimento cuida da resposta).
model CadenciaGatilho {
  id          String   @id @default(cuid())
  companyId   Int
  ownerId     Int?
  nome        String
  evento      String   @default("lead_respondeu_whatsapp") // lead_respondeu_whatsapp | email_lido
  acoesJson   String   // JSON [{tipo:'mover_status'|'criar_atividade'|'notificar_vendedor', ...params}]
  ativo       Boolean  @default(true)
  lastFiredAt DateTime?
  fireCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, evento, ativo])
}

// 13c — Rotina recorrente em cima do WORM-15 (SavedSearch): "toda segunda, puxa N
// leads do filtro Y pro vendedor Z". O runner diario dispara SavedSearch.run
// quando o dia da semana bate e a janela de recorrencia esta aberta. Atras da
// mesma flag do runner (default OFF).
model CadenciaRotina {
  id             String   @id @default(cuid())
  companyId      Int
  ownerId        Int?
  nome           String
  savedSearchId  String   // SavedSearch.id (WORM-15)
  assignedSellerId Int?   // vendedor destino (Z)
  everyWeeks     Int      @default(1) // repete a cada N semanas
  weekdaysJson   String   @default("[1]") // JSON int[] 0=Dom..6=Sab
  maxLeads       Int      @default(50)
  startsAt       DateTime @default(now())
  endsAt         DateTime? // null = nunca termina
  visibleOnlyToOwner Boolean @default(false)
  ativa          Boolean  @default(true)
  lastRunAt      DateTime?
  lastRunCount   Int?
  lastRunStatus  String?  // sucesso | erro | pulada
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, ativa, lastRunAt])
}

