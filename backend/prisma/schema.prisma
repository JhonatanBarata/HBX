// ===========================================================================
// CONTABIL — contador-robô do dono (/master). Modelos aditivos, prefixo Fiscal*.
// S1: só LÊ receita (MasterBillingLedgerEntry). Campos *Encrypted ficam null
// até S6/S7 (certificado A1 / credencial Serpro — nunca em log/seed/git).
// ===========================================================================

model FiscalProfile {
  id                   Int       @id @default(1) // singleton do dono (1 linha)
  cnpj                 String?
  razaoSocial          String?
  dataAbertura         DateTime?
  regime               String    @default("simples") // simples
  anexoBase            String    @default("V") // nasce no V; Fator R decide III/V
  cnaePrincipal        String    @default("6203-1/00")
  aliquotaIssMunicipal Float? // p/ exibição
  prolaboreAlvoPct     Float     @default(0.28) // Fator R alvo
  certA1Encrypted      String? // S6 — AES-256-GCM, NUNCA em log
  certA1ExpiresAt      DateTime?
  serproCredEncrypted  String? // S7
  updatedAt            DateTime  @updatedAt
}

model FiscalRevenueMonth {
  id                String    @id @default(cuid())
  competencia       String    @unique // "2026-07"
  receitaCaixaCents Int       @default(0) // MP aprovado no mês (regime de caixa)
  receitaNotasCents Int       @default(0) // NFS-e emitidas (S6)
  ajusteManualCents Int       @default(0) // correção do dono, com motivo
  ajusteMotivo      String?
  folhaMesCents     Int       @default(0) // pró-labore bruto do mês
  rbt12Cents        Int       @default(0) // calculado
  folha12mCents     Int       @default(0) // calculado
  fatorR            Float? // folha12m / rbt12
  anexoAplicado     String? // "III" | "V"
  aliquotaEfetiva   Float?
  dasPrevistoCents  Int?
  inssPrevistoCents Int?
  irrfPrevistoCents Int?
  fechadoEm         DateTime? // S5 — mês fechado pelo copiloto
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// CONTABIL S2 — calendário fiscal. 1 linha por (competencia, tipo) de obrigação.
// Máquina de estados: AGUARDANDO_DADOS -> PRONTO -> ARMADO -> TRANSMITIDO -> PAGO
// -> CONFERIDO; ATRASADO é overlay (now > dueDate, estado != CONFERIDO/naoAplicavel).
model FiscalObligation {
  id              String   @id @default(cuid())
  competencia     String // "2026-07" ou "2026-ANUAL" (DEFIS)
  tipo            String // PGDASD | DAS | ESOCIAL_S1200 | DCTFWEB | DARF_INSS | DEFIS | LIVRO_CAIXA
  dueDate         DateTime
  estado          String   @default("AGUARDANDO_DADOS")
  payloadJson     String? // números prontos p/ transmitir (S5)
  resultJson      String? // recibo/nº protocolo/comprovante (marcação manual do dono)
  naoAplicavel    Boolean  @default(false) // ex.: mês sem pró-labore não tem ESOCIAL/DARF
  alertasEnviados String   @default("[]") // ["D-7","D-3",...] — idempotência do alertador
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([competencia, tipo])
  @@index([dueDate])
  @@index([estado])
}

// CONTABIL S4 — Livro Caixa (art. 26 LC 123: TODA movimentação da ME).
// origem/refId com @@unique garante idempotência das entradas AUTOMÁTICAS
// (AUTO_MP espelha MasterBillingLedgerEntry.id; AUTO_OBRIGACAO espelha
// FiscalObligation.id) — MANUAL usa refId=null (sem colisão: Postgres trata
// NULL como distinto em índice único). Lançamento automático NUNCA é editado
// direto — correção é lançamento de ESTORNO novo (trilha limpa, Guardrail).
model FiscalLedgerEntry {
  id           String    @id @default(cuid())
  data         DateTime
  competencia  String // "2026-07" — derivada de `data` (regime de caixa)
  tipo         String // ENTRADA | SAIDA
  categoria    String // RECEITA_ASSINATURA | DAS | DARF_INSS | PROLABORE | DISTRIBUICAO_LUCRO | INFRA | FERRAMENTA | OUTRO | ESTORNO
  descricao    String
  valorCents   Int // sempre positivo; `tipo` decide o sinal no saldo
  origem       String // AUTO_MP | AUTO_OBRIGACAO | MANUAL
  refId        String? // id do MasterBillingLedgerEntry / da FiscalObligation (null p/ MANUAL)
  motivo       String? // obrigatório em lançamento manual e em estorno
  estornaId    String? // aponta pro id do lançamento que este estorno corrige
  anoFechado   Boolean   @default(false) // true = ano fechado (S4 "fechar Livro Caixa"), edição bloqueada
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([origem, refId])
  @@index([competencia, tipo])
  @@index([data])
}

// CONTABIL S5 — comprovante (recibo PGDAS-D, guia/comprovante DAS, print do e-CAC)
// anexado por obrigação. Segue o padrão de storage em disco da casa
// (SellerOnboardingAttachment): arquivo em `storagePath`, metadados no banco.
// É a "pasta-do-contador digital" — listado no card da obrigação do wizard.
// Sem relation formal p/ FiscalObligation (o schema fiscal usa ids soltos por
// design, como FiscalLedgerEntry.refId) — a FK lógica é `obligationId`.
model FiscalComprovante {
  id               String    @id @default(cuid())
  obligationId     String // id da FiscalObligation à qual o comprovante pertence
  competencia      String // "2026-07" — cópia p/ filtro/relatório (regime do wizard)
  tipo             String // PGDASD | DAS | DARF_INSS | ... (tipo da obrigação, cópia)
  originalFilename String
  storedFilename   String
  storagePath      String
  contentType      String?
  byteSize         Int
  sha256           String
  status           String    @default("permanent") // permanent | deleted
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([obligationId, status])
  @@index([competencia])
}

// CONTABIL S5 — histórico do relatório mensal narrativo (determinístico, gerado
// no fechamento do mês pelo copiloto). 1 por competência (o último fechamento
// sobrescreve — upsert). `texto` é o corpo enviado no zap do dono; `payloadJson`
// guarda o snapshot dos números do fechamento (auditoria: o motor é a fonte).
model FiscalMonthlyReport {
  id            String   @id @default(cuid())
  competencia   String   @unique // "2026-07"
  texto         String // relatório narrativo determinístico (o "pensa comigo" por escrito)
  payloadJson   String? // snapshot dos números do fechamento (receita/tributos/fatorR/...)
  enviadoZap    Boolean  @default(false) // best-effort: true se o disparo no zap confirmou
  geradoViaIa   Boolean  @default(false) // true se a reescrita amigável via Ollama foi aplicada
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([competencia])
}

// CONTABIL S6 — NFS-e Nacional automática. 1 FiscalInvoice por pagamento MP
// aprovado (paymentRefId = MasterBillingLedgerEntry.id, @unique = idempotência).
// tomador = a Company cliente do HBX; valorCents é LÍQUIDO de estorno (mesma
// definição líquida-de-estorno do S1/S4). status: PENDENTE → EMITIDA | ERRO |
// CANCELADA (cancelamento SEMPRE manual pelo portal — nunca automatizado). O
// XML retornado (GZip+Base64) e a chaveAcesso (50 chars) ficam guardados p/
// auditoria; nenhum segredo aqui (o certificado mora no cofre, FiscalProfile).
model FiscalInvoice {
  id           String    @id @default(cuid())
  paymentRefId String    @unique // MasterBillingLedgerEntry.id que originou a nota
  competencia  String // "2026-07" — competência de reconhecimento (regime de caixa)
  companyId    Int // tomador (Company cliente do HBX)
  tomadorNome  String? // razão social/nome do tomador (snapshot p/ o DPS)
  tomadorDoc   String? // CNPJ/CPF do tomador (snapshot; só dígitos)
  valorCents   Int // líquido de estorno (base da NFS-e)
  status       String    @default("PENDENTE") // PENDENTE | EMITIDA | ERRO | CANCELADA
  chaveAcesso  String?   @unique // chave de acesso de 50 chars devolvida pelo Sistema Nacional
  numeroDps    String? // nº da DPS (sequencial do emissor)
  xmlGzB64     String? // XML da NFS-e retornado (GZip+Base64) — auditoria
  erroMsg      String? // última mensagem de erro (sem segredo)
  tentativas   Int       @default(0) // nº de tentativas de emissão (retry backoff, máx 3)
  emitidaEm    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([competencia])
  @@index([status])
}

// CONTABIL S6/S7 — trilha de auditoria de TODA chamada a API externa oficial
// (Lei do Contabil nº4). Modelo COMPARTILHADO: NFS-e (S6) e Serpro (S7) gravam
// aqui. requestResumo NUNCA carrega dado sensível (certificado/senha/credencial
// Serpro ficam só no cofre). resultRef = chave de acesso / nº recibo / protocolo.
// aprovadoPor = "auto-flag" (job automático) ou o userId do dono (ação manual).
model FiscalAutomationLog {
  id            String   @id @default(cuid())
  sistema       String // NFSE | SERPRO
  operacao      String // EMITIR_DPS | DECLARAR_PGDASD | GERAR_DAS | ...
  requestResumo String // resumo SEM dados sensíveis (competência, valor, tomador anon.)
  httpStatus    Int?
  sucesso       Boolean
  resultRef     String? // chave de acesso / nº recibo / protocolo
  aprovadoPor   String? // "auto-flag" | userId do dono
  createdAt     DateTime @default(now())

  @@index([sistema, operacao])
  @@index([createdAt])
}

// CRÉDITOS S1 (docs/PLANEJAMENTOS/CREDITOS/S1-SPEC.md) — fundação da carteira de crédito.
// Sprint 0 fechado 04/07: 1 crédito = 1 lead; saldo em LOTES com expiração FIFO; fail-closed
// nunca negativo; idempotência por usageKey. Migration ADITIVA (só estas 2 tabelas). Atrás de
// flag HBX_CREDITS_ENABLED (default OFF) — nasce inerte, SEM enforcement (isso é S2/S3).
//
// CreditWallet: 1:1 com Company. É a linha-âncora do débito atômico (reusa o padrão do
// hbx-recovery.service.ts: updateMany condicional + retry em vez de SELECT...FOR UPDATE).
model CreditWallet {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // P0.3 HOLD DE CHARGEBACK (decisão do dono 10/07: "bloquear entrega até quitar"). NÃO é saldo
  // negativo — é uma DÍVIDA à parte: quando um estorno/chargeback reverte uma recarga cujos
  // créditos o cliente JÁ consumiu (shortfall do reversePurchase), o valor não-coberto vira
  // dívida aqui e BLOQUEIA novas entregas de lead até ser quitado por crédito novo (recarga paga
  // ou concessão do master → settleChargebackDebtFromBalance). Único estado mutável de dinheiro da
  // carteira (o saldo continua 100% derivado do ledger append-only) — de propósito: o choke de
  // entrega é caminho quente e precisa de uma leitura barata (1 coluna), não de um Σ do ledger a
  // cada lead. O RASTRO append-only vive no ledger (kind='chargeback_debt' / 'chargeback_settlement').
  chargebackDebtCredits Decimal @default(0) @db.Decimal(18, 3)

  entries CreditLedgerEntry[]
}

// CreditLedgerEntry: append-only. Entradas de saldo são LOTES (grant | recharge | promo,
// remaining>0 decrescente); movimentos (debit | refund | expire | adjust) têm remaining=0 e
// só registram o rastro. Saldo = Σ(lotes remaining>0 E não expirados) — fonte ÚNICA derivada
// do ledger (nunca contar CompanyCommercialUsageLog, esse é o modelo antigo a aposentar).
//
// Um débito que cruza 2+ lotes gera 1 linha `debit` POR lote consumido (cada uma com
// parentEntryId apontando pro lote), todas com a MESMA usageKey (idempotência é da AÇÃO
// inteira, não da linha). refund aponta pro débito revertido via parentEntryId.
model CreditLedgerEntry {
  id        String       @id @default(cuid())
  wallet    CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId  String
  companyId Int // denormalizado p/ índice/consulta sem join

  kind String // grant | recharge | promo (LOTES) · debit | refund | expire | adjust | purchase_reversal | chargeback_debt | chargeback_settlement (movimentos)

  amount    Decimal @db.Decimal(18, 3) // sempre positivo; o `kind` dá o sinal semântico
  remaining Decimal @default(0) @db.Decimal(18, 3) // SÓ lotes: começa = amount, cai ao consumir.

  expiresAt  DateTime? // SÓ lotes; null = não expira (concessão manual permanente do master)
  grantType  String? // paid | courtesy_internal | promo (SÓ lotes; alimenta o fiscal no S5)
  actionKey  String? // SÓ débitos: o que consumiu (ex.: lead_delivery)
  usageKey   String? // idempotência (débito/recarga/refund) — MESMA chave em todas as linhas da ação
  sourceRef  String? // id do pagamento MP / id da ação master (rastreio)
  parentEntryId String? // débito -> lote consumido; refund -> débito revertido

  createdByUserId Int?
  metadataJson    String?
  createdAt       DateTime @default(now())

  // Fix B (revisão Opus S1): trava de idempotência de DINHEIRO no banco, não só em código.
  // Linhas de LOTE (grant/recharge/promo) têm parentEntryId=null → no Postgres NULLs não
  // colidem em unique, então lotes NUNCA quebram aqui. Linhas `debit` sempre têm parentEntryId
  // (o lote consumido) → o par (usageKey, lote) vira único: duas ações concorrentes com a MESMA
  // usageKey não conseguem debitar o MESMO lote 2x (a 2ª bate P2002 e é tratada como já-processada).
  @@unique([usageKey, parentEntryId])
  @@index([companyId, kind])
  @@index([walletId, expiresAt])
  @@index([usageKey])
}

// CRÉDITOS S3-PARTE1 (docs/PLANEJAMENTOS/CREDITOS/S3-PARTE1-RESULTADO.md) — overlay editável
// dos PACOTES de recarga de crédito. Espelha EXATAMENTE `PlanModuleConfig`: base em código
// (credit-pack-catalog.ts) + override persistido aqui, recarregado no boot/edição para os
// getters síncronos do catálogo (mesmo padrão de refreshCommercialCatalogOverlay). Migration
// ADITIVA (só esta tabela nova).
model CreditPackConfig {
  packKey      String   @id // starter | growth | scale
  configJson   String   @default("{}") // { credits, price, status, defaultExpiryDays, title, observation }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Config global de crédito (S3-PARTE1): hoje só o prazo default de expiração (D6). Linha
// única (key fixo) em vez de tabela key-value nova — mesmo espírito enxuto do
// MasterGlobalIntegrationConfig, mas escopado a Créditos pra não colidir com billing.
model CreditGlobalConfig {
  key                      String   @id @default("default")
  defaultExpiryDays        Int      @default(90)
  // CRÉDITOS A3 (docs/PLANEJAMENTOS/CREDITOS/A3-RESULTADO.md) — lote grátis de boas-vindas
  // no signup self-service. Config global editável pelo master, mesmo padrão de
  // defaultExpiryDays acima. Migration ADITIVA (2 colunas com DEFAULT, nenhuma existente muda).
  welcomeCredits           Int      @default(30)
  welcomeExpiryDays        Int      @default(30)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Configuração editável do catálogo de ações de crédito. Todas as ações podem
// operar em modo grátis ou débito, com custo decimal definido no Master.
model CreditActionConfig {
  id         Int      @id @default(autoincrement())
  actionKey  String   @unique
  configJson String   @default("{}") // { mode: free|debit, cost: number }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Outbox do e-mail comercial automático. E-mail manual/transacional não passa
// por aqui. Um passo canônico produz no máximo uma mensagem.
model EmailOutboundMessage {
  id                  String   @id @default(cuid())
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId           Int
  lead                VendasLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId               String?
  automationStepRun    AutomationStepRun? @relation(fields: [automationStepRunId], references: [id], onDelete: SetNull)
  automationStepRunId  String?  @unique
  recoveryStepRun      RecoveryAutomationStepRun? @relation(fields: [recoveryStepRunId], references: [id], onDelete: SetNull)
  recoveryStepRunId    String?  @unique
  requestedByUserId    Int?
  recipient            String
  subject              String
  bodyText             String
  sourceModule         String
  purpose              String   @default("commercial_contact")
  idempotencyKey       String
  status               String   @default("pending") // pending | processing | sent | failed | canceled | unknown
  attempts             Int      @default(0)
  nextAttemptAt        DateTime @default(now())
  leaseUntil           DateTime?
  providerMessageId    String?
  sentAt               DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  metadataJson         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  attemptsLog          EmailOutboundAttempt[]

  @@unique([companyId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([companyId, leadId, createdAt])
}

model EmailOutboundAttempt {
  id               String   @id @default(cuid())
  outboundMessage  EmailOutboundMessage @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)
  outboundMessageId String
  status           String   @default("started") // started | sent | failed | unknown
  errorCode        String?
  errorMessage     String?
  providerMessageId String?
  startedAt        DateTime @default(now())
  finishedAt       DateTime?

  @@index([outboundMessageId, startedAt])
}

// CONCIERGE IA (Missão F — docs/PLANEJAMENTOS/RELEASE-20X/IA-CONCIERGE-CONTRATO.md §2.1):
// rascunho da busca guiada por chat. Sobrevive reload (reidratação via GET /concierge),
// TTL 24h (sweeper + lazy expiry), 1 ativo por usuário. `confirmToken` single-use amarrado
// ao hash dos slots (`slotsHash`); `runId` garante idempotência (draft executado devolve
// SEMPRE a mesma busca). Migration ADITIVA (só esta tabela nova).
model AiConciergeDraft {
  id               String    @id @default(cuid())
  companyId        Int
  userId           Int
  state            String    @default("START")
  slotsJson        String    @default("{}")
  transcriptJson   String    @default("[]")
  metaJson         String?
  costPreviewJson  String?
  confirmToken     String?
  confirmExpiresAt DateTime?
  slotsHash        String?
  runId            String?
  status           String    @default("active") // active | executed | expired | abandoned
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, userId, status])
}
