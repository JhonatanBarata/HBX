}

model AlertaImportacao {
  id             Int       @id @default(autoincrement())
  importacao     Importacao @relation(fields: [importacaoId], references: [id])
  importacaoId   Int
  company        Company   @relation(fields: [empresaId], references: [id])
  empresaId      Int
  diasAntes      Int
  enviarEmail    Boolean   @default(false)
  enviarWhatsapp Boolean   @default(false)
  listaEmails    String?
  listaWhatsapp  String?
  disparado      Boolean   @default(false)
  disparadoEm    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId, disparado])
  @@index([importacaoId, diasAntes])
