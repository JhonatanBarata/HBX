datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Role enum removed for broader connector compatibility; store role as string

model Company {
  id                      Int       @id @default(autoincrement())
  name                    String
  entityType              String    @default("PJ") // PF | PJ
  slug                    String?   @unique
  trialModuleSelection    String? // vendas | recovery
  selectedPlanKey         String? // hbx_lite | hbx_padrao | hbx_melhor
  signupUsesPublicEmail   Boolean   @default(false)
  acquisitionSource       String?
  acquisitionSourceDetail String?
  referralReferrerName    String?
  referralCode            String?
  referralDiscountConsumedAt DateTime?
  primaryContactName      String?
  contactEmail            String?
  contactPhone            String?
  taxDocument             String?
  whatsappNumber          String?
  whatsappPhoneNumberId   String?   @unique
  whatsappWabaId          String?
  whatsappAccessToken     String?
  whatsappDisplayNumber   String?
  whatsappStatus          String? // CONNECTED | DISCONNECTED | ERROR
  whatsappStatusError     String?
  whatsappStatusUpdatedAt DateTime?
  whatsappConnectionMode  String    @default("NONE") // NONE | TEMPORARY | OFFICIAL
  whatsappTemporaryStatus String    @default("NOT_CONNECTED") // NOT_CONNECTED | TEMPORARY | ATTENTION
  whatsappTemporaryInstanceKey String?
  whatsappTemporaryProvider String?
  whatsappTemporaryPairingCode String?
  whatsappTemporaryQrCodeData String?
  whatsappTemporaryDisplayNumber String?
  whatsappTemporaryLastSyncAt DateTime?
  whatsappTemporaryConnectedAt DateTime?
  whatsappTemporaryStatusError String?
  whatsappModalStatus      String?
  whatsappModalProvider    String?
  whatsappModalPhone       String?
  whatsappModalConnectedAt DateTime?
  whatsappModalLastError   String?
  whatsappModalUpdatedAt   DateTime?
  whatsappMigrationInterestStatus String @default("NONE") // NONE | REQUESTED | CONTACTED | RESOLVED
  whatsappMigrationInterestAt DateTime?
  whatsappMigrationInterestSource String?
  whatsappMigrationWorkflowStatus String @default("NONE") // NONE | REQUESTED | CONTACTED | RESOLVED
  whatsappMigrationLastContactAt DateTime?
  whatsappMigrationInternalNote String?
  mercadoPagoAccessToken    String?
  mercadoPagoStatus         String? // CONNECTED | DISCONNECTED | ERROR
  mercadoPagoStatusError    String?
  mercadoPagoStatusUpdatedAt DateTime?
  mercadoPagoAccountEmail   String?
  mercadoPagoUserId         String?
  useMasterMercadoPagoToken Boolean   @default(false)
  useMasterWhatsAppToken    Boolean   @default(false)
  masterMercadoPagoCredentialKey String?
  masterWhatsAppCredentialKey    String?
  timezone                String?   @default("America/Sao_Paulo")
  onboardingStatus        String    @default("active_paid") // pending_email_confirmation | active_trial | active_paid | suspended
  isActive                Boolean   @default(true)
  paymentStatus           String    @default("PENDING") // PENDING | TRIAL | PAID | OVERDUE | EXPIRED | DISABLED
  paymentMethod           String    @default("NONE") // NONE | CARD | PIX | BOLETO | MANUAL
  billingCycle           String    @default("MONTHLY") // MONTHLY | ANNUAL
  subscriptionStatus      String    @default("trialing") // trialing | active | past_due | canceled | expired
  billingProvider         String    @default("manual") // manual | mercadopago | stripe | apple | google
  premiumAccess           Boolean   @default(false)
  themePreferenceConfig   String?
  billingCardBrand        String?
  billingCardLast4        String?
  billingCardHolderName   String?
  billingCardExpMonth     Int?
  billingCardExpYear      Int?
  billingCardUpdatedAt    DateTime?
  manualDiscountPercent   Float     @default(0)
  freeMonths              Int       @default(0)
  trialStartsAt           DateTime?
  trialEndsAt             DateTime?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd   DateTime?
  deactivatedAt           DateTime?
  createdAt               DateTime  @default(now())
  products                Product[]
  users                   User[]
  plan                    Plan?     @relation(fields: [planId], references: [id])
  planId                  Int?

  conversations CompanyConversation[]
  messages      CompanyMessage[]
  inboxConversations Conversation[]

  autoReplyRules       AutoReplyRule[]
  inboundMessages      InboundMessage[]
  outboundMessages     OutboundMessage[]
  conversationSessions ConversationSession[]
  orderDrafts          OrderDraft[]
  companyModules       CompanyModule[]
  importacoes          Importacao[]
  importacaoPermissoes ImportacaoPermissao[]
  alertasImportacao    AlertaImportacao[]
  cadastroFornecedores CadastroFornecedor[]
  cadastroPaises       CadastroPais[]
  cadastroPortos       CadastroPorto[]
  cadastroTransitTimes CadastroTransitTime[]
  deletionRecords      DeletionRecord[]
  whatsappAuditLogs    WhatsAppAuditLog[]
  hbxRecoveryCustomers HbxRecoveryCustomer[]
  hbxRecoveryFlowStages HbxRecoveryFlowStage[]
  hbxRecoveryPayments  HbxRecoveryPayment[]
  financeiroCharges    FinanceiroCharge[]
  companySubscriptions CompanySubscription[]
  customerProfiles     CustomerProfile[]
  debtCases            DebtCase[]
  integrationConnections IntegrationConnection[]
  integrationSyncRuns  IntegrationSyncRun[]
  auvoExternalRecords  AuvoExternalRecord[]
  whatsappEndpoints    CompanyWhatsAppEndpoint[]
  techAssistantInteractions TechAssistantInteraction[]
  masterAssumedContextSessions MasterAssumedContextSession[]
  masterSupportAuditLogs MasterSupportAuditLog[]
  atendimentoCustomers AtendimentoCustomer[]
  webscrapingSearchHistories WebscrapingSearchHistory[]
  webscrapingUsageLogs WebscrapingUsageLog[]
  vendasLeads         VendasLead[]
  commercialEntitlements CompanyCommercialEntitlement[]
  commercialUsageLogs CompanyCommercialUsageLog[]
  trialPhoneUsages    TrialPhoneUsage[]
}

model CompanyCommercialEntitlement {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  key                String
  status             String   @default("active") // active | trialing | canceled | unavailable | blocked | paid | manual | pending_checkout
  source             String   @default("system") // trial | checkout | manual | migration | system
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  metadataJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, status])
  @@index([key, status])
}

model CompanyCommercialUsageLog {
  id           String   @id @default(cuid())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    Int
  userId       Int?
  planKey      String?
  eventType    String
  source       String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([companyId, eventType, createdAt])
  @@index([planKey, eventType, createdAt])
}

model TrialPhoneUsage {
  id                 String   @id @default(cuid())
  phoneNormalized    String   @unique
  company            Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId          Int?
  firstTrialStartsAt DateTime?
  firstTrialEndsAt   DateTime?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt
  source             String   @default("qr_pair")
  metadataJson       String?

  @@index([companyId])
}

model CompanyWhatsAppEndpoint {
  id                      String   @id @default(cuid())
  company                 Company  @relation(fields: [companyId], references: [id])
  companyId               Int
  label                   String?
  moduleKey               String?
  whatsappNumber          String?
  whatsappPhoneNumberId   String?  @unique
  whatsappWabaId          String?
  whatsappAccessToken     String?
  whatsappDisplayNumber   String?
  whatsappStatus          String? // CONNECTED | DISCONNECTED | ERROR
  whatsappStatusError     String?
  whatsappStatusUpdatedAt DateTime?
  isActive                Boolean  @default(true)
  isPrimary               Boolean  @default(false)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  outboundMessages        OutboundMessage[]

  @@index([companyId, moduleKey])
  @@index([companyId, isActive, sortOrder])
}

model CommercialPlanProviderMapping {
  id             String   @id @default(cuid())
  planKey        String
  billingCycle   String
  provider       String   @default("mercadopago")
  providerPlanId String
  amount         Float
  currency       String   @default("BRL")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([planKey, billingCycle, provider])
  @@index([provider, providerPlanId])
  @@index([active, provider])
}

model CompanySubscription {
  id                        String   @id @default(cuid())
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId                 Int
  provider                  String   @default("mercadopago")
  providerPreapprovalId     String?  @unique
  providerPreapprovalPlanId String?
  planKey                   String
  billingCycle              String
  status                    String   @default("pending") // pending | authorized | active | paused | canceled | past_due | blocked
  payerEmail                String?
  billingContactPhone       String?
  cardBrand                 String?
  cardLast4                 String?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  nextBillingAt             DateTime?
  cancelAtPeriodEnd         Boolean  @default(false)
  canceledAt                DateTime?
  lastProviderStatus        String?
  providerPayloadJson       String?
  createdByUserId           Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([companyId, status])
  @@index([provider, providerPreapprovalPlanId])
  @@index([provider, status])
}

model HbxRecoveryCustomer {
  id                  String   @id @default(cuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           Int
  customerProfile     CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  customerProfileId   String?
  name                String
  clientName          String?
  whatsappNumber      String
  openAmount          Float    @default(0)
  workdaySaleDay      Int
  recurringDelays     Int      @default(0)
  paymentHistoryScore Int      @default(5)
  totalPaid           Float    @default(0)
  averageDelay        Float    @default(0)
  automationEnabled   Boolean  @default(true)
  lastContact         String?
  status              String   @default("OVERDUE") // OVERDUE | PAID
  paymentHistory      String? // JSON serialized
  delayHistory        String? // JSON serialized
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  payments            HbxRecoveryPayment[]

  @@index([companyId, status])
  @@index([companyId, openAmount])
  @@index([customerProfileId])
}

model HbxRecoveryPayment {
  id                     String   @id @default(cuid())
  company                Company  @relation(fields: [companyId], references: [id])
  companyId              Int
  customer               HbxRecoveryCustomer @relation(fields: [customerId], references: [id])
  customerId             String
  debtCase               DebtCase? @relation(fields: [debtCaseId], references: [id])
  debtCaseId             String?
  conversationId         Int?
  amount                 Float
  currency               String   @default("BRL")
  description            String
  chargeType             String   @default("avista") // avista | parcelado
  installmentCount       Int      @default(1)
  installmentValue       Float?
  serviceDate            DateTime?
  serviceDescription     String?
  status                 String   @default("pending") // pending | approved | released | cancelled | failed | refunded | partially_refunded
  lifecycle              String   @default("in_progress") // paid | in_progress | finalized | cancelled
  paymentUrl             String?
  linkExpiresAt          DateTime?
  externalReference      String?
  mpPreferenceId         String?
  mpPaymentId            String?  @unique
  mpMerchantOrderId      String?
  notificationUrl        String?
  paidAt                 DateTime?
  refundedAt             DateTime?
  refundAmount           Float    @default(0)
  appliedToCustomerAmount Float   @default(0)
  reversedAmount         Float    @default(0)
  providerPayload        String?
  createdByUserId        Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, lifecycle, createdAt])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, conversationId, createdAt])
  @@index([debtCaseId, createdAt])
  @@index([externalReference])
}

model FinanceiroCharge {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         Int
  amount            Float
  currency          String   @default("BRL")
  description       String
  billingCycle      String   @default("MONTHLY") // MONTHLY | ANNUAL
  paymentMethod     String   @default("PIX") // PIX | CARD | BOLETO | BONUS
  status            String   @default("pending") // pending | approved | cancelled | failed | refunded | partially_refunded
  lifecycle         String   @default("in_progress") // in_progress | paid | cancelled | finalized
  competence        String?
  externalReference String?  @unique
  mpPreferenceId    String?
  mpPaymentId       String?  @unique
  mpMerchantOrderId String?
  notificationUrl   String?
  paymentUrl        String?
  pixQrCode         String?
  pixQrCodeBase64   String?
  pixTicketUrl      String?
  ledgerEntryId     String?
  paidAt            DateTime?
  refundedAt        DateTime?
  refundAmount      Float    @default(0)
  providerPayload   String?
  lastWebhookAt     DateTime?
  lastWebhookPayload String?
  createdByUserId   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, lifecycle, createdAt])
  @@index([companyId, status, createdAt])
}

model HbxRecoveryFlowStage {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  title     String
  channel   String   @default("WhatsApp API")
  template  String
  daysAfter Int      @default(0)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, sortOrder])
  @@index([companyId, enabled])
}

model CompanyConversation {
  id            Int      @id @default(autoincrement())
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     Int
  channel       String   @default("whatsapp")
  contact       String
  currentFlow   String   @default("cobranca_recovery")
  currentStep   String   @default("novo")
  flowResult    String?
  botActive     Boolean  @default(true)
  humanAssigned Boolean  @default(false)
  assignedUserId Int?
  metadata      String?
  lastInteractionAt DateTime @default(now())
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages CompanyMessage[]

  @@unique([companyId, channel, contact])
  @@index([companyId, lastMessageAt])
  @@index([companyId, botActive, humanAssigned, lastInteractionAt])
  @@map("Conversation")
}

model CompanyMessage {
  id             Int                 @id @default(autoincrement())
  company        Company             @relation(fields: [companyId], references: [id])
  companyId      Int
  conversation   CompanyConversation @relation(fields: [conversationId], references: [id])
  conversationId Int

  contactId   String?
  direction String // INBOUND | OUTBOUND
  messageType String   @default("text") // text | template
  body      String
  senderType String @default("system") // bot | human | client | system
  isComplaint Boolean @default(false)
  variablesJson String?
  status    String   @default("RECEIVED") // RECEIVED | QUEUED | SENDING | SENT | DELIVERED | READ | FAILED
  error     String?
  timestamp DateTime @default(now())
  sourceModule String?

  provider          String? @default("WHATSAPP_CLOUD")
  providerMessageId String? @unique
  rawPayload        String?

  outboundMessageId Int?             @unique
  outboundMessage   OutboundMessage? @relation("OutboundMessageMessage", fields: [outboundMessageId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, conversationId, timestamp])
  @@index([conversationId, senderType, timestamp])
  @@map("Message")
}

model Customer {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model AtendimentoCustomer {
  id                  String   @id @default(cuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           Int
  customerProfile     CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  customerProfileId   String?
  name                String?
  phone               String
  phoneNormalized     String
  registrationOrigin  String   @default("whatsapp_bot") // whatsapp_bot | manual | recovery_to_atendimento
  registrationStatus  String   @default("pending_confirmation") // pending_confirmation | confirmed | manual
  route               String   @default("atendimento") // atendimento | recovery
  notes               String?
  lastMessageAt       DateTime?
  conversationId      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, phoneNormalized])
  @@index([companyId, registrationStatus])
  @@index([companyId, registrationOrigin])
  @@index([companyId, updatedAt])
  @@index([customerProfileId])
}

model CustomerProfile {
  id                   String   @id @default(cuid())
  company              Company  @relation(fields: [companyId], references: [id])
  companyId            Int
  sourceConnection     IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId   String?
  name                 String?
  profileName          String?
  nameSource           String?
  nameConfirmed        Boolean  @default(false)
  phone                String?
  phoneNormalized      String?
  email                String?
  document             String?
  externalSource       String?
  externalCustomerId   String?
  status               String   @default("active")
  notes                String?
  firstInboundAt       DateTime?
  lastInboundAt        DateTime?
  botOff               Boolean  @default(false)
  botOffReason         String?
  botOffAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  atendimentoCustomers AtendimentoCustomer[]
  hbxRecoveryCustomers HbxRecoveryCustomer[]
  debtCases            DebtCase[]
  vendasLeads          VendasLead[]

  @@unique([companyId, phoneNormalized])
  @@index([companyId, document])
  @@index([sourceConnectionId, externalCustomerId])
  @@index([companyId, status])
}

model DebtCase {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id])
  companyId          Int
  customerProfile    CustomerProfile @relation(fields: [customerProfileId], references: [id])
  customerProfileId  String
  sourceConnection   IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId String?
  sourceProvider     String
  externalDebtId     String?
  amount             Float    @default(0)
  dueDate            DateTime?
  paidAt             DateTime?
  status             String   @default("open")
  rawPayloadJson     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  payments           HbxRecoveryPayment[]

  @@index([companyId, customerProfileId])
  @@index([companyId, status])
  @@index([sourceConnectionId, externalDebtId])
}

model IntegrationConnection {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id])
  companyId          Int
  provider           String
  instanceName       String
  secretCiphertext   String?
  secretPreview      String?
  status             String   @default("DISCONNECTED")
  lastTestedAt       DateTime?
  lastTestStatus     String?
  lastTestMessage    String?
  lastSyncAt         DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customerProfiles   CustomerProfile[]
  debtCases          DebtCase[]
  syncRuns           IntegrationSyncRun[]
  auvoExternalRecords AuvoExternalRecord[]

  @@index([companyId, provider, isActive])
  @@index([companyId, status, lastSyncAt])
}

model IntegrationSyncRun {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         Int
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id])
  connectionId      String
  provider          String?
  type              String
  triggerType       String?
  triggeredByUserId Int?
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  status            String   @default("RUNNING")
  importedCount     Int      @default(0)
  updatedCount      Int      @default(0)
  skippedCount      Int      @default(0)
  errorCount        Int      @default(0)
  failedCount       Int      @default(0)
  checkpoint        String?
  errorLog          String?
  errorSummary      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, status, startedAt])
  @@index([connectionId, startedAt])
}

model AuvoExternalRecord {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id])
  companyId          Int
  connection         IntegrationConnection @relation(fields: [connectionId], references: [id])
  connectionId       String
  externalId         String
  title              String?
  status             String?
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  technicianName     String?
  customerName       String?
  sourceUpdatedAt    DateTime?
  rawPayloadJson     String?
  rawPayloadSummaryJson String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, externalId])
  @@index([connectionId, sourceUpdatedAt])
  @@index([companyId, status])
}

model Conversation {
  id         String   @id @default(uuid())
  companyId  Int?
  customerId String
  status     String   @default("new") // new | open | closed
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company?             @relation(fields: [companyId], references: [id])
  customer Customer             @relation(fields: [customerId], references: [id])
  messages Message[]
  surveys  SatisfactionSurvey[]

  @@index([companyId, status, updatedAt])
  @@index([customerId, status, updatedAt])
  @@map("InboxConversation")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  direction      String // inbound | outbound
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("InboxMessage")
}

model ConversationSession {
  id            Int      @id @default(autoincrement())
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     Int
  channel       String   @default("whatsapp")
  from          String
  state         String   @default("NEW")
  context       String? // simple JSON context (serialized)
  lastMessageAt DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderDraft OrderDraft?

  @@index([companyId, from, channel])
  @@index([expiresAt])
}

model OrderDraft {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  session   ConversationSession @relation(fields: [sessionId], references: [id])
  sessionId Int                 @unique

  status String  @default("DRAFT") // DRAFT | ABANDONED
  items  String? // JSON serialized (ex: { rawText: "..." })

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model User {
  id              Int              @id @default(autoincrement())
  username        String?          @unique
  email           String?          @unique
  emailConfirmedAt DateTime?
  emailConfirmationToken String?   @unique
  emailConfirmationSentAt DateTime?
  emailConfirmationExpiresAt DateTime?
  password        String
  name            String?
  company         Company?         @relation(fields: [companyId], references: [id])
  companyId       Int?
  role            String           @default("USER")
  isSystemMaster  Boolean          @default(false)
  isActive        Boolean          @default(true)
  currentSession  AuthSession?     @relation("CurrentUserSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  currentSessionId String?         @unique
  sessionVersion  Int              @default(0)
  themePreferenceConfig String?
  deactivatedAt   DateTime?
  retentionUntil  DateTime?
  createdAt       DateTime         @default(now())
  authSessions    AuthSession[]    @relation("UserAuthSessions")
  productVersions ProductVersion[]
  passwordResets  PasswordReset[]
  moduleAccesses  UserModuleAccess[]
  importacoesCriadas     Importacao[]    @relation("ImportacaoCriadaPor")
  importacoesFinalizadas Importacao[]    @relation("ImportacaoFinalizadaPor")
  importacoesReabertas   Importacao[]    @relation("ImportacaoReabertaPor")
  deletionRecords        DeletionRecord[]
  techAssistantInteractions TechAssistantInteraction[]
  masterContextSessions MasterAssumedContextSession[] @relation("MasterAssumedContextUser")
  masterContextEndedSessions MasterAssumedContextSession[] @relation("MasterAssumedContextEndedByUser")
  masterSupportAuditLogs MasterSupportAuditLog[] @relation("MasterSupportAuditLogUser")
  webscrapingSearchHistories WebscrapingSearchHistory[]
  webscrapingUsageLogs WebscrapingUsageLog[]
}

model AuthSession {
  id             String    @id @default(cuid())
  user           User      @relation("UserAuthSessions", fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  userAgent      String?
  ipHash         String?
  currentForUser User?     @relation("CurrentUserSession")

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model WebscrapingSearchHistory {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id])
  companyId       Int
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  city            String
  segment         String
  quantity        Int
  filtersJson     String
  searchSignature String
  resultCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastUsedAt      DateTime @default(now())
  places          WebscrapingSearchPlace[]

  @@unique([companyId, searchSignature])
  @@index([companyId, lastUsedAt])
  @@index([companyId, createdAt])
  @@index([userId, lastUsedAt])
}

model WebscrapingSearchPlace {
  id               String   @id @default(cuid())
  searchHistory    WebscrapingSearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  searchHistoryId  String
  placeId          String
  rank             Int
  name             String
  phone            String
  phoneDigits      String
  rating           Float?
  reviews          Int      @default(0)
  address          String
  website          String
  source           String?
  score            Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([searchHistoryId, placeId])
  @@index([searchHistoryId, rank])
  @@index([searchHistoryId, phoneDigits])
}

model WebscrapingGlobalCacheEntry {
  id              String   @id @default(cuid())
  cacheSignature  String   @unique
  normalizedCity  String
  normalizedSegment String
  filtersJson     String
  resultCount     Int      @default(0)
  cacheValidUntil DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastFetchedAt   DateTime @default(now())
  lastServedAt    DateTime @default(now())
  places          WebscrapingGlobalCachePlace[]

  @@index([normalizedCity, normalizedSegment, cacheValidUntil])
  @@index([lastServedAt])
}

model WebscrapingGlobalCachePlace {
  id               String   @id @default(cuid())
  cacheEntry       WebscrapingGlobalCacheEntry @relation(fields: [cacheEntryId], references: [id], onDelete: Cascade)
  cacheEntryId     String
  placeId          String
  rank             Int
  name             String
  phone            String
  phoneDigits      String
  rating           Float?
  reviews          Int      @default(0)
  address          String
  website          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cacheEntryId, placeId])
  @@index([cacheEntryId, rank])
  @@index([cacheEntryId, phoneDigits])
}

model WebscrapingUsageLog {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id])
  companyId       Int
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  eventType       String   @default("EXECUTED") // EXECUTED | BLOCKED_DAILY_LIMIT
  source          String? // history | google | hybrid | global_cache
  city            String?
  segment         String?
  quantity        Int?
  resultCount     Int      @default(0)
  reusedCount     Int      @default(0)
  fetchedCount    Int      @default(0)
  technicalCacheUsed Boolean @default(false)
  technicalCacheReusedCount Int @default(0)
  searchSignature String?
  message         String?
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, eventType, createdAt])
  @@index([userId, createdAt])
}

model VendasLead {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         Int
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  customerProfileId String?
  sourceType        String   @default("manual") // manual | webscraping
  primarySource     String   @default("manual")
  sourceHistoryId   String?
  sourceSignature   String?
  timesSeen         Int      @default(1)
  name              String?
  phone             String?
  phoneNormalized   String?
  email             String?
  address           String?
  website           String?
  rating            Float?
  reviews           Int      @default(0)
  city              String?
  segment           String?
  status            String   @default("novo") // novo | contato | retorno | qualificado | encerrado
  nextAction        String?
  returnAt          DateTime?
  shortNote         String?
  lastContactAt     DateTime?
  attemptCount      Int      @default(0)
  lastResult        String?
  wasClosedBefore   Boolean  @default(false)
  closedAt          DateTime?
  createdByUserId   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  timelineEvents    VendasLeadTimelineEvent[]

  @@unique([companyId, phoneNormalized])
  @@index([companyId, status, returnAt])
  @@index([companyId, updatedAt])
  @@index([customerProfileId])
}

model VendasLeadTimelineEvent {
  id              String     @id @default(cuid())
  lead            VendasLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  eventType       String
  title           String
  description     String?
  sourceType      String?
  statusFrom      String?
  statusTo        String?
  resultLabel     String?
  returnAt        DateTime?
  createdByUserId Int?
  createdAt       DateTime   @default(now())

  @@index([leadId, createdAt])
}

model TechAssistantInteraction {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            Int
  company           Company? @relation(fields: [companyId], references: [id])
  companyId         Int?
  mode              String
  operationMode     String?
  analysisType      String?
  title             String?
  route             String?
  module            String?
  environment       String?
  expectedBehavior  String?
  currentBehavior   String?
  maskedInput       String
  responseJson      String
  providerLabel     String?
  providerStatus    String?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([mode, createdAt])
  @@index([operationMode, createdAt])
  @@index([module, createdAt])
}

model MasterAssumedContextSession {
  id            String    @id
  masterUser    User      @relation("MasterAssumedContextUser", fields: [masterUserId], references: [id])
  masterUserId  Int
  company       Company   @relation(fields: [companyId], references: [id])
  companyId     Int
  reason        String?
  startedAt     DateTime  @default(now())
  expiresAt     DateTime?
  endedAt       DateTime?
  endedByUser   User?     @relation("MasterAssumedContextEndedByUser", fields: [endedByUserId], references: [id])
  endedByUserId Int?
  auditLogs     MasterSupportAuditLog[]

  @@index([masterUserId, startedAt])
  @@index([companyId, startedAt])
  @@index([masterUserId, endedAt])
}

model MasterSupportAuditLog {
  id                      String   @id
  masterUser              User     @relation("MasterSupportAuditLogUser", fields: [masterUserId], references: [id])
  masterUserId            Int
  company                 Company? @relation(fields: [companyId], references: [id])
  companyId               Int?
  assumedContextSession   MasterAssumedContextSession? @relation(fields: [assumedContextSessionId], references: [id])
  assumedContextSessionId String?
  scope                   String
  action                  String
  severity                String   @default("INFO")
  route                   String?
  metadata                String?
  createdAt               DateTime @default(now())

  @@index([masterUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([scope, action, createdAt])
}

model MasterGlobalIntegrationConfig {
  key                      String   @id
  mercadoPagoAccessToken   String?
  whatsappAccessToken      String?
  whatsappPhoneNumberId    String?
  whatsappWabaId           String?
  whatsappNumber           String?
  whatsappDisplayNumber    String?
  mercadoPagoLibrary       String?
  whatsappLibrary          String?
  annualPlanDiscountPercent Float   @default(0)
  extraSeatMonthlyAmount   Float    @default(0)
  referralDiscountActive   Boolean  @default(false)
  referralDiscountPercent  Float    @default(0)
  referralDiscountMode     String   @default("ONCE") // ONCE | RECURRING
  themePreferenceConfig    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SystemModule {
  id             Int                @id @default(autoincrement())
  key            String             @unique
  name           String
  description    String?
  monthlyPrice   Float              @default(0)
  serviceUrl     String?
  defaultEnabled Boolean            @default(false)
  companyAssignable Boolean         @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  companyModules CompanyModule[]
  userAccesses   UserModuleAccess[]
}

model CompanyModule {
  id             Int          @id @default(autoincrement())
  company        Company      @relation(fields: [companyId], references: [id])
  companyId      Int
  systemModule   SystemModule @relation(fields: [moduleId], references: [id])
  moduleId       Int
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId, enabled])
}

model UserModuleAccess {
  id           Int          @id @default(autoincrement())
  user         User         @relation(fields: [userId], references: [id])
  userId       Int
  systemModule SystemModule @relation(fields: [moduleId], references: [id])
  moduleId     Int
  allowed      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, moduleId])
  @@index([userId, allowed])
}

model DeletionRecord {
  id                     Int      @id @default(autoincrement())
  moduleKey              String
  entityType             String
  entityId               String
  company                Company? @relation(fields: [companyId], references: [id])
  companyId              Int?
  motivo                 String?
  snapshot               String?
  deletedBy              User?    @relation(fields: [deletedByUserId], references: [id])
  deletedByUserId        Int?
  deletedAt              DateTime @default(now())
  permanentlyDeletedById Int?
  permanentlyDeletedAt   DateTime?

  @@index([moduleKey, deletedAt])
  @@index([companyId, deletedAt])
  @@index([entityType, entityId])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int              @default(0)
  company     Company?         @relation(fields: [companyId], references: [id])
  companyId   Int?
  category    Category?        @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    ProductVersion[]
}

model AutoReplyRule {
  id              Int                 @id @default(autoincrement())
  company         Company             @relation(fields: [companyId], references: [id])
  companyId       Int
  enabled         Boolean             @default(true)
  priority        Int                 @default(0)
  // SQLite doesn't support Prisma enums; store match type as string: EXACT | CONTAINS
  matchType       String              @default("EXACT")
  pattern         String
  caseInsensitive Boolean             @default(true)
  responses       AutoReplyResponse[]
  createdAt       DateTime            @default(now())
}

model AutoReplyResponse {
  id           Int           @id @default(autoincrement())
  rule         AutoReplyRule @relation(fields: [ruleId], references: [id])
  ruleId       Int
  order        Int
  delaySeconds Int           @default(0)
  template     String
}

model InboundMessage {
  id         Int      @id @default(autoincrement())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  Int
  from       String
  body       String
  receivedAt DateTime @default(now())
}

model OutboundMessage {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
  whatsappEndpoint   CompanyWhatsAppEndpoint? @relation(fields: [whatsappEndpointId], references: [id])
  whatsappEndpointId String?
  contactId String?
  to        String
  messageType String @default("text") // text | template
  templateName String?
  templateLanguage String?
  templateComponents String?
  sourceModule String?
  body      String
  // SQLite doesn't support Prisma enums; store status as string: PENDING | SENDING | SENT | FAILED
  status    String  @default("PENDING")

  // WhatsApp Cloud API correlation
  provider           String?   @default("WHATSAPP_CLOUD")
  providerMessageId  String?   @unique
  deliveryStatus     String? // sent | delivered | read | failed
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  lastWebhookAt      DateTime?
  lastWebhookPayload String?

  attemptCount  Int               @default(0)
  maxAttempts   Int               @default(3)
  nextAttemptAt DateTime          @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())
  attempts      OutboundAttempt[]

  message CompanyMessage? @relation("OutboundMessageMessage")

  @@index([companyId, whatsappEndpointId, nextAttemptAt])
}

model OutboundAttempt {
  id           Int             @id @default(autoincrement())
  message      OutboundMessage @relation(fields: [messageId], references: [id])
  messageId    Int
  attemptNo    Int
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  success      Boolean         @default(false)
  httpStatus   Int?
  requestBody  String?
  responseBody String?
  error        String?
}

model WhatsAppWebhookEvent {
  id                Int      @id @default(autoincrement())
  receivedAt        DateTime @default(now())
  kind              String // verify | messages | statuses | unknown
  companyId         Int?
  providerMessageId String?
  payload           String
}

model WhatsAppAuditLog {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  scope     String
  event     String
  level     String   @default("INFO")
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, scope, event])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Plan {
  id        Int       @id @default(autoincrement())
  name      String
  price     Float     @default(0)
  features  Feature[] @relation("PlanFeatures")
  companies Company[]
  createdAt DateTime  @default(now())
}

model Feature {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?
  plans       Plan[]  @relation("PlanFeatures")
}

model ProductVersion {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  data      String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
  version   Int
  createdAt DateTime @default(now())
}

model SatisfactionSurvey {
  id             String   @id @default(uuid())
  conversationId String
  rating         Int?
  feedback       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Importacao {
  id             Int      @id @default(autoincrement())
  company        Company  @relation(fields: [empresaId], references: [id])
  empresaId      Int
  numeroPedido   String
  fornecedorId   String?
  pais           String?
  portoOrigem    String?
  portoDestino   String?
  dataEmbarque   DateTime?
  dataAtracacao  DateTime?
  valorUsd       Float?
  valorDolar     Float?
  pesoKg         Float?
  valorTotalReal Float?
  status         String   @default("EM_CADASTRO")
  pdfPath        String?
  createdAt      DateTime @default(now())
  createdBy      Int?
  finalizedAt    DateTime?
  finalizedBy    Int?
  reabertoPor    Int?
  updatedAt      DateTime @updatedAt
  versao         Int      @default(1)

  criador    User? @relation("ImportacaoCriadaPor", fields: [createdBy], references: [id])
  finalizador User? @relation("ImportacaoFinalizadaPor", fields: [finalizedBy], references: [id])
  reabertura  User? @relation("ImportacaoReabertaPor", fields: [reabertoPor], references: [id])

  logs    ImportacaoLog[]
  alertas AlertaImportacao[]

  @@index([empresaId, status])
  @@index([empresaId, numeroPedido])
}

model ImportacaoLog {
  id          Int       @id @default(autoincrement())
  importacao  Importacao @relation(fields: [importacaoId], references: [id])
  importacaoId Int
  alteracao   String
  usuario     String
  data        DateTime  @default(now())
  versao      Int?
  dadosAntes  String?
  dadosDepois String?

  @@index([importacaoId, data])
}

model AlertaImportacao {
  id             Int       @id @default(autoincrement())
  importacao     Importacao @relation(fields: [importacaoId], references: [id])
  importacaoId   Int
  company        Company   @relation(fields: [empresaId], references: [id])
  empresaId      Int
  diasAntes      Int
  enviarEmail    Boolean   @default(false)
  enviarWhatsapp Boolean   @default(false)
  listaEmails    String?
  listaWhatsapp  String?
  disparado      Boolean   @default(false)
  disparadoEm    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId, disparado])
  @@index([importacaoId, diasAntes])
}

model ImportacaoPermissao {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  role      String
  acao      String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, role, acao])
  @@index([empresaId, role])
}

model CadastroFornecedor {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  paisId    Int?
  portoOrigemId Int?
  portoDestinoId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pais         CadastroPais?  @relation("FornecedorPais", fields: [paisId], references: [id])
  portoOrigem  CadastroPorto? @relation("FornecedorPortoOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto? @relation("FornecedorPortoDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroPais {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portos CadastroPorto[]
  fornecedores CadastroFornecedor[] @relation("FornecedorPais")

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model CadastroPorto {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  paisId    Int?
  pais      CadastroPais? @relation(fields: [paisId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitTimesOrigem  CadastroTransitTime[] @relation("TransitTimeOrigem")
  transitTimesDestino CadastroTransitTime[] @relation("TransitTimeDestino")
  fornecedoresOrigem  CadastroFornecedor[] @relation("FornecedorPortoOrigem")
  fornecedoresDestino CadastroFornecedor[] @relation("FornecedorPortoDestino")

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroTransitTime {
  id             Int      @id @default(autoincrement())
  company        Company  @relation(fields: [empresaId], references: [id])
  empresaId      Int
  portoOrigemId  Int
  portoDestinoId Int
  dias           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portoOrigem  CadastroPorto @relation("TransitTimeOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto @relation("TransitTimeDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, portoOrigemId, portoDestinoId])
  @@index([empresaId])
}
