// SPRINT 4 MOTOR-RFB-FILA (02/07): fila de missões REAL substituindo o controle por loops da fábrica.
// Lease com TTL + heartbeat (lease vencido volta pra fila sozinho), retry com backoff (nextAttemptAt),
// dead-letter (status 'dead'). O nó LOCAL PUXA missão por HTTP (pull; ver /modules/owner/missions).
// `correlationId` = chave de agrupamento do estágio (ex.: campaignId no estágio 'alvo').
model RadarMission {
  id             String    @id @default(cuid())
  stage          String    // alvo | receita | base_rica | cerebro | validacao_zap | card
  status         String    @default("queued") // queued | leased | completed | dead | canceled
  priority       Int       @default(0)
  payloadVersion Int       @default(1)
  payloadJson    Json
  dedupeKey      String?
  correlationId  String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextAttemptAt  DateTime  @default(now())
  leaseId        String?
  leasedBy       String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  lastError      String?
  resultJson     Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([stage, dedupeKey])
  @@index([stage, status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([correlationId, status])
}

// SPRINT 4 MOTOR-RFB-FILA (02/07): plano de cobertura durável por combo (evolui o freio combo-morto,
// que era permanente). `exhausted` REABRE sozinho no nextRevisitAt (default 90d) — cidade esgotada
// nunca volta antes disso, mas também não morre pra sempre.
model RadarCoverage {
  id             String    @id @default(cuid())
  state          String
  city           String
  segment        String
  targetType     String    @default("pj")
  status         String    @default("fresh") // fresh | partial | exhausted
  attempts       Int       @default(0)
  approvedTotal  Int       @default(0)
  duplicateTotal Int       @default(0)
  lastResultAt   DateTime?
  nextRevisitAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([state, city, segment, targetType])
  @@index([status, nextRevisitAt])
}

// FÁBRICA DE ENRIQUECIMENTO (F2, 02/07 — docs/PLANEJAMENTOS/ARVORE-MESTRA lane FÁBRICA). Estado
// durável de uma corrida da fábrica: ela LÊ a lista RFB local (CnpjPublicCompany) e enriquece TUDO
// (tel/email/insta/fb/site/sócio) atrás da fila `enrich_lead`. Linha única (key='main').
// `budget` = quantos leads processar nesta corrida; para SOZINHA ao atingir. `stopRequested` = PARE
// AGORA (congela com segurança). É crash-safe/idempotente: sobrevive a restart e o start retoma sem
// duplicar (lead materializado por placeId `cnpj_public:<cnpj>` único; missão idempotente por dedupeKey).
// NÃO substitui o PARAR TUDO global (RadarFactoryCursor.enabled) — a fábrica RESPEITA os dois freios.
model RadarFabricaRun {
  id             String    @id @default(cuid())
  key            String    @unique @default("main")
  running        Boolean   @default(false)
  stopRequested  Boolean   @default(false)
  budget         Int       @default(0) // alvo desta corrida (leads a enriquecer)
  processed      Int       @default(0) // já enriquecidos nesta corrida
  materialized   Int       @default(0) // leads criados a partir da RFB nesta corrida
  contactsWritten Int      @default(0) // linhas LeadContact gravadas (grátis) nesta corrida
  paidAttempts   Int       @default(0) // DEVE ficar 0 no local (prova de R$0)
  lastLeadId     String?
  lastError      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

