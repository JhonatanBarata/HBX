// COCKPIT-MASTER Sprint 1: trilha ÚNICA de eventos do dono. Toda ocorrência que o
// MASTER precisa ver vira UM evento tipado e consultável aqui (write-through — as
// trilhas antigas MasterPaymentNotificationLog/MasterNotice/MasterSupportAuditLog
// continuam intactas). Tabela criada em runtime pelo ensureMasterEventTable
// (prisma.service.ts); shouldBecomeMigration=true. FK em Company com SET NULL de
// propósito: o histórico do dono sobrevive à exclusão da empresa.
model MasterEvent {
  id          String   @id @default(uuid())
  type        String   // ex.: sale.closed | implantacao.sold | fullplan.requested | bot.config_missing | master_context.assumed
