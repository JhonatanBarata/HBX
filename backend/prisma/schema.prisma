  conversationId String
  rating         Int?
  feedback       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Importacao {
  id             Int      @id @default(autoincrement())
  company        Company  @relation(fields: [empresaId], references: [id])
  empresaId      Int
  numeroPedido   String
  fornecedorId   String?
  pais           String?
  portoOrigem    String?
  portoDestino   String?
  dataEmbarque   DateTime?
  dataAtracacao  DateTime?
  valorUsd       Float?
  valorDolar     Float?
  pesoKg         Float?
  valorTotalReal Float?
  status         String   @default("EM_CADASTRO")
  pdfPath        String?
  createdAt      DateTime @default(now())
  createdBy      Int?
  finalizedAt    DateTime?
  finalizedBy    Int?
  reabertoPor    Int?
  updatedAt      DateTime @updatedAt
  versao         Int      @default(1)

  criador    User? @relation("ImportacaoCriadaPor", fields: [createdBy], references: [id])
  finalizador User? @relation("ImportacaoFinalizadaPor", fields: [finalizedBy], references: [id])
  reabertura  User? @relation("ImportacaoReabertaPor", fields: [reabertoPor], references: [id])

  logs    ImportacaoLog[]
  alertas AlertaImportacao[]

  @@index([empresaId, status])
  @@index([empresaId, numeroPedido])
}

model ImportacaoLog {
  id          Int       @id @default(autoincrement())
  importacao  Importacao @relation(fields: [importacaoId], references: [id])
  importacaoId Int
  alteracao   String
  usuario     String
  data        DateTime  @default(now())
  versao      Int?
  dadosAntes  String?
  dadosDepois String?

