  // NÚCLEO-CRM R2 (05/07) — LINK da cobrança à espinha (mata dívidas 2/3/4 do
  // PLANO-ROBUSTEZ). Colunas ADITIVAS/opcionais: charge legada (assinatura HBX,
  // recovery) segue com todas null — nada muda. Só a cobrança nascida na Logística
  // preenche. Com isso dá pra fazer extrato por cliente, fechar-mês e recovery.
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  customerProfileId String?
  dueDate           DateTime?
  sourceModule      String?  // "logistica_entrega" | "logistica_fechamento" | null
  entregaId         String?  // idempotência da cobrança por entrega (avulso/na_hora/pendura)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  recoveryDebtItem RecoveryDebtItem?

  @@index([companyId, createdAt])
  @@index([companyId, lifecycle, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, customerProfileId])
  @@index([companyId, dueDate, status])
  // NÚCLEO-CRM R3 (05/07) — 1 cobrança POR entrega (mata a corrida do R2). O UNIQUE
  // é PARCIAL (WHERE entregaId IS NOT NULL), o que o Prisma 5.x NÃO expressa no DSL,
  // então vive em raw SQL na migration 20260705070000_integridade_espinha (mesmo
  // padrão do IntegrationSyncRun_connectionId_running_key). Aqui fica só o @@index
  // de consulta; o índice único parcial ("FinanceiroCharge_entregaId_key") está no SQL.
  @@index([companyId, entregaId])
