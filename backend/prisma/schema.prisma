model ImportacaoPermissao {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  role      String
  acao      String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

