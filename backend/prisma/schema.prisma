model CadastroFornecedor {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  paisId    Int?
  portoOrigemId Int?
  portoDestinoId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pais         CadastroPais?  @relation("FornecedorPais", fields: [paisId], references: [id])
  portoOrigem  CadastroPorto? @relation("FornecedorPortoOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto? @relation("FornecedorPortoDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroPais {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portos CadastroPorto[]
  fornecedores CadastroFornecedor[] @relation("FornecedorPais")

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model CadastroPorto {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [empresaId], references: [id])
  empresaId Int
  nome      String
  paisId    Int?
  pais      CadastroPais? @relation(fields: [paisId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitTimesOrigem  CadastroTransitTime[] @relation("TransitTimeOrigem")
  transitTimesDestino CadastroTransitTime[] @relation("TransitTimeDestino")
  fornecedoresOrigem  CadastroFornecedor[] @relation("FornecedorPortoOrigem")
  fornecedoresDestino CadastroFornecedor[] @relation("FornecedorPortoDestino")

  @@unique([empresaId, nome])
  @@index([empresaId, paisId])
}

model CadastroTransitTime {
  id             Int      @id @default(autoincrement())
  company        Company  @relation(fields: [empresaId], references: [id])
  empresaId      Int
  portoOrigemId  Int
  portoDestinoId Int
  dias           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portoOrigem  CadastroPorto @relation("TransitTimeOrigem", fields: [portoOrigemId], references: [id])
  portoDestino CadastroPorto @relation("TransitTimeDestino", fields: [portoDestinoId], references: [id])

  @@unique([empresaId, portoOrigemId, portoDestinoId])
  @@index([empresaId])
}

// Base local de dados abertos do CNPJ (Receita Federal) que alimenta a fonte
// cnpj_public do Radar. Importada via scripts/import-cnpj-dataset.js.
// Descoberta apenas: contato sai daqui como dado cadastral, nunca inventado.
model CnpjPublicCompany {
  id              String    @id @default(cuid())
  cnpj            String    @unique
  razaoSocial     String
  nomeFantasia    String?
  situacao        String    @default("ativa")
  cnae            String?
  cnaeDescription String?
  porte           String?
  matrizFilial    String?
  openedAt        DateTime?
  phone           String?
  phoneDigits     String?
  email           String?
  website         String?
  address         String?
  city            String?
  state           String?
  normalizedCity  String    @default("")
  // nomeFantasia + razaoSocial + cnae normalizados (minusculo, sem acento) p/ matching de segmento
  searchText      String    @default("")
  rawJson         String?
  // Sócio-administrador vindo do dump da RFB (Socios*.zip) — denormalizado p/ leitura rápida no L4.
  // Quadro completo vive em CnpjPublicPartner (join por cnpjBasico = 8 primeiros dígitos do cnpj).
  ownerName          String?
  ownerQualification String?
  // HOT-01: colunas aditivas do dump RFB (Empresas/Simples/Estabelecimentos) — dado de graça
  // capturado na carga, não descartado. NULL = ainda não carregado/fase 2 (regimeTributario).
  capitalSocial    Decimal?  @db.Decimal(18, 2)
  naturezaJuridica String?
  simples          Boolean?
  mei              Boolean?
  // Lucro Real/Presumido/Arbitrado é dataset separado da RFB, não vem no dump padrão — fase 2.
  regimeTributario String?
  phone2           String?
  // CSV dos códigos de CNAE secundário (cnae_secundario do dump); catálogo em CnpjPublicCnae.
  cnaeSecundarias  String?
  // Anti-contador (base do HOT-03): quantos CNPJs ativos compartilham este phone/email.
  phoneShareCount  Int?
  emailShareCount  Int?
  firstSeenAt      DateTime  @default(now())
  importedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([normalizedCity, state])
  @@index([normalizedCity, cnae])
  @@index([state, cnae])
  @@index([phoneDigits])
}

// Catálogo de CNAE (dump Cnaes.zip da RFB) — código→descrição, usado pelo HOT-02 (picker de
// CNAE por texto). Populado a partir da staging stg_rfb_cnaes no import-cnpj-dataset.js.
model CnpjPublicCnae {
  codigo    String   @id
  descricao String
  updatedAt DateTime @updatedAt
}

// HOT-02: contagem por opção de filtro ("Empresário (Individual) (44.889.600)") cacheada
// 1x/mês pós-import — nunca contada ao vivo (GROUP BY em 28M linhas não responde <1s). `group`
// identifica a dimensão (naturezaJuridica|porte|situacao|matrizFilial|uf), `key` o valor bruto
// da dimensão e `count` o total. Recalculada por scripts/import-cnpj-dataset.js ao fim da carga;
// endpoint só LÊ esta tabela (nunca faz GROUP BY em CnpjPublicCompany por request).
model CnpjBaseStats {
  id          String   @id @default(cuid())
  group       String
  key         String
  label       String?
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([group, key])
  @@index([group])
}

// Quadro societário do dump aberto da RFB (Socios*.zip). Liga em CnpjPublicCompany pelo
// cnpjBasico (8 primeiros dígitos do cnpj) — sócio pertence à EMPRESA, não ao estabelecimento.
// Carga bulk via scripts/import-cnpj-dataset.js (TRUNCATE + reload por mês de referência);
// id BigInt autoincrement de propósito: INSERT cru em SQL não passa pelo cuid() do client.
model CnpjPublicPartner {
  id                       BigInt    @id @default(autoincrement())
  cnpjBasico               String
  // 1 = pessoa jurídica, 2 = pessoa física, 3 = estrangeiro
  identificador            String?
  nome                     String
  // CPF mascarado (***XXXXXX**) ou CNPJ do sócio — como vem no dump
  documento                String?
  qualificationCode        String?
  qualificationDescription String?
  entradaAt                DateTime?
  faixaEtaria              String?
  importedAt               DateTime  @default(now())

  @@index([cnpjBasico])
}

// RAIO-X DE CNPJ EM LOTE (HOT-04, 02/07 — docs/PLANEJAMENTOS/hot/04-enriquecimento-lote.md).
// Histórico/estado de um job de lote colado no painel Owner (:3107): cola até 10k CNPJs → cadastral
// instantâneo (CnpjPublicCompany/BrasilAPI) + enfileira `enrich_lead` (camada vivo, mesma fila da
// fábrica) + IA opcional → gera XLSX em background. ADITIVA: tabela nova isolada, não toca em
// CnpjPublicCompany/Partner (outro worker mexe nelas) nem em RadarFabricaRun/RadarMission.
model CnpjXrayJob {
  id              String    @id @default(cuid())
  status          String    @default("queued") // queued | running_cadastral | running_vivo | running_ia | done | error
  layers          String    // JSON string ["cadastral","vivo","ia"]
  requestedCount  Int       @default(0) // linhas coladas (bruto, antes de validar)
  validCount      Int       @default(0) // CNPJs válidos após DV mod-11 + dedup
  invalidCount    Int       @default(0)
  processedCount  Int       @default(0) // já resolvidos na camada cadastral
  missionsQueued  Int       @default(0) // missões enrich_lead enfileiradas (camada vivo)
  missionsDone    Int       @default(0) // missões enrich_lead já completas
  aiDone          Int       @default(0) // notas/resumo IA já gerados
  invalidReportJson Json?   // relatório do que caiu na validação: [{ raw, reason }]
  resultFileName  String?   // nome do XLSX gerado (histórico/download)
  resultPath      String?   // caminho relativo no disco onde o XLSX foi salvo
  lastError       String?
  requestedByUserId Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
}

// WORM-14 (02/07, docs/PLANEJAMENTOS/worm/14-assistente-ia-wizard.md):
// Assistente IA por empresa. `fluxoJson` guarda o fluxo em LISTA (passos +
// condicoes com few-shots) montado no wizard; o compilador (assistente-flow.ts)
// vira prompt-sistema do MESMO pipeline do bot (Ollama local). `testCounter`
// numera os testes do sandbox ("Teste nº"). `published` = intencao de ligar no
// chip (so efetiva com HBX_ASSISTENTE_PUBLISH_ENABLED). ADITIVA: tabela isolada.
model AssistenteConfig {
  id          String   @id @default(cuid())
  companyId   Int
  nome        String   @default("Assistente")
  tom         String   @default("normal") // formal | normal | descontraido
  perfil      String   @default("vendas") // vendas | suporte
  produtos    String?
  empresaNome String?
  fluxoJson   String   @default("{}")
  published   Boolean  @default(false)
  testCounter Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, updatedAt])
}

model GmailConnection {
  id                     String   @id @default(uuid())
  userId                 Int      @unique
  companyId              Int
  email                  String?
  refreshTokenCiphertext String?
  scope                  String?
  status                 String   @default("connected")
  lastError              String?
  connectedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ===========================================================================
// CONTABIL — contador-robô do dono (/master). Modelos aditivos, prefixo Fiscal*.
// S1: só LÊ receita (MasterBillingLedgerEntry). Campos *Encrypted ficam null
// até S6/S7 (certificado A1 / credencial Serpro — nunca em log/seed/git).
// ===========================================================================

model FiscalProfile {
  id                   Int       @id @default(1) // singleton do dono (1 linha)
  cnpj                 String?
  razaoSocial          String?
  dataAbertura         DateTime?
  regime               String    @default("simples") // simples
  anexoBase            String    @default("V") // nasce no V; Fator R decide III/V
  cnaePrincipal        String    @default("6203-1/00")
  aliquotaIssMunicipal Float? // p/ exibição
  prolaboreAlvoPct     Float     @default(0.28) // Fator R alvo
  certA1Encrypted      String? // S6 — AES-256-GCM, NUNCA em log
  certA1ExpiresAt      DateTime?
  serproCredEncrypted  String? // S7
  updatedAt            DateTime  @updatedAt
}

model FiscalRevenueMonth {
  id                String    @id @default(cuid())
  competencia       String    @unique // "2026-07"
  receitaCaixaCents Int       @default(0) // MP aprovado no mês (regime de caixa)
  receitaNotasCents Int       @default(0) // NFS-e emitidas (S6)
  ajusteManualCents Int       @default(0) // correção do dono, com motivo
  ajusteMotivo      String?
  folhaMesCents     Int       @default(0) // pró-labore bruto do mês
  rbt12Cents        Int       @default(0) // calculado
  folha12mCents     Int       @default(0) // calculado
  fatorR            Float? // folha12m / rbt12
  anexoAplicado     String? // "III" | "V"
  aliquotaEfetiva   Float?
  dasPrevistoCents  Int?
  inssPrevistoCents Int?
  irrfPrevistoCents Int?
  fechadoEm         DateTime? // S5 — mês fechado pelo copiloto
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// CONTABIL S2 — calendário fiscal. 1 linha por (competencia, tipo) de obrigação.
// Máquina de estados: AGUARDANDO_DADOS -> PRONTO -> ARMADO -> TRANSMITIDO -> PAGO
// -> CONFERIDO; ATRASADO é overlay (now > dueDate, estado != CONFERIDO/naoAplicavel).
model FiscalObligation {
  id              String   @id @default(cuid())
  competencia     String // "2026-07" ou "2026-ANUAL" (DEFIS)
  tipo            String // PGDASD | DAS | ESOCIAL_S1200 | DCTFWEB | DARF_INSS | DEFIS | LIVRO_CAIXA
  dueDate         DateTime
  estado          String   @default("AGUARDANDO_DADOS")
  payloadJson     String? // números prontos p/ transmitir (S5)
  resultJson      String? // recibo/nº protocolo/comprovante (marcação manual do dono)
  naoAplicavel    Boolean  @default(false) // ex.: mês sem pró-labore não tem ESOCIAL/DARF
  alertasEnviados String   @default("[]") // ["D-7","D-3",...] — idempotência do alertador
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([competencia, tipo])
  @@index([dueDate])
  @@index([estado])
}

// CONTABIL S4 — Livro Caixa (art. 26 LC 123: TODA movimentação da ME).
// origem/refId com @@unique garante idempotência das entradas AUTOMÁTICAS
// (AUTO_MP espelha MasterBillingLedgerEntry.id; AUTO_OBRIGACAO espelha
// FiscalObligation.id) — MANUAL usa refId=null (sem colisão: Postgres trata
// NULL como distinto em índice único). Lançamento automático NUNCA é editado
// direto — correção é lançamento de ESTORNO novo (trilha limpa, Guardrail).
model FiscalLedgerEntry {
  id           String    @id @default(cuid())
  data         DateTime
  competencia  String // "2026-07" — derivada de `data` (regime de caixa)
  tipo         String // ENTRADA | SAIDA
  categoria    String // RECEITA_ASSINATURA | DAS | DARF_INSS | PROLABORE | DISTRIBUICAO_LUCRO | INFRA | FERRAMENTA | OUTRO | ESTORNO
  descricao    String
  valorCents   Int // sempre positivo; `tipo` decide o sinal no saldo
  origem       String // AUTO_MP | AUTO_OBRIGACAO | MANUAL
  refId        String? // id do MasterBillingLedgerEntry / da FiscalObligation (null p/ MANUAL)
  motivo       String? // obrigatório em lançamento manual e em estorno
  estornaId    String? // aponta pro id do lançamento que este estorno corrige
  anoFechado   Boolean   @default(false) // true = ano fechado (S4 "fechar Livro Caixa"), edição bloqueada
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([origem, refId])
  @@index([competencia, tipo])
  @@index([data])
}

// CONTABIL S5 — comprovante (recibo PGDAS-D, guia/comprovante DAS, print do e-CAC)
// anexado por obrigação. Segue o padrão de storage em disco da casa
// (SellerOnboardingAttachment): arquivo em `storagePath`, metadados no banco.
// É a "pasta-do-contador digital" — listado no card da obrigação do wizard.
// Sem relation formal p/ FiscalObligation (o schema fiscal usa ids soltos por
// design, como FiscalLedgerEntry.refId) — a FK lógica é `obligationId`.
model FiscalComprovante {
  id               String    @id @default(cuid())
  obligationId     String // id da FiscalObligation à qual o comprovante pertence
  competencia      String // "2026-07" — cópia p/ filtro/relatório (regime do wizard)
  tipo             String // PGDASD | DAS | DARF_INSS | ... (tipo da obrigação, cópia)
  originalFilename String
  storedFilename   String
  storagePath      String
  contentType      String?
  byteSize         Int
  sha256           String
  status           String    @default("permanent") // permanent | deleted
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([obligationId, status])
  @@index([competencia])
}

// CONTABIL S5 — histórico do relatório mensal narrativo (determinístico, gerado
// no fechamento do mês pelo copiloto). 1 por competência (o último fechamento
// sobrescreve — upsert). `texto` é o corpo enviado no zap do dono; `payloadJson`
// guarda o snapshot dos números do fechamento (auditoria: o motor é a fonte).
model FiscalMonthlyReport {
  id            String   @id @default(cuid())
  competencia   String   @unique // "2026-07"
  texto         String // relatório narrativo determinístico (o "pensa comigo" por escrito)
  payloadJson   String? // snapshot dos números do fechamento (receita/tributos/fatorR/...)
  enviadoZap    Boolean  @default(false) // best-effort: true se o disparo no zap confirmou
  geradoViaIa   Boolean  @default(false) // true se a reescrita amigável via Ollama foi aplicada
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([competencia])
}

// CONTABIL S6 — NFS-e Nacional automática. 1 FiscalInvoice por pagamento MP
// aprovado (paymentRefId = MasterBillingLedgerEntry.id, @unique = idempotência).
// tomador = a Company cliente do HBX; valorCents é LÍQUIDO de estorno (mesma
// definição líquida-de-estorno do S1/S4). status: PENDENTE → EMITIDA | ERRO |
// CANCELADA (cancelamento SEMPRE manual pelo portal — nunca automatizado). O
// XML retornado (GZip+Base64) e a chaveAcesso (50 chars) ficam guardados p/
// auditoria; nenhum segredo aqui (o certificado mora no cofre, FiscalProfile).
model FiscalInvoice {
  id           String    @id @default(cuid())
  paymentRefId String    @unique // MasterBillingLedgerEntry.id que originou a nota
  competencia  String // "2026-07" — competência de reconhecimento (regime de caixa)
  companyId    Int // tomador (Company cliente do HBX)
  tomadorNome  String? // razão social/nome do tomador (snapshot p/ o DPS)
  tomadorDoc   String? // CNPJ/CPF do tomador (snapshot; só dígitos)
  valorCents   Int // líquido de estorno (base da NFS-e)
  status       String    @default("PENDENTE") // PENDENTE | EMITIDA | ERRO | CANCELADA
  chaveAcesso  String?   @unique // chave de acesso de 50 chars devolvida pelo Sistema Nacional
  numeroDps    String? // nº da DPS (sequencial do emissor)
  xmlGzB64     String? // XML da NFS-e retornado (GZip+Base64) — auditoria
  erroMsg      String? // última mensagem de erro (sem segredo)
  tentativas   Int       @default(0) // nº de tentativas de emissão (retry backoff, máx 3)
  emitidaEm    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([competencia])
  @@index([status])
}

// CONTABIL S6/S7 — trilha de auditoria de TODA chamada a API externa oficial
// (Lei do Contabil nº4). Modelo COMPARTILHADO: NFS-e (S6) e Serpro (S7) gravam
// aqui. requestResumo NUNCA carrega dado sensível (certificado/senha/credencial
// Serpro ficam só no cofre). resultRef = chave de acesso / nº recibo / protocolo.
// aprovadoPor = "auto-flag" (job automático) ou o userId do dono (ação manual).
model FiscalAutomationLog {
  id            String   @id @default(cuid())
  sistema       String // NFSE | SERPRO
  operacao      String // EMITIR_DPS | DECLARAR_PGDASD | GERAR_DAS | ...
  requestResumo String // resumo SEM dados sensíveis (competência, valor, tomador anon.)
  httpStatus    Int?
  sucesso       Boolean
  resultRef     String? // chave de acesso / nº recibo / protocolo
  aprovadoPor   String? // "auto-flag" | userId do dono
  createdAt     DateTime @default(now())

  @@index([sistema, operacao])
  @@index([createdAt])
}
