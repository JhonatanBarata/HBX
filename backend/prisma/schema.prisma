model CustomerProfile {
  id                   String   @id @default(cuid())
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            Int
  sourceConnection     IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId   String?
  name                 String?
  profileName          String?
  nameSource           String?
  nameConfirmed        Boolean  @default(false)
  phone                String?
  phoneNormalized      String?
  email                String?
  document             String?
  externalSource       String?
  externalCustomerId   String?
  status               String   @default("active")
  notes                String?
  // PR18072026 W1 — observação livre do vendedor/entregador sobre o cliente
  // ("deixa na portaria", "cachorro bravo"...). Aditiva/opcional; exposta em
  // listRota (cliente.observacoes), lista/detalhe de clientes e dia-preview.
  observacoes          String?  @db.VarChar(500)
  // BUG 1 (11/07) — coluna ESPELHO de `name` sem acento/caixa, pra busca insensível a
  // acento (`{name:{contains,mode:insensitive}}` vira ILIKE no Postgres, que é
  // acento-SENSÍVEL — "Déia" não bate "Deia"). Gravada pelo service em TODO write de
  // `name` (nucleo-search.util.ts#normalizeSearch); backfillada via `unaccent(lower())`
  // na migration (MESMA saída da função JS pra PT-BR). Escopo desta passada: só
  // CustomerProfile — Contato.nome tem a mesma lacuna, follow-up documentado no service.
  searchName           String?
  firstInboundAt       DateTime?
  lastInboundAt        DateTime?
  botOff               Boolean  @default(false)
  botOffReason         String?
  botOffAt             DateTime?
  // NÚCLEO-CRM N1 (04/07) — a espinha de cadastro. Colunas ADITIVAS/opcionais:
  // CustomerProfile passa a ser a CONTA (PJ com CNPJ ou PF pessoa). Nada aqui é
  // obrigatório nem altera o comportamento existente; leads/vendas/recovery que
  // já usam este model seguem intactos (todos os defaults preservam o legado).
  tipo                 String   @default("pf") // "pj" | "pf"
  cnpj                 String?  // só para tipo pj
  endereco             String?
  // LOGÍSTICA-MOBILE B3 (08/07) — PARTES do endereço em coluna própria. Antes só
  // existiam dentro do texto composto `endereco` ("Rua X, 123 - Centro"); ao reeditar
  // a ficha, número/bairro voltavam vazios e o texto degradava ("… , 456"). DUPLA
  // ESCRITA: `endereco` segue composto e gravado como hoje (rota/deep-link/telas
  // antigas leem `endereco` inteiro) — estas são aditivas, opcionais, legado = null.
  numero               String?
  bairro               String?
  cidade               String?
  uf                   String?
  cep                  String?
  lat                  Float?
  lng                  Float?
  // PAPÉIS (a mesma base filtrada por papel = as 3 janelas Empresas/Contatos/Clientes)
  isLead               Boolean  @default(false)
  isCliente            Boolean  @default(false)
  isFornecedor         Boolean  @default(false)
  origin               String   @default("manual") // "radar" | "manual" | "import"
  // NÚCLEO-CRM N6 (05/07) — CONTRATO de cobrança POR CLIENTE (o "configurável por
  // cliente" do módulo Logística). Colunas ADITIVAS/opcionais: só o vendedor de
  // água configura; leads/vendas/recovery seguem intactos (todos null por default).
  modeloCobranca       String?  // "mensal" | "avulso" | "assinatura" | null (não definido)
  diaFechamento        Int?     // dia do mês em que fecha a fatura (modelo mensal)
  precoPadrao          Float?   // preço padrão da entrega deste cliente (fallback do produto)
  // LOGÍSTICA-MOBILE M4 (05/07) — pagamento condicional na entrega, 2 EIXOS SEPARADOS
  // (regra do dono 04/07, NÃO misturar). Colunas ADITIVAS/opcionais com default seguro:
  //  · formaPagamento = COMO/QUANDO paga. Fonte da verdade do fluxo do app do entregador:
  //    "aberto" (novo/avulso: chips de recebimento aparecem, escolhe no ato) · "mensal"
  //    (fecha no diaFechamento) · "na_hora" (forma FIXA, não escolhe no ato) · "pendura"
  //    (fiado). Costumeiro (≠ aberto) → chips SOMEM na folha de chegada (tela mais simples).
  //  · metodoPadrao = método fixo p/ na_hora ("pix" | "dinheiro").
  //  · contabilizar = entra na contabilidade? Funciona com QUALQUER forma; false → M6 NÃO cria
  //    FinanceiroCharge (invisível a extrato/recovery por design). M4 só LÊ formaPagamento p/ os chips.
  formaPagamento       String   @default("aberto") // aberto | mensal | na_hora | pendura
  metodoPadrao         String?  // pix | dinheiro (só para na_hora)
  contabilizar         Boolean  @default(true)
  // LOGÍSTICA F1 (07/07) — teto de fiado POR CLIENTE (controle de risco). null =
  // sem limite (comportamento atual). O app AVISA o entregador quando o saldo em
  // aberto estoura o teto — nunca bloqueia a entrega.
  limiteFiado          Float?
  // LOGÍSTICA-MOBILE B1 (07/07) — origem da coordenada (lat/lng), pra nunca
  // sobrescrever um pino bom com um ruim. "geocode" (CEP→Nominatim, impreciso no
  // BR) | "gps_cadastro" (GPS do "Usar este local" no cadastro — o dono marcou
  // manualmente, NUNCA sobrescrito) | "gps_entrega" (GPS de ouro da porta real,
  // gravado pelo confirmar quando accuracy<=60m). null = legado (sem origem).
  geoFonte             String?
  // LOGÍSTICA-MOBILE M5 (05/07) — toggle POR CLIENTE do aviso "entregue" no zap.
  // Soma com o global (LogisticaConfig.avisoWhatsEnabled): o N6 só dispara quando
  // ambos true. Default true = mantém o comportamento atual (aditivo/seguro).
  avisarEntrega        Boolean  @default(true)
  // S2 COBRANÇA-WHATS (11/07) — opt-out POR CLIENTE do aviso de COBRANÇA no zap
  // (lançamento + lembrete de vencimento). Independente do avisarEntrega acima.
  // Default true, mas a feature inteira é DORMENTE (HBX_COBRANCA_WHATS_ENABLED
  // OFF + LogisticaConfig.cobrancaWhatsAtiva false) — nada sai sem ligar os dois.
  avisarCobranca       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  atendimentoCustomers AtendimentoCustomer[]
  hbxRecoveryCustomers HbxRecoveryCustomer[]
  debtCases            DebtCase[]
  vendasLeads          VendasLead[]
  contatos             Contato[]
  entregas             Entrega[]
  clienteProdutos      ClienteProduto[]
  // MULTILOCAL (10/07) — N endereços de entrega da mesma CONTA (cobrança segue 1 só,
  // por customerProfileId; multi-local é só ONDE se entrega). Back-relation aditiva.
  locais               LocalEntrega[]
  // NÚCLEO-CRM R2 (05/07) — cobranças linkadas a este cliente (extrato/fechar-mês).
  financeiroCharges    FinanceiroCharge[]
  recoveryDebtItems    RecoveryDebtItem[]
  conversations        CompanyConversation[]
  // PR20072026 W1 — paradas de Leitura de Rota que resolveram para esta conta.
  logisticaLeituraParadas LogisticaLeituraParada[]

  @@unique([companyId, phoneNormalized])
  @@index([companyId, document])
  @@index([sourceConnectionId, externalCustomerId])
  @@index([companyId, status])
  @@index([companyId, isCliente])
  @@index([companyId, tipo])
  // BUG 1 (11/07) — índice de apoio pra busca por `searchName` (contains), escopado
  // por empresa (mesmo padrão dos demais índices de listagem deste model).
  @@index([companyId, searchName])
  // NÚCLEO-CRM R3 (05/07) — 1 conta PJ por CNPJ dentro da empresa (mata a corrida de
  // conta duplicada no pull do Radar). O UNIQUE é PARCIAL (WHERE cnpj IS NOT NULL) — PF
  // sem CNPJ nunca colide —, algo que o Prisma 5.x NÃO expressa no DSL; por isso vive em
  // raw SQL na migration 20260705070000_integridade_espinha (com dedupe ANTES do índice),
  // no mesmo padrão do IntegrationSyncRun. Aqui fica só o @@index de consulta; o índice
  // único parcial ("CustomerProfile_companyId_cnpj_key") está no SQL da migration.
  @@index([companyId, cnpj])
}

// NÚCLEO-CRM N1 (04/07) — a PESSOA dentro da Conta (o dono, o comprador, quem
// recebe a entrega). Filho de CustomerProfile; uma Conta tem N Contatos. Numa
// PF, o contato é ela mesma. `source` registra de onde nasceu (Radar/manual/QSA).
// companyId escalar + relation p/ tenant, no mesmo padrão dos demais models.
// Tabela nova, isolada e aditiva — não altera nada existente.
model Contato {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  customerProfileId String
  nome              String
  cargo             String?
  whatsapp          String?
  phone             String?
  email             String?
  isPrincipal       Boolean  @default(false)
  source            String   @default("manual") // "radar" | "manual" | "cnpj_socio"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  entregas          Entrega[]

  @@index([companyId, customerProfileId])
  @@index([companyId, isPrincipal])
}

// NÚCLEO-CRM N6 (05/07) — módulo LOGÍSTICA (app de entrega, cliente água).
// Uma ENTREGA liga uma Conta (o cliente = CustomerProfile) a um Produto opcional
// (galão 20L) e a um Contato opcional (quem recebe). Ciclo:
//   agendada → em_rota → entregue (ou cancelada).
// Ao "confirmar", grava GPS (deliveredLat/Lng) e — SOMENTE se a flag
// HBX_LOGISTICA_ENABLED estiver ON — dispara WhatsApp "entregue" (via
// ConversationsService, caminho blindado) + lança cobrança conforme contrato.
// Tabela nova, isolada e aditiva — não altera nada existente.
model Entrega {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  customerProfileId String
  contato           Contato? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  contatoId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId         Int?
  // MULTILOCAL (10/07) — ONDE esta entrega vai (opcional). null = usa o endereço/geo
  // do perfil (legado). SetNull: apagar o local não apaga a entrega. Validado no
  // serviço como sendo do mesmo cliente+empresa.
  local             LocalEntrega? @relation(fields: [localId], references: [id], onDelete: SetNull)
  localId           String?
  // Operação Android: o admin habilita a capacidade no usuário e atribui cada
  // entrega explicitamente. Null = ainda sem entregador. Os atores ficam
  // gravados para auditoria mínima sem depender de log de aplicação.
  entregador        User?    @relation("EntregaEntregador", fields: [entregadorId], references: [id], onDelete: SetNull)
  entregadorId      Int?
  atribuidoPor      User?    @relation("EntregaAtribuidaPor", fields: [atribuidoPorUserId], references: [id], onDelete: SetNull)
  atribuidoPorUserId Int?
  atribuidoAt       DateTime?
  quantidade        Int      @default(1)
  valor             Float    @default(0)
  status            String   @default("agendada") // agendada | em_rota | entregue | cancelada
  // L4-A (18/07) — 'avulsa' | 'recorrente' | null. O app filtra "Avulsos" por
  // scheduledAt != null, mas o backend grava scheduledAt em QUALQUER entrega
  // (recorrente inclusive) — sem este campo o filtro contava recorrência como
  // avulso. Aditivo/nullable: legado (null) o app trata como recorrente.
  origem            String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  deliveredAt       DateTime?
  deliveredLat      Float?
  deliveredLng      Float?
  cobrancaStatus    String   @default("pendente") // pendente | lancada | isenta | falhou
  notes             String?
  // LOGÍSTICA-MOBILE M2 (05/07) — colunas ADITIVAS (todas opcionais, default null):
  // rotaOrdem/etaAt alimentam o motor de rota+ETA (M3); whatsappStatus/cobrancaOutcome/
  // recebidoNaHora/receiptMethod são o desfecho do app do entregador (M4/M6);
  // idempotencyKey é a base do offline-first (M8, unique p/ sync sem duplicar).
  rotaOrdem         Int?
  etaAt             DateTime?
  // R4 (05/07 — falha visível): desfecho PERSISTIDO dos efeitos do confirmar.
  //   whatsappStatus  = 'enviado' | 'falhou' | 'pulado' (+ razão em whatsappMotivo)
  //   cobrancaOutcome = 'lancada' | 'aguardando_fechamento' | 'nao_contabilizado' | 'isenta' | 'falhou'
  // avisoReenviado = TETO DURO de 1 reenvio manual do aviso por entrega (guarda o
  // endpoint /reenviar-aviso). Uma vez true, nunca mais reenvia — ZERO loop (chip).
  whatsappStatus    String?  // enviado | falhou | pulado | null
  whatsappMotivo    String?  // razão curta quando falhou/pulado (sem_telefone | aviso_off | erro …)
  cobrancaOutcome   String?  // lancada | aguardando_fechamento | nao_contabilizado | isenta | falhou | null
  avisoReenviado    Boolean  @default(false)
  // AVISO-CHEGANDO (11/07) — trava de idempotência do "tô chegando" a ~500m: null =
  // ainda não avisou. Claim RACE-SAFE via updateMany(WHERE avisoChegandoAt IS NULL) —
  // ver dispararWhatsappChegando (logistica.service.ts). INDEPENDENTE do aviso
  // "entregue" (whatsappStatus acima) — a empresa pode ligar só um dos dois.
  avisoChegandoAt   DateTime?
  recebidoNaHora    Boolean?
  receiptMethod     String?  // pix | dinheiro | fiado | null
  idempotencyKey    String?
  // Comprovante configurável por tenant. Foto/assinatura vivem em
  // EntregaComprovante (arquivo privado + metadata); código esperado nunca é
  // persistido em claro, apenas scrypt(hash+salt). A confirmação guarda ator/data.
  comprovanteCodigoHash String?
  comprovanteCodigoSalt String?
  comprovanteCodigoGeradoAt DateTime?
  comprovanteCodigoGeradoPor User? @relation("EntregaCodigoGeradoPor", fields: [comprovanteCodigoGeradoPorUserId], references: [id], onDelete: SetNull)
  comprovanteCodigoGeradoPorUserId Int?
  comprovanteConfirmadoAt DateTime?
  confirmadoPor     User?    @relation("EntregaConfirmadaPor", fields: [confirmadoPorUserId], references: [id], onDelete: SetNull)
  confirmadoPorUserId Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  itens             EntregaItem[]
  comprovantes      EntregaComprovante[]
  logisticaRouteStop LogisticaRouteStop?
  logisticaTrackingPoints LogisticaTrackingPoint[]
  logisticaTrackingEvents LogisticaTrackingEvent[]
  logisticaTrackedCreditClaims LogisticaTrackedCreditClaim[]

  @@unique([id, companyId])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, scheduledAt])
  @@index([companyId, customerProfileId])
  // LOGÍSTICA-MOBILE M2 — "entregas do dia" idempotentes por [empresa, cliente, dia]:
  // o gerador varre esta faixa e não recria a entrega recorrente de um cliente no
  // mesmo dia (a checagem real é feita no serviço; este índice acelera a varredura).
  @@index([companyId, customerProfileId, scheduledAt])
  @@index([companyId, entregadorId, status, scheduledAt])
}

// LOGÍSTICA MODOS PR1 (13/07) — agregado diário da rota. O modo comercial é
// resolvido uma única vez no início e nunca muda: alterações posteriores da
// configuração só valem para rotas novas. `routeDate` é a data civil canônica
// YYYY-MM-DD de America/Sao_Paulo, sem conversão UTC ambígua.
model LogisticaRoute {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  entregador          User     @relation("LogisticaRouteDriver", fields: [entregadorId, companyId], references: [id, companyId], onDelete: Restrict)
  entregadorId        Int
  routeDate           String   @db.VarChar(10)
  mode                String   @default("ESSENTIAL") // ESSENTIAL | TRACKED (congelado)
  status              String   @default("PLANNED") // PLANNED | INITIALIZING | ACTIVE | COMPLETED | REFUNDING | FAILED
  billingRevision     Int      @default(0) // incrementa ao reservar estorno; invalida prepares antigos
  initializationToken String?  @unique
  initializationLeaseUntil DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  // PR17072026 Onda 1 — "encerrada" OPERACIONAL, decoupled do `status` de
  // cobrança. Encerrar a rota do dia marca isto (o app para de ver a rota como
  // ativa) SEM mexer no ciclo comercial: não vira COMPLETED (que travaria
  // reiniciar no mesmo dia e dispararia o reconciliador de estorno TRACKED).
  // Zerado ao (re)iniciar a rota — 2ª leva no mesmo dia volta a aparecer ativa.
  operationalEndedAt  DateTime?
  lastError           String?  @db.VarChar(500)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  stops               LogisticaRouteStop[]
  essentialClaims     LogisticaEssentialCreditClaim[]
  trackingSession     LogisticaTrackingSession?
  trackedCreditClaims LogisticaTrackedCreditClaim[]

  @@unique([id, companyId])
  @@unique([companyId, entregadorId, routeDate])
  @@index([companyId, status, routeDate])
  @@index([companyId, entregadorId, routeDate])
}

// Snapshot monotônico: uma Entrega pertence a no máximo uma rota comercial e
// recebe uma ordem de inclusão imutável. Recalcular pode mudar Entrega.rotaOrdem
// operacional, mas nunca remove/reinsere a entrega para reduzir cobrança.
model LogisticaRouteStop {
  id            String   @id @default(cuid())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     Int
  route         LogisticaRoute @relation(fields: [routeId, companyId], references: [id, companyId], onDelete: Cascade)
  routeId       String
  delivery      Entrega  @relation(fields: [deliveryId, companyId], references: [id, companyId], onDelete: Restrict)
  deliveryId    String
  snapshotOrder Int
  // PR18072026 W2 (Opus, billing) — coluna da FRENTE DE BILLING (migration é do
  // W1 só pra não conflitar no schema.prisma; comportamento fica 100% em
  // logistica-route-billing.service.ts, que W1 NÃO toca). Default false = 0
  // mudança de cobrança pra paradas existentes.
  billingExempt Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([routeId, snapshotOrder])
  @@unique([deliveryId, companyId])
  @@index([companyId, routeId])
  @@index([companyId, deliveryId])
}

// PR18072026 W1 — "rota-modelo": um roteiro salvo (nome + dia da semana +
// paradas em ordem) que o admin/entregador reaplica sem redigitar tudo. Aplicar
// o modelo é 100% CLIENT-SIDE (o app manda a lista como `ordemManual` no
// planejar/iniciar) — este model só guarda o molde, não participa da rota em si.
model LogisticaRotaModelo {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  Int
  nome       String   @db.VarChar(80)
  diaSemana  Int?     // 1(seg)..7(dom); null = sem dia fixo
  // Array ordenado de { customerProfileId, localId? } — a ORDEM da lista é a
  // ordem do roteiro (o índice vira a ordemManual quando o app aplica o modelo).
  paradasJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

// PR20072026 W1 — "Leitura de Rota": sessão de captura em campo (docs/PLANEJAMENTOS/
// PR20072026/SPEC-LEITURA-DE-ROTA.md). `modo` LEITURA manda GPS a cada parada;
// MANUAL (criar rota manualmente) não manda. Ao finalizar vira uma
// LogisticaRotaModelo (acima) — esta sessão NUNCA cria Entrega/EntregaItem
// (decisão do dono 20/07: item 8 da spec — materializar entregas — CORTADO).
model LogisticaLeituraSessao {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  Int
  userId     Int      // dono da sessão (req.user) — escopo por usuário; nunca 2 ABERTAS ao mesmo tempo
  modo       String   @default("LEITURA") // LEITURA | MANUAL
  status     String   @default("ABERTA")  // ABERTA | FINALIZADA | CANCELADA
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paradas    LogisticaLeituraParada[]

  @@index([companyId, userId, status])
}

// Uma parada capturada dentro de uma LogisticaLeituraSessao. `clientKey` é a
// idempotência do replay offline (o app gera no aparelho e reenvia até
// confirmar) — @@unique([sessaoId, clientKey]) garante que o replay nunca
// duplica cliente/parada. `localEntregaId` tem relation de verdade (memória
// 17/07 — FK órfã sem relation deu P2003 em produção).
model LogisticaLeituraParada {
  id                String   @id @default(cuid())
  sessao            LogisticaLeituraSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  sessaoId          String
  clientKey         String   // idempotência do replay offline
  ordem             Int
  capturadoEm       DateTime
  lat               Float?
  lng               Float?
  accuracy          Float?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  customerProfileId String?
  localEntrega      LocalEntrega? @relation(fields: [localEntregaId], references: [id], onDelete: SetNull)
  localEntregaId    String?
  itensJson         Json     // [{ productId, qtd, valorUnit }]
  telefoneConfirmado Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sessaoId, clientKey])
  @@index([sessaoId, ordem])
}

// ROTA RASTREADA PR2 (14/07) — sessão única e congelada da rota TRACKED.
// O aparelho e o motorista são amarrados também no banco pelo companyId; uma
// rota nunca pode ter duas sessões concorrentes nem trocar de device no meio.
model LogisticaTrackingSession {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  route             LogisticaRoute @relation(fields: [routeId, companyId], references: [id, companyId], onDelete: Cascade)
  routeId           String
  entregador        User     @relation("LogisticaTrackingSessionDriver", fields: [entregadorId, companyId], references: [id, companyId], onDelete: Restrict)
  entregadorId      Int
  device            MobileDevice? @relation(fields: [deviceId, companyId], references: [id, companyId], onDelete: Restrict)
  deviceId          String?
  deviceBoundAt     DateTime?
  status            String   @default("ACTIVE") // ACTIVE | ENDED
  startedAt         DateTime
  endedAt           DateTime?
  hasValidPositions Boolean  @default(false)
  lastPointAt       DateTime?
  lastLatitude      Float?
  lastLongitude     Float?
  lastAccuracyM     Float?
  lastSpeedMps      Float?
  lastBearingDeg    Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  points            LogisticaTrackingPoint[]
  events            LogisticaTrackingEvent[]
  trackedCreditClaims LogisticaTrackedCreditClaim[]

  @@unique([id, companyId])
  @@unique([routeId, companyId])
  @@index([companyId, status, lastPointAt])
  @@index([companyId, entregadorId, status])
  @@index([companyId, deviceId, status])
}

// Fila offline idempotente: clientPointId e sequence pertencem à sessão.
// Apenas pontos aceitos são gravados; rejeições voltam no ACK do lote.
model LogisticaTrackingPoint {
  id             String   @id @default(cuid())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      Int
  session        LogisticaTrackingSession @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)
  sessionId      String
  delivery       Entrega? @relation(fields: [deliveryId, companyId], references: [id, companyId], onDelete: Restrict)
  deliveryId     String?
  clientPointId  String   @db.VarChar(80)
  sequence       Int
  capturedAt     DateTime
  receivedAt     DateTime @default(now())
  latitude       Float
  longitude      Float
  accuracyM      Float
  speedMps       Float?
  bearingDeg     Float?
  eventType      String   @default("PERIODIC") // START | PERIODIC | ARRIVAL | END
  createdAt      DateTime @default(now())

  @@unique([sessionId, clientPointId])
  @@unique([sessionId, sequence])
  @@index([companyId, sessionId, capturedAt])
  @@index([companyId, deliveryId])
}

// Eventos de marco têm chave própria para retries offline de chegada/fim.
model LogisticaTrackingEvent {
  id            String   @id @default(cuid())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     Int
  session       LogisticaTrackingSession @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)
  sessionId     String
  delivery      Entrega? @relation(fields: [deliveryId, companyId], references: [id, companyId], onDelete: Restrict)
  deliveryId    String?
  clientEventId String   @db.VarChar(80)
  type          String   // ARRIVAL | END
  capturedAt    DateTime
  createdAt     DateTime @default(now())

  @@unique([sessionId, clientEventId])
  @@index([companyId, sessionId, capturedAt])
  @@index([companyId, deliveryId])
}

// Claim financeiro de UM bloco iniciado (1..5 entregas únicas) da Rota
// Essencial. A unicidade comercial é empresa+motorista+data+bloco. A tentativa
// é versionada porque uma usageKey já estornada não pode voltar a ser usada.
model LogisticaEssentialCreditClaim {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  route           LogisticaRoute @relation(fields: [routeId, companyId], references: [id, companyId], onDelete: Cascade)
  routeId         String
  entregador      User     @relation("LogisticaEssentialClaimDriver", fields: [entregadorId, companyId], references: [id, companyId], onDelete: Restrict)
  entregadorId    Int
  routeDate       String   @db.VarChar(10)
  blockIndex      Int
  status          String   @default("PENDING") // PENDING | PROCESSING | DEBITED | REFUNDED | FAILED
  billingRevision Int      @default(0) // geração da rota na qual esta tentativa debitou
  billingAttempt  Int      @default(0)
  debitUsageKey   String?  @unique
  processingToken String?  @unique
  leaseUntil      DateTime?
  debitedAt       DateTime?
  refundedAt      DateTime?
  lastError       String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, entregadorId, routeDate, blockIndex])
  @@index([companyId, routeId, status])
  @@index([companyId, entregadorId, routeDate])
}

// ROTA RASTREADA PR3 (14/07) — saga financeira de uma entrega concluída
// durante uma sessão válida. A unicidade comercial é sessão+entrega e impede
// tanto retries quanto chamadas concorrentes de cobrarem novamente.
model LogisticaTrackedCreditClaim {
  id                  String   @id @default(cuid())
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId           Int
  trackingSession     LogisticaTrackingSession @relation(fields: [trackingSessionId, companyId], references: [id, companyId], onDelete: Cascade)
  trackingSessionId   String
  route               LogisticaRoute @relation(fields: [routeId, companyId], references: [id, companyId], onDelete: Cascade)
  routeId             String
  delivery            Entrega  @relation(fields: [deliveryId, companyId], references: [id, companyId], onDelete: Restrict)
  deliveryId          String
  status              String   @default("PENDING") // PENDING | PROCESSING | DEBITED | COMPLETED | REFUNDING | REFUNDED | FAILED
  billingAttempt      Int      @default(0)
  debitUsageKey       String?  @unique
  processingToken     String?  @unique
  leaseUntil          DateTime?
  paidCreditsConsumed Int      @default(0)
  sourceMonth         String?  @db.VarChar(7) // YYYY-MM America/Sao_Paulo; só quando COMPLETED
  debitedAt           DateTime?
  completedAt         DateTime?
  refundedAt          DateTime?
  lastError           String?  @db.VarChar(500)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, trackingSessionId, deliveryId])
  @@index([companyId, routeId, status])
  @@index([companyId, deliveryId])
  @@index([companyId, sourceMonth, status])
  @@index([companyId, status, leaseUntil])
}

// Um grant por empresa+mês de origem. O valor elegível é exclusivamente a
// parcela de lotes pagos consumida pelas claims concluídas; promo nunca entra.
model LogisticaTrackingBonusGrant {
  id                    String   @id @default(cuid())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId             Int
  sourceMonth           String   @db.VarChar(7)
  eligiblePaidCredits   Int      @default(0)
  bonusCredits          Int      @default(0)
  status                String   @default("PENDING") // PENDING | PROCESSING | GRANTED | FAILED
  usageKey              String?  @unique
  processingToken       String?  @unique
  leaseUntil            DateTime?
  expiresAt             DateTime?
  grantedAt             DateTime?
  lastError             String?  @db.VarChar(500)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, sourceMonth])
  @@index([companyId, status, sourceMonth])
  @@index([status, leaseUntil])
}

// Arquivo de comprovante da entrega. Mesmo padrão de storage privado usado por
// SellerOnboardingAttachment/FiscalComprovante: bytes em disco, apenas metadata
// no banco. tipo = foto | assinatura; status = pendente | confirmado | removido.
model EntregaComprovante {
  id               String   @id @default(cuid())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        Int
  entrega          Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  entregaId        String
  tipo             String
  originalFilename String
  storedFilename   String
  storagePath      String
  contentType      String
  byteSize         Int
  sha256           String
  // Chave gerada no app antes de enfileirar o Blob. Retry do mesmo upload
  // devolve a metadata existente sem regravar arquivo.
  clientKey        String?
  status           String   @default("pendente")
  enviadoPor       User?    @relation("EntregaComprovanteEnviadoPor", fields: [enviadoPorUserId], references: [id], onDelete: SetNull)
  enviadoPorUserId Int?
  confirmadoAt     DateTime?
  createdAt        DateTime @default(now())

  @@index([companyId, entregaId, tipo, status])
  @@index([enviadoPorUserId, createdAt])
  @@unique([entregaId, tipo, clientKey])
}

// LOGÍSTICA-MOBILE M2 (05/07) — amarração PRODUTO×CLIENTE + recorrência.
// Diz "o cliente X leva N do produto Y a cada Z dias (ou nos dias W da semana),
// pelo preço acordado". É a agenda da logística: o gerador "entregas do dia"
// (POST /logistica/gerar-dia) varre os vínculos ativos vencidos e materializa
// Entrega + EntregaItem, avançando proximaData. Tabela nova, isolada e aditiva.
model ClienteProduto {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  customerProfileId String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         Int
  // MULTILOCAL (10/07) — em qual local do cliente este vínculo entrega (opcional).
  // null = local principal/perfil (legado). SetNull: apagar o local não apaga o vínculo.
  local             LocalEntrega? @relation(fields: [localId], references: [id], onDelete: SetNull)
  localId           String?
  qtdPadrao         Int      @default(1)
  precoAcordado     Float?   // vence o preço do catálogo/precoPadrao do cliente
  frequenciaDias    Int?     // 7 = semanal (OU use diasSemana; não os dois)
  diasSemana        String?  // "1,3,5" = seg/qua/sex (1=seg … 7=dom)
  proximaData       DateTime?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // TASK 5 (08/07) — @@unique([companyId, customerProfileId, productId]) REMOVIDO
  // de propósito: o dono quer poder vincular o MESMO produto 2× ao mesmo cliente
  // (ex.: 1 galão na segunda, outro na sexta, vínculos separados). gerarDia()
  // agora AGREGA todos os vínculos vencidos do cliente no dia (1 Entrega, N
  // EntregaItem) — ver logistica-recorrencia.service.ts.
  @@index([companyId, ativo, proximaData])
  @@index([companyId, customerProfileId])
  @@index([companyId, productId])
}

// MULTILOCAL (10/07, docs/PLANEJAMENTOS/MULTILOCAL-10072026/CONTRATOS.md) — 1 CONTA
// (CustomerProfile) pode receber em N endereços, cobrada 1 vez só. A cobrança segue da
// CONTA (FinanceiroCharge.customerProfileId); multi-local é só ONDE se entrega — NADA de
// cobrança muda. Tabela nova, isolada e aditiva. Backfill materializa 1 local principal
// por cliente que já tem endereço/geo no perfil (ver migration local_entrega_multi).
model LocalEntrega {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  customerProfileId String
  apelido           String?  // "Casa" | "Loja" | "Depósito" — rótulo curto, opcional
  endereco          String?
  numero            String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  lat               Float?
  lng               Float?
  geoFonte          String?  // geocode | gps_cadastro | gps_entrega (mesma convenção do perfil)
  isPrincipal       Boolean  @default(false)
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  entregas          Entrega[]
  clienteProdutos   ClienteProduto[]
  // PR20072026 W1 — paradas de Leitura de Rota que resolveram para este local.
  logisticaLeituraParadas LogisticaLeituraParada[]

  @@index([companyId, customerProfileId])
  @@index([companyId, customerProfileId, isPrincipal])
}

// LOGÍSTICA-MOBILE M2 (05/07) — item de uma Entrega (multi-produto).
// A Entrega vira um "carrinho": 1..N EntregaItem. Backward-compat: Entrega.quantidade
// e Entrega.valor continuam existindo e são mantidos coerentes (soma dos itens) pelo
// serviço, então o N6 (confirmarEntrega/cobrança) segue funcionando sem tocar nada.
model EntregaItem {
  id           String   @id @default(cuid())
  entrega      Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  entregaId    String
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    Int?
  qtdPrevista  Int      @default(1)
  qtdEntregue  Int?
  valorUnit    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entregaId])
  @@index([productId])
}

// LOGÍSTICA-MOBILE M2 (05/07) — configuração do módulo Logística por EMPRESA
// (1 linha por tenant). Guarda as regras que o admin controla: aviso de WhatsApp,
// raio de chegada/geofence, velocidade média (ETA), cobrança na entrega e os
// opt-ins de módulo (financeiro/recovery) + o gatilho do cron "gerar dia".
// TODOS os toggles têm default seguro; gerarDiaAutomatico=false → cron INERTE.
model LogisticaConfig {
  id                    String   @id @default(cuid())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId             Int
  avisoWhatsEnabled     Boolean  @default(true)
  templateAviso         String?  // variáveis públicas do aviso de entrega
  raioChegadaM          Int      @default(60)
  velocidadeMediaKmH    Int      @default(25)
  tempoParadaMin        Int      @default(5)
  // LOGÍSTICA MODOS PR1 — escolha comercial exclusiva do dono. TRACKED só é
  // efetivo quando este opt-in e a feature flag global também estão ligados.
  // A rota copia o modo ao iniciar; mudar a config não altera rota existente.
  trackingAtivo         Boolean  @default(false)
  modoRotaPadrao        String   @default("ESSENTIAL") // ESSENTIAL | TRACKED
  cobrancaNaEntrega     Boolean  @default(false)
  moduloFinanceiroAtivo Boolean  @default(false)
  moduloRecoveryAtivo   Boolean  @default(false)
  gerarDiaAutomatico    Boolean  @default(false)
  // PR18072026 W1 — "cobrança simples" (opt-in do dono): reservado para a UI
  // do app simplificar a folha de chegada (chips) quando ligado. Só a coluna
  // nasce aqui; o comportamento em si é de outra frente. Default false = 0
  // mudança de comportamento pra quem não ligou.
  cobrancaSimples       Boolean  @default(false)
  // TASK 4 (08/07) — dias da semana em que a empresa TRABALHA (CSV ISO "1,2,3,4,5,6,7",
  // 1=segunda…7=domingo; mesma convenção de ClienteProduto.diasSemana). null = default
  // (sem restrição configurada). Usado pelo pop-up "Gerar entregas" do app pra sugerir
  // só os dias úteis do tenant — não filtra nem bloqueia o gerarDia em si.
  diasTrabalho          String?
  // LOGÍSTICA F1 (07/07) — Pix DIRETO do tenant (BR Code EMV gerado no app, taxa
  // ZERO, sem MP). pixNome/pixCidade são exigidos pelo payload EMV (recebedor).
  // pixChave null = recurso desligado (nenhum QR aparece na entrega).
  pixChave              String?
  pixNome               String?
  pixCidade             String?
  // AVISO-CHEGANDO (11/07) — "tô chegando" no WhatsApp a ~N metros. Reusa o MESMO
  // motor/consentimento do aviso "entregue" (dispararWhatsappChegando), mas é um
  // toggle INDEPENDENTE (avisoWhatsEnabled acima cobre só o "entregue" — a empresa
  // pode ligar um, o outro, os dois ou nenhum). DEFAULT FALSE (feature nova, opt-in
  // — ao contrário do avisoWhatsEnabled legado, que nasce true).
  avisoChegandoEnabled  Boolean  @default(false)
  avisoChegandoTemplate String?  // texto do admin; null = fallback fixo do serviço
  avisoChegandoDistanciaM Int    @default(500) // raio do "tô chegando" (clamp 100–2000 no serviço)
  // S2 COBRANÇA-WHATS (11/07) — toggle POR TENANT da cobrança por WhatsApp (aviso
  // ao lançar + lembrete no vencimento, com Pix copia-e-cola). Só tem efeito com a
  // flag global HBX_COBRANCA_WHATS_ENABLED ligada (padrão flagEnv() && cfg.X, o
  // mesmo do avisoChegando). DEFAULT FALSE — feature nasce dormente nos 2 níveis.
  cobrancaWhatsAtiva    Boolean  @default(false)
  // S3 RESUMO-DIÁRIO (11/07) — resumo do negócio no WhatsApp do DONO do tenant
  // (destino = Company.contactPhone VERIFICADO, envio pelo chip da própria
  // empresa). Só tem efeito com a flag global HBX_RESUMO_DIARIO_ENABLED ligada
  // (mesmo padrão 2 chaves da cobrancaWhatsAtiva acima). DEFAULT FALSE — dormente.
  //   resumoDiarioHora        = hora LOCAL do envio (0-23, relógio do servidor).
  //   resumoDiarioUltimoEnvio = marca de IDEMPOTÊNCIA persistida (1 envio/dia:
  //                             só envia se < hoje 00:00; restart NÃO reenvia).
  resumoDiarioAtivo     Boolean  @default(false)
  resumoDiarioHora      Int      @default(7)
  resumoDiarioUltimoEnvio DateTime?
  // S6 PORTAL-PEDIDO (11/07) — pedido PÚBLICO pelo link /pedido/<token> (o
  // anti-iFood da distribuidora: cliente pede sem login e vira Entrega
  // 'agendada'). Mesmo padrão 2 chaves das features S2/S3: env global
  // HBX_PEDIDO_PUBLICO_ENABLED (default OFF — GET/POST públicos respondem 404)
  // E este toggle por tenant (default false). Token OPACO rotacionável (molde
  // websiteCaptureToken, website-runtime.ts) — NUNCA slug/companyId na URL;
  // null = link nunca gerado (a rota pública não resolve).
  pedidoPublicoAtivo    Boolean  @default(false)
  pedidoPublicoToken    String?  @unique
  // Requisitos combináveis do comprovante. Todos false por padrão: rollout
  // aditivo e seguro; o admin pode exigir qualquer subconjunto dos três.
  comprovanteFotoObrigatoria Boolean @default(false)
  comprovanteAssinaturaObrigatoria Boolean @default(false)
  comprovanteCodigoObrigatorio Boolean @default(false)
  // PR18072026 W-A — módulo Financeiro liga/desliga (3 níveis) + painel Avançado.
  // Formas de pagamento aceitas (o admin desliga a que não usa; cliente legado com
  // a forma desligada continua válido no backend, só some do seletor no app) e o
  // toggle de preço por cliente. Todos default TRUE = zero mudança de comportamento
  // pra quem já usa (empresa existente continua vendo tudo ligado).
  aceitaNaHora          Boolean  @default(true)
  aceitaMensal          Boolean  @default(true)
  aceitaFiado           Boolean  @default(true)
  precoPorClienteAtivo  Boolean  @default(true)
  // Painel Avançado (novo) — cobrança automática. Opt-in: nasce FALSE (feature
  // ainda não construída no fluxo de cobrança em si, só a coluna/toggle nascem aqui).
  cobrancaAutomatica    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId])
}

// S2 COBRANÇA-WHATS (11/07) — marca de IDEMPOTÊNCIA do aviso de cobrança no zap:
// 1 aviso por (chargeId, tipo), à prova de RESTART do container (o teto diário em
// memória protege tráfego; ESTA tabela protege duplicata). A linha nasce como CLAIM
// antes do enfileirar (o @@unique mata corrida); envio que falha remove a marca
// (best-effort) pra o próximo tick poder tentar. chargeId é coluna solta de
// propósito (sem FK pro FinanceiroCharge): trilha de aviso sobrevive a limpeza.
model LogisticaCobrancaAviso {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int
  chargeId  String
  tipo      String   // 'lancamento' | 'vencimento'
  sentAt    DateTime @default(now())

  @@unique([chargeId, tipo])
  @@index([companyId, sentAt])
}

model DebtCase {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  customerProfile    CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  customerProfileId  String
  sourceConnection   IntegrationConnection? @relation(fields: [sourceConnectionId], references: [id])
  sourceConnectionId String?
  sourceProvider     String
  externalDebtId     String?
  amount             Float    @default(0)
  dueDate            DateTime?
  paidAt             DateTime?
  status             String   @default("open")
  rawPayloadJson     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  payments           HbxRecoveryPayment[]
  recoveryDebtItems  RecoveryDebtItem[]

  @@index([companyId, customerProfileId])
  @@index([companyId, status])
  @@index([sourceConnectionId, externalDebtId])
}

model IntegrationConnection {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  provider           String
  instanceName       String
  secretCiphertext   String?
  secretPreview      String?
  status             String   @default("DISCONNECTED")
  lastTestedAt       DateTime?
  lastTestStatus     String?
  lastTestMessage    String?
  lastSyncAt         DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customerProfiles   CustomerProfile[]
  debtCases          DebtCase[]
  syncRuns           IntegrationSyncRun[]
  auvoExternalRecords AuvoExternalRecord[]
  products           Product[]

  @@index([companyId, provider, isActive])
  @@index([companyId, status, lastSyncAt])
}

model IntegrationSyncRun {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         Int
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId      String
  provider          String?
  type              String
  triggerType       String?
  triggeredByUserId Int?
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  status            String   @default("RUNNING")
  importedCount     Int      @default(0)
  updatedCount      Int      @default(0)
  skippedCount      Int      @default(0)
  errorCount        Int      @default(0)
  failedCount       Int      @default(0)
  checkpoint        String?
  errorLog          String?
  errorSummary      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, status, startedAt])
  @@index([connectionId, startedAt])
}

model ExternalWebhookEvent {
  id              String   @id @default(cuid())
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       Int?
  provider        String
  eventId         String
  eventType       String?
  signatureStatus String   @default("unknown")
  payloadHash     String
  // ARQ11 S1 — payload COMPLETO do evento para replay assíncrono (o worker reprocessa
  // a partir daqui; sem isto, o webhook teria de chamar a Graph síncrono na requisição).
  payload         Json?
  // ARQ11 S1 — controle de retry do worker. status agora admite também 'retry' e
  // 'dead_letter' (além de received/processed/rejected). attempts = nº de tentativas de
  // processamento já feitas; nextRetryAt = quando o worker pode reclamar de novo (backoff);
  // lastError = última mensagem de erro do processamento (observabilidade / dead-letter).
  attempts        Int      @default(0)
  nextRetryAt     DateTime?
  lastError       String?
  processedAt     DateTime?
  status          String   @default("received")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([companyId, provider, createdAt])
  @@index([provider, status, createdAt])
  // ARQ11 S1 — índice de claim do worker: varre por (provider, status, nextRetryAt).
  @@index([provider, status, nextRetryAt])
  @@index([payloadHash])
}

// Conexão de página Meta (Facebook/Instagram) → empresa, para intake de Lead Ads.
// 1 página = 1 empresa (pageId @unique). O token da página fica cifrado
// (IntegrationSecretsService). PR14062026013 — primeiro cano de gasto-com-retorno.
model MetaLeadConnection {
  id                    String   @id @default(cuid())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId             Int
  pageId                String   @unique
  pageName              String?
  accessTokenCiphertext String?
  accessTokenPreview    String?
  defaultAssignedUserId Int?
  status                String   @default("active") // active | paused
  lastEventAt           DateTime?
  lastLeadAt            DateTime?
  lastError             String?
  // ARQ11 S1 — quando a página foi assinada no webhook do Meta (POST /{pageId}/subscribed_apps).
  // null = nunca assinada (o Meta não manda evento até isto acontecer — furo de onboarding).
  webhookSubscribedAt   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
}

model AuvoExternalRecord {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  connection         IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId       String
  externalId         String
  title              String?
  status             String?
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  technicianName     String?
  customerName       String?
  sourceUpdatedAt    DateTime?
  rawPayloadJson     String?
  rawPayloadSummaryJson String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, externalId])
  @@index([connectionId, sourceUpdatedAt])
  @@index([companyId, status])
}

// Inbox legado Conversation@InboxConversation + Message@InboxMessage APOSENTADO
// (multi-tenancy Sprint 2, 03/07). Ver nota no lugar do antigo `model Customer`.

model ConversationSession {
  id            Int      @id @default(autoincrement())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     Int
  channel       String   @default("whatsapp")
  from          String
  state         String   @default("NEW")
  context       String? // simple JSON context (serialized)
  lastMessageAt DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderDraft OrderDraft?

  @@index([companyId, from, channel])
  @@index([expiresAt])
}

model OrderDraft {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int                 @unique

  status String  @default("DRAFT") // DRAFT | ABANDONED
  items  String? // JSON serialized (ex: { rawText: "..." })

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Website Kit (Sprint 2, 02/07): tabelas que já existiam em produção como
// "sombra" (criadas em runtime via $executeRawUnsafe em website-runtime.ts).
// Migration correspondente é IDEMPOTENTE (CREATE TABLE IF NOT EXISTS) —
// nomes de colunas/índices abaixo espelham exatamente o que já está no VPS.
model CompanyWebsiteConfig {
  company              Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            Int     @id
  websiteEnabled       Boolean @default(false)
  websitePublicUrl     String?
  websiteAdminUrl      String?
  websiteProjectId     String?
  websiteAdminEnabled  Boolean @default(false)
  websiteLaunchMode    String  @default("public") // public | admin
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([websiteProjectId], name: "CompanyWebsiteConfig_project_idx")
}

model WebsiteAdminEntryToken {
  id               String    @id
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  websiteProjectId String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  usedByIp         String?

  @@index([companyId, expiresAt], name: "WebsiteAdminEntryToken_companyId_expiresAt_idx")
  @@index([userId, expiresAt], name: "WebsiteAdminEntryToken_userId_expiresAt_idx")
}

model User {
  id              Int              @id @default(autoincrement())
  username        String?          @unique
  email           String?          @unique
  emailConfirmedAt DateTime?
  emailConfirmationToken String?   @unique
  emailConfirmationSentAt DateTime?
  emailConfirmationExpiresAt DateTime?
  password        String
  googleId        String?          @unique
  mustChangePassword Boolean     @default(false)
  // Boas-vindas (primeiro acesso, 14/06): null = ainda não viu/dispensou o
  // tutorial; preenchido = resolvido. Existentes nascem resolvidos (backfill no
  // runtime-ensure); novos nascem null = pendentes. Re-armado na troca de senha.
  tutorialCompletedAt DateTime?
  // Ativação / onboarding (28/06, Camada 1): carimbos dos marcos da jornada por
  // papel. JSON = { events: { "<event>": ISO } }. Fonte da verdade do checklist
  // de primeiros passos; o GET também DERIVA dos dados reais (lead puxado, chip
  // conectado, venda fechada) p/ auto-curar quem já fez antes deste recurso.
  onboardingStateJson String?
  name            String?
  phone           String?
  commissionPercent Float          @default(0)
  // Teto de comissão por fechamento (PR13062026007). 0 = sem teto. Admin digita no
  // cadastro do vendedor; o VENDEDOR nunca vê o valor (só a comissão já capada).
  // mensal = limite da comissão recorrente; setup = limite da comissão de implantação.
  commissionMonthlyCap Float       @default(0)
  setupCommissionCap   Float       @default(0)
  // Régua única (PR13062026007 P1): separa Dono (true) de Gerente (false) dentro
  // do papel ADMIN. Gerente = ADMIN que NÃO vê cobrança/plano.
  canViewBilling  Boolean          @default(true)
  canRegisterHbxSellers Boolean    @default(false)
  sellerReferralCommissionPercent Float @default(0)
  referredByUserId Int?
  referredByCommissionPercentSnapshot Float @default(0)
  sellerDistributionMode String     @default("learning")
  sellerDistributionPausedUntil DateTime?
  sellerDistributionDailyLimitOverride Int?
  sellerDistributionNote String?
  sellerDistributionUpdatedAt DateTime?
  // Preferência de segmento/região do vendedor (14/06). Self-service: o próprio
  // vendedor edita (PATCH /profile/preferred-segments). Vira o default do "Puxar
  // leads". JSON canônico = { "segments": string[], "cityRegion": string|null };
  // o leitor tolera também o formato bare-array legado. Aditivo/nullable.
  preferredSegmentsJson String?
  // Afinidade observada (17/06): contador de ações por segmento { "<seg>": N }.
  // Só alimenta o boost ao atingir 3 ações — nunca é "preferência" com 1 ou 2.
  segmentAffinityJson String?
  // Sellers Brains (17/06): null = push ligado; preenchido = push mutado (sino vermelho).
  brainPushMutedAt DateTime?
  botAccessEnabled  Boolean  @default(false)
  referredByUser  User?            @relation("UserSellerReferralNetwork", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers   User[]           @relation("UserSellerReferralNetwork")
  // multi-tenancy S3: Cascade (era SetNull). Excluir a empresa apaga os usuários dela —
  // o banco cascateia num `company.delete()` único. O usuário MASTER do sistema é
  // protegido ANTES do delete (guard em permanentlyDeleteCompanyInternal). A rede de
  // indicação (referredByUserId) é SetNull, então indicações cruzadas viram null, não travam.
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
