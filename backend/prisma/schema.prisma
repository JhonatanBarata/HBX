model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int              @default(0)
  company     Company?         @relation(fields: [companyId], references: [id])
  companyId   Int?
  category    Category?        @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    ProductVersion[]
}

model AutoReplyRule {
  id              Int                 @id @default(autoincrement())
  company         Company             @relation(fields: [companyId], references: [id])
  companyId       Int
  enabled         Boolean             @default(true)
  priority        Int                 @default(0)
  // SQLite doesn't support Prisma enums; store match type as string: EXACT | CONTAINS
  matchType       String              @default("EXACT")
  pattern         String
  caseInsensitive Boolean             @default(true)
  responses       AutoReplyResponse[]
  createdAt       DateTime            @default(now())
}

model AutoReplyResponse {
  id           Int           @id @default(autoincrement())
  rule         AutoReplyRule @relation(fields: [ruleId], references: [id])
  ruleId       Int
  order        Int
  delaySeconds Int           @default(0)
  template     String
}

model InboundMessage {
  id         Int      @id @default(autoincrement())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  Int
  from       String
  body       String
  receivedAt DateTime @default(now())
}

model OutboundMessage {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
  whatsappEndpoint   CompanyWhatsAppEndpoint? @relation(fields: [whatsappEndpointId], references: [id])
  whatsappEndpointId String?
  contactId String?
  to        String
  messageType String @default("text") // text | template
  templateName String?
  templateLanguage String?
  templateComponents String?
  sourceModule String?
  body      String
  // SQLite doesn't support Prisma enums; store status as string: PENDING | SENDING | SENT | FAILED
  status    String  @default("PENDING")

  // WhatsApp Cloud API correlation
  provider           String?   @default("WHATSAPP_CLOUD")
  providerMessageId  String?   @unique
  deliveryStatus     String? // sent | delivered | read | failed
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  lastWebhookAt      DateTime?
  lastWebhookPayload String?

  attemptCount  Int               @default(0)
  maxAttempts   Int               @default(3)
  nextAttemptAt DateTime          @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())
  attempts      OutboundAttempt[]

  message CompanyMessage? @relation("OutboundMessageMessage")

  @@index([companyId, whatsappEndpointId, nextAttemptAt])
}

model OutboundAttempt {
  id           Int             @id @default(autoincrement())
  message      OutboundMessage @relation(fields: [messageId], references: [id])
  messageId    Int
  attemptNo    Int
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  success      Boolean         @default(false)
  httpStatus   Int?
  requestBody  String?
  responseBody String?
  error        String?
}

model WhatsAppWebhookEvent {
  id                Int      @id @default(autoincrement())
  receivedAt        DateTime @default(now())
  kind              String // verify | messages | statuses | unknown
  companyId         Int?
  providerMessageId String?
  payload           String
}

model WhatsAppAuditLog {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  scope     String
  event     String
  level     String   @default("INFO")
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, scope, event])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
