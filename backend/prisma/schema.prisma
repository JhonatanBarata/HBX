// /master → Sistema → Planos. 1 linha por plano (planKey), modulesJson = mapa
// { moduleKey: bool }. É a "caixa do plano" — base viva; a empresa segue isso,
// salvo post-it (CompanyModule) por empresa (só no Full). Semeado de
// COMMERCIAL_PLAN_MODULE_KEYS quando vazio.
model PlanModuleConfig {
  planKey     String   @id
  modulesJson String   @default("{}")
  // PR13062026008: override editável dos VALORES do plano (assentos inclusos,
  // valor do assento extra, parcela, trial e quotas deep/enriquecimento/cards).
  // null = segue o catálogo (commercial-plan-catalog). É a CAIXA editável do
  // plano; o enforcement de quota/cobrança continua no catálogo até a régua de
  // limites ser refeita.
  planInfoJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

