datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Role enum removed for broader connector compatibility; store role as string

model Company {
  id                      Int       @id @default(autoincrement())
  name                    String
  entityType              String    @default("PJ") // PF | PJ
  slug                    String?   @unique
  companyKind             String    @default("tenant") // tenant | platform_infra
  // Opt-in (default false): tenant autorizado a REVENDER planos HBX. Habilita o
  // seletor de plano (List/Lead Plus/Pro) no "Fechar venda" e o salePlanKey no
  // link de contratação. Cliente comum NUNCA vê (default false) — sem privilégio
  // por slug/nome; este flag é a fonte única (mesmo padrão do billingExempt).
  sellsHbxPlans           Boolean   @default(false)
  trialModuleSelection    String? // vendas | recovery
  selectedPlanKey         String? // hbx_lite | hbx_padrao | hbx_melhor
  signupUsesPublicEmail   Boolean   @default(false)
  acquisitionSource       String?
  acquisitionSourceDetail String?
  referralReferrerName    String?
  referralCode            String?
  referralDiscountConsumedAt DateTime?
  // S5 INDICAÇÃO (docs/PLANEJAMENTOS/VISAO-FUTURO/S5-indicacao-com-creditos.md) — programa
  // "indique e ganhe" DORMENTE (flag HBX_INDICACAO_ENABLED, default OFF). NÃO confundir com
  // referralCode/referralReferrerName acima (atribuição de venda HBX / comissão de parceiro —
  // outra semântica). indicacaoCode = código OPACO desta empresa (`ind_` + 8 hex, gerado sob
  // demanda, nunca derivado do nome); indicadaPorCompanyId = empresa que INDICOU esta (gravado
  // no signup com a flag ON; bônus pros dois lados SÓ na 1ª recarga paga aprovada — nunca no
  // cadastro, anti-farm). Migration ADITIVA (2 colunas nullable + índices, zero backfill).
  indicacaoCode           String?   @unique
  indicadaPorCompanyId    Int?
  primaryContactName      String?
  contactEmail            String?
  contactPhone            String?
  // CONFIRMACAO-TELEFONE F2: carimbo de quando o telefone do cadastro foi VERIFICADO
  // por código (OTP WhatsApp/F6). null = não verificado (só digitado). Gate do brinde
  // (HBX_CREDITS_REQUIRE_VERIFIED_PHONE) e dedup anti-farra passam a exigir este carimbo.
  contactPhoneVerifiedAt  DateTime?
  supportEmail            String?
  replyToEmail            String?
  supportWhatsapp         String?
  communicationSettingsJson String?
  taxDocument             String?
  whatsappNumber          String?
  whatsappPhoneNumberId   String?   @unique
  whatsappWabaId          String?
  whatsappAccessToken     String?
  whatsappDisplayNumber   String?
  whatsappStatus          String? // CONNECTED | DISCONNECTED | ERROR
  whatsappStatusError     String?
  whatsappStatusUpdatedAt DateTime?
  whatsappConnectionMode  String    @default("NONE") // NONE | TEMPORARY | OFFICIAL
  whatsappTemporaryStatus String    @default("NOT_CONNECTED") // NOT_CONNECTED | TEMPORARY | ATTENTION
  whatsappTemporaryInstanceKey String?
  whatsappTemporaryProvider String?
  whatsappTemporaryPairingCode String?
  whatsappTemporaryQrCodeData String?
  whatsappTemporaryDisplayNumber String?
  whatsappTemporaryLastSyncAt DateTime?
  whatsappTemporaryConnectedAt DateTime?
  whatsappTemporaryStatusError String?
  whatsappModalStatus      String?
  whatsappModalProvider    String?
  whatsappModalPhone       String?
  whatsappModalConnectedAt DateTime?
  whatsappModalLastError   String?
  whatsappModalUpdatedAt   DateTime?
  // Modelo de atendimento (ordem do dono 20/06): null = admin ainda NÃO escolheu (mostra banner/
  // tutorial); 'shared' = número único da empresa (caixa compartilhada, puxar atendimento);
  // 'individual' = chip por vendedor. Runtime usa effectiveMode = whatsappAttendanceMode ?? 'individual'.
  // NÃO confundir com whatsappConnectionMode (NONE|TEMPORARY|OFFICIAL = provider Meta×temporário).
  whatsappAttendanceMode   String?
  currentWhatsappConnectionSessionId String?
  whatsappMigrationInterestStatus String @default("NONE") // NONE | REQUESTED | CONTACTED | RESOLVED
  whatsappMigrationInterestAt DateTime?
  whatsappMigrationInterestSource String?
  whatsappMigrationWorkflowStatus String @default("NONE") // NONE | REQUESTED | CONTACTED | RESOLVED
  whatsappMigrationLastContactAt DateTime?
  whatsappMigrationInternalNote String?
  mercadoPagoAccessToken    String?
  mercadoPagoStatus         String? // CONNECTED | DISCONNECTED | ERROR
  mercadoPagoStatusError    String?
  mercadoPagoStatusUpdatedAt DateTime?
  mercadoPagoAccountEmail   String?
  mercadoPagoUserId         String?
  useMasterMercadoPagoToken Boolean   @default(false)
  useMasterWhatsAppToken    Boolean   @default(false)
  masterMercadoPagoCredentialKey String?
  masterWhatsAppCredentialKey    String?
  timezone                String?   @default("America/Sao_Paulo")
  isActive                Boolean   @default(true)
  paymentMethod           String    @default("NONE") // NONE | CARD | PIX | BOLETO | MANUAL
  billingCycle           String    @default("MONTHLY") // MONTHLY | ANNUAL
  billingProvider         String    @default("manual") // manual | mercadopago | stripe | apple | google
  // Estado unico da empresa (PR10062026002, pos-DROP): unica fonte persistida.
  // pending_checkout | trial | active | courtesy | overdue | suspended
  status                  String    @default("pending_checkout")
  statusChangedAt         DateTime?
  statusChangedByUserId   Int?
  // MASTER-REFAB S6 (10/07 noite, ordem literal do dono): cortesia morre como CONCEITO de
  // conta — só existem 2 tipos explícitos. 'credit' = self-service, ativa por default, teto
  // real é o saldo de crédito (bloqueio só suspensão/exclusão). 'enterprise' = exceção montada
  // pelo master na ficha (módulos/crédito/preço manuais, mantém a máquina de estados legada).
  // Migration ADITIVA `20260710010000_company_account_type` faz o backfill (cobrança manual
  // ativa OU assinatura MP ativa OU platform_infra → enterprise); daqui pra frente o código
  // seta explícito (signup → credit, wizard master → enterprise).
  accountType             String    @default("credit")
  // Cortesia (funde liberacao manual + isenta): prazo opcional; sem prazo = permanente. Campo
  // FICA (dado fiscal/legado) — não é mais gravado por conta nova (S6); só empresa enterprise
  // legada ainda pode estar num estado que o lê (ver company-access-state.ts).
  courtesyEndsAt          DateTime?
  courtesyReason          String?
  tastePlanKey            String?   // degustação temporária (master concede)
  tasteRevertsAt          DateTime? // data em que volta ao plano original automaticamente
  tastePreviousPlanKey    String?   // plano real da empresa antes do taste
  tasteReason             String?
  tasteGrantedByUserId    Int?
  commercialCardsMonthlyLimitOverride Int?
  commercialCardsDailyLimitOverride   Int?
  dailyDeliveryCapOverride Int?
  creditsEnforceEnabled   Boolean   @default(false)
  seatCap                 Int?     // teto RÍGIDO de assentos por empresa (master) — PR13062026005
  commissionDueBusinessDays Int      @default(3)
  // Régua única (PR13062026007 P1): molho de ACESSO do cargo Vendedor (1 por
  // empresa). USER resolve daqui (não mais por-usuário). JSON de chaves de módulo.
  sellerCargoAccessJson   String?
  // RAMO da empresa (dono, 14/06/2026): segmento(s)-alvo que a empresa quer
  // PROSPECTAR (não é o ramo do próprio negócio). Perguntado no primeiro login do
  // dono. Vira filtro padrão do Radar/Leads e desempata o que cada empresa vê
  // primeiro — a lagoa é COMPARTILHADA, o "não repetir" é por empresa. JSON de strings.
  prospectingSegmentsJson String?
  // Localização escolhida junto do ramo no OOBE. Nullable para preservar empresas
  // existentes e o editor de nicho que atualiza somente os segmentos.
  prospectingEstado       String?
  prospectingCidade       String?
  // OOBE POR CATEGORIA (PR10072026/02, 10/07): categorias de módulo que o DONO escolheu no
  // primeiro acesso (ex.: ["radar","vendas"]). null/vazio = ainda não escolheu (portão
  // pergunta). O mapa categoria→módulos vive em modules/module-categories.ts (fonte única);
  // a escolha materializa post-its em CompanyModule (enabled true/false). ADITIVA, nullable.
  moduleCategoriesJson    Json?
  // Régua única (PR13062026007 PF3): "Central de Implantação" do Full. Registro do
  // master do que foi acordado com este cliente (NÃO fia em cobrança/comissão sozinho
  // — isso é passo de dinheiro separado). setupValue = implantação (one-time);
  // monthlyValueOverride = parcela acordada (override do preço do plano).
  setupValue              Float?
  monthlyValueOverride    Float?
  assistedSetupStatus     String    @default("not_required") // not_required | pending | completed
  assistedSetupRequired   Boolean   @default(false)
  assistedSetupCompletedAt DateTime?
  assistedSetupCompletedByUserId Int?
  assistedSetupNote       String?
  // Trilha de nascimento (multi-tenancy S4): registra COMO a empresa nasceu —
  // por qual porta (signup/convite/provisionamento full), qual preset e o
  // resultado de cada passo do pipeline único. Nullable aditivo; suporte lê pra
  // saber por que uma empresa está sem produto/entitlement sem adivinhar.
  provisioningLedgerJson  String?
  themePreferenceConfig   String?
  billingCardBrand        String?
  billingCardLast4        String?
  billingCardHolderName   String?
  billingCardExpMonth     Int?
  billingCardExpYear      Int?
  billingCardUpdatedAt    DateTime?
  manualDiscountPercent   Float     @default(0)
  freeMonths              Int       @default(0)
  // Crédito proporcional (em centavos) gerado por DOWNGRADE (PR17062026043 B6):
  // sobra do plano maior já pago. Saldo positivo abate na próxima fatura. Aditivo.
  billingCreditCents      Int       @default(0)
  trialStartsAt           DateTime?
  trialEndsAt             DateTime?
  trialNoticeEmailStage   Int       @default(0)
  trialNoticeLastEmailAt  DateTime?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd   DateTime?
  billingGraceStartedAt DateTime?
  billingGraceEndsAt    DateTime?
  billingGraceReason    String?
  billingGraceEmailStage Int      @default(0)
  billingGraceLastEmailAt DateTime?
  billingGraceLastFailureAt DateTime?
  deactivatedAt           DateTime?
  botArmedAt            DateTime?
  botArmChannel         String?   // 'webwhats' | 'meta'
  botArmedByUserId      Int?
  botArmReason          String?
  // Ativação por tipo de bot (22/06): null = desligado; timestamp = ligado + auditoria.
  // Atendimento NÃO usa coluna — fonte é routingRules.globalBotEnabled no config JSON.
  recoveryBotLiveAt         DateTime?
  recoveryBotLiveByUserId   Int?
  prospectingBotLiveAt      DateTime?
  prospectingBotLiveByUserId Int?
  createdAt               DateTime  @default(now())
  products                Product[]
  users                   User[]
  mobileDevices           MobileDevice[]
  mobilePairingCodes      MobilePairingCode[]
  mobileActions           MobileAction[]
  metaLeadConnections     MetaLeadConnection[]
  sellerOnboardings       SellerOnboarding[]
  hbxPartnerReferralCandidates HbxPartnerReferralCandidate[]

  conversations CompanyConversation[]
  messages      CompanyMessage[]
  currentWhatsappConnectionSession WhatsAppConnectionSession? @relation("CompanyCurrentWhatsappConnectionSession", fields: [currentWhatsappConnectionSessionId], references: [id], onDelete: SetNull)
  whatsappConnectionSessions WhatsAppConnectionSession[] @relation("CompanyWhatsappConnectionSessions")
  atendimentoAppointments AtendimentoAppointment[]

  autoReplyRules       AutoReplyRule[]
  inboundMessages      InboundMessage[]
  outboundMessages     OutboundMessage[]
  conversationSessions ConversationSession[]
  orderDrafts          OrderDraft[]
  companyModules       CompanyModule[]
  cadastroFornecedores CadastroFornecedor[]
  cadastroPaises       CadastroPais[]
  cadastroPortos       CadastroPorto[]
  cadastroTransitTimes CadastroTransitTime[]
  deletionRecords      DeletionRecord[]
  whatsappAuditLogs    WhatsAppAuditLog[]
  hbxRecoveryCustomers HbxRecoveryCustomer[]
  recoveryDebtItems RecoveryDebtItem[]
  recoveryDebtAllocations RecoveryDebtAllocation[]
  recoveryAutomationStepRuns RecoveryAutomationStepRun[]
  hbxRecoveryFlowStages HbxRecoveryFlowStage[]
  hbxRecoveryPayments  HbxRecoveryPayment[]
  financeiroCharges    FinanceiroCharge[]
  companySubscriptions CompanySubscription[]
  customerProfiles     CustomerProfile[]
  debtCases            DebtCase[]
  integrationConnections IntegrationConnection[]
  integrationSyncRuns  IntegrationSyncRun[]
  externalWebhookEvents ExternalWebhookEvent[]
  auvoExternalRecords  AuvoExternalRecord[]
  whatsappEndpoints    CompanyWhatsAppEndpoint[]
  techAssistantInteractions TechAssistantInteraction[]
  masterAssumedContextSessions MasterAssumedContextSession[]
  masterSupportAuditLogs MasterSupportAuditLog[]
  teamPolicyAuditLogs TeamPolicyAuditLog[]
  hbxSupportTickets HbxSupportTicket[]
  hbxJobs HbxJob[]
  atendimentoCustomers AtendimentoCustomer[]
  webscrapingSearchHistories WebscrapingSearchHistory[]
  webscrapingSearchRuns WebscrapingSearchRun[]
  webscrapingSearchRunItems WebscrapingSearchRunItem[]
  webscrapingCampaigns WebscrapingCampaign[]
  radarLeadProcessRuns RadarLeadProcessRun[]
  hbxEngineLocks HbxEngineLock[]
  webscrapingUsageLogs WebscrapingUsageLog[]
  radarLeadPools RadarLeadPool[]
  radarMissions RadarMission[] @relation("RadarMissionCompany")
  radarLeadCompanyStates RadarLeadCompanyState[]
  radarLeadEvents RadarLeadEvent[]
  radarAutoDistributionRules RadarAutoDistributionRule[]
  radarDistributionDailyUsages RadarDistributionDailyUsage[]
  vendasLeads         VendasLead[]
  vendasCommissionPayouts VendasCommissionPayout[]
  vendasCommissionReceivables VendasCommissionReceivable[]
  masterNotices       MasterNotice[]
  masterEvents        MasterEvent[]
  billableSeatUsages CompanyBillableSeatUsage[]
  salesProfiles       SalesProfile[]
  vendasAutomationCampaigns VendasAutomationCampaign[]
  vendasAutomationJobs VendasAutomationJob[]
  automationEnrollments AutomationEnrollment[]
  automationStepRuns AutomationStepRun[]
  automationLedgerEvents AutomationLedgerEvent[]
  conversationAssistantRuns ConversationAssistantRun[]
  emailOutboundMessages EmailOutboundMessage[]
  commercialEntitlements CompanyCommercialEntitlement[]
  commercialUsageLogs CompanyCommercialUsageLog[]
  vendasCardComplaints VendasCardComplaint[]
  trialPhoneUsages    TrialPhoneUsage[]
  nightFactoryRewardClaims NightFactoryRewardClaim[]
  whatsappConsentLedgers WhatsappConsentLedger[]
  teamPolicyPresets TeamPolicyPreset[]
  userTeamPolicies UserTeamPolicy[]
  emailSettings CompanyEmailSettings?
  emailTemplates CompanyEmailTemplate[]
  emailAssets CompanyEmailAsset[]
  websiteConfig CompanyWebsiteConfig?
  websiteAdminEntryTokens WebsiteAdminEntryToken[]
  contatos               Contato[]
  entregas               Entrega[]
  entregaComprovantes    EntregaComprovante[]
  clienteProdutos        ClienteProduto[]
  logisticaRoutes        LogisticaRoute[]
  logisticaRouteStops    LogisticaRouteStop[]
  // PR18072026 W1 — roteiros salvos (rota-modelo) da empresa.
  logisticaRotaModelos   LogisticaRotaModelo[]
  // PR20072026 W1 — sessões de "Leitura de Rota" (captura em campo) da empresa.
  logisticaLeituraSessoes LogisticaLeituraSessao[]
  logisticaEssentialClaims LogisticaEssentialCreditClaim[]
  logisticaTrackingSessions LogisticaTrackingSession[]
  logisticaTrackingPoints LogisticaTrackingPoint[]
  logisticaTrackingEvents LogisticaTrackingEvent[]
  logisticaTrackedCreditClaims LogisticaTrackedCreditClaim[]
  logisticaTrackingBonusGrants LogisticaTrackingBonusGrant[]
  // MULTILOCAL (10/07) — N locais de entrega por cliente (back-relation obrigatória).
  locaisEntrega          LocalEntrega[]
  logisticaConfig        LogisticaConfig?
  // S2 COBRANÇA-WHATS (11/07) — marcas de idempotência do aviso de cobrança (back-relation).
  logisticaCobrancaAvisos LogisticaCobrancaAviso[]
  // CRÉDITOS S1 (fundação da carteira, docs/PLANEJAMENTOS/CREDITOS): relação inversa mínima.
  // Módulo credits vive atrás de HBX_CREDITS_ENABLED (default OFF); sem enforcement neste sprint.
  creditWallet  CreditWallet?

  @@index([currentWhatsappConnectionSessionId])
  @@index([companyKind])
  // S5 INDICAÇÃO — contagem de indicadas por indicador (endpoint /credits/indicacao/me).
  @@index([indicadaPorCompanyId])
}

model WhatsAppConnectionSession {
  id              String    @id @default(cuid())
  company         Company   @relation("CompanyWhatsappConnectionSessions", fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  // userId: quem conectou este WhatsApp (050-2). Null = legado/automação (conexão de sistema).
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?
  provider        String    @default("webwhats") // webwhats | meta
  tenantKey       String
  phoneNormalized String?
  displayPhone    String?
  status          String    @default("active") // active | disconnected | archived
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  wipedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  metadataJson    String?
  // WEBWHATS-ARQ3 S3 — projeção canônica do estado de conexão. A VERDADE é o motor ao vivo;
  // estas colunas são o carimbo de frescor dessa verdade, escritas pelo writer ÚNICO
  // (WhatsAppConnectionProjectionService), alimentado pelo webhook connection.update (push)
  // e pelo reconciler central (pull). Consumidores de estado leem daqui — nunca mais um
  // `status === 'active'` cru que mente "Conectado fantasma".
  // lastReconciledAt: quando o app confirmou o estado desta sessão contra o motor.
  lastReconciledAt DateTime?
  // motorState: último estado do socket reportado pelo motor (open | close | connecting | ...).
  motorState       String?

  currentForCompanies Company[] @relation("CompanyCurrentWhatsappConnectionSession")
  conversations CompanyConversation[]
  messages      CompanyMessage[]

  @@index([companyId, status])
  @@index([companyId, provider, phoneNormalized, status])
  @@index([companyId, tenantKey, status])
  @@index([userId, status])
  // WEBWHATS-ARQ3 S3 — leitura por frescor da projeção.
  @@index([companyId, status, lastReconciledAt])
}

model WhatsappConsentLedger {
  id              String   @id @default(cuid())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       Int
  phoneNormalized String
  source          String
  purpose         String
  status          String   @default("active")
  grantedAt       DateTime @default(now())
  revokedAt       DateTime?
  metadataJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, phoneNormalized, status])
  @@index([companyId, purpose, status])
  @@index([companyId, phoneNormalized, purpose, status])
  @@index([companyId, createdAt])
}

model NightFactoryRewardClaim {
  id              String   @id @default(cuid())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       Int?
  scopeKey        String
  leadIdsJson     String
  claimedAt       DateTime @default(now())
  nextAvailableAt DateTime
  windowKey       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadataJson    String?

  @@index([userId])
  @@index([companyId])
  @@index([scopeKey, claimedAt])
  @@index([scopeKey, nextAvailableAt])
  @@index([windowKey])
}

model NightOrder {
  id                 String   @id @default(cuid())
  companyId          Int
  createdByUserId    Int?
  segment            String
  normalizedSegment  String
  city               String?
  state              String?
  normalizedCity     String?
  requireEmail       Boolean  @default(true)
  requireWhatsapp    Boolean  @default(false)
  onlyWithoutWebsite Boolean  @default(false)
  dailyQuota         Int      @default(10)
  status             String   @default("open")
  deliveredTotal     Int      @default(0)
  lastDeliveryDate   String?
  idempotencyKey     String?  @unique
  metadataJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, status])
  @@index([status, updatedAt])
}

model NightOrderDelivery {
  id           String   @id @default(cuid())
  nightOrderId String
  companyId    Int
  reportDate   String
  quantity     Int      @default(0)
  leadIdsJson  String
  statsJson    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([nightOrderId, reportDate])
  @@index([companyId, reportDate])
}

model CompanyCommercialEntitlement {
  id                 String   @id @default(cuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          Int
  key                String
  status             String   @default("active") // active | trialing | canceled | unavailable | blocked | paid | manual | pending_checkout
  source             String   @default("system") // trial | checkout | manual | migration | system
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  metadataJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, status])
  @@index([key, status])
}

model CompanyCommercialUsageLog {
  id           String   @id @default(cuid())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    Int
  userId       Int?
  planKey      String?
  eventType    String
  source       String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([companyId, eventType, createdAt])
  @@index([companyId, userId, eventType, createdAt])
  @@index([planKey, eventType, createdAt])
}

model TrialPhoneUsage {
