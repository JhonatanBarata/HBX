# Localhost seguro para UI/cadastro sem pagamento real.
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
PUBLIC_API_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hbx_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hbx_dev?schema=public"

JWT_SECRET="change-me-local-jwt-secret"
INTEGRATION_SECRET_KEY="change-me-local-integration-secret"
INTERNAL_SECRET=

AUTH_DEBUG_CONFIRMATION_LINK=true
AUTH_DEBUG_RESET_LINK=true
ETHEREAL_AUTO=true

# Mock aprova cobranças/assinaturas só em NODE_ENV=development, sem chamar Mercado Pago.
PAYMENTS_PROVIDER=mock
MERCADO_PAGO_ACCESS_TOKEN=

BOOTSTRAP_SYSTEM_MASTER=true
SYSTEM_MASTER_USERNAME=master
SYSTEM_MASTER_EMAIL=master@hbx.local
SYSTEM_MASTER_PASSWORD=master4961

WHATSAPP_ENABLED=false
WHATSAPP_MODAL_ENABLED=false
WEBSCRAPING_INTERNAL_URL=http://localhost:8501
HBX_SCRAPING_ENGINE_URL=http://localhost:8001

# Rota Rastreada (backend). Manter OFF até sessão/GPS/cobrança estarem publicados.
HBX_LOGISTICA_TRACKING_ENABLED=false

# HBX AI Assistant flags (backend only).
# Use visual=true locally to show the HBX IA layer without automatic sending.
HBX_AI_ASSISTANT_VISUAL_ENABLED=true
HBX_AI_SMART_REPLIES_ENABLED=false
HBX_AI_AUTO_SEND_ENABLED=false
