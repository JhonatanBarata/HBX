HBX_OWNER_LOCAL_TOKEN=troque-por-um-token-local
HBX_OWNER_LOCAL_AGENT_PORT=3107

# Worker profundo: copie estes campos para `.env.local`; nunca versione credenciais reais.
HBX_OWNER_BACKEND_URL=https://api.exemplo.com.br
HBX_LOCAL_DEEP_ENABLED=false
HBX_LOCAL_DEEP_TARGET=production
HBX_LOCAL_DEEP_PRIVATE_TUNNEL=true
HBX_LOCAL_DEEP_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
HBX_LOCAL_ENRICH_DATABASE_URL=postgresql://usuario_executor:senha@127.0.0.1:55432/hbx_prod
HBX_LOCAL_ENRICH_EXPECTED_DATABASE=hbx_prod
HBX_LOCAL_ENRICH_DB_SSL=disable
HBX_LOCAL_ENRICH_PRIVATE_CHANNEL_CONFIRMED=true

# Backend do produto (Banco de Leads, motores locais, Caça de e-mail). Opcional:
# sem token o painel degrada com aviso, não quebra.
HBX_OWNER_BACKEND_URL=http://127.0.0.1:3000
HBX_OWNER_BACKEND_TOKEN=Perspective
HBX_OWNER_COMPANY_ID=2

# Ponte VPS: a coluna VPS da guia Sistema fala com o Ops Control (que já tem SSH).
# O start-owner.ps1 preenche HBX_OWNER_OPS_TOKEN sozinho a partir do .env.ops-control.
HBX_OWNER_OPS_URL=http://127.0.0.1:3099
HBX_OWNER_OPS_TOKEN=
