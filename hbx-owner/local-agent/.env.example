HBX_OWNER_LOCAL_TOKEN=troque-por-um-token-local
HBX_OWNER_LOCAL_AGENT_PORT=3107

# Worker profundo: copie estes campos para `.env.local`; nunca versione credenciais reais.
HBX_OWNER_BACKEND_URL=https://api.exemplo.com.br
HBX_OWNER_OLLAMA_URL=http://127.0.0.1:11434
HBX_LOCAL_DEEP_ENABLED=false
HBX_LOCAL_DEEP_TARGET=production
HBX_LOCAL_DEEP_PRIVATE_TUNNEL=true
HBX_LOCAL_DEEP_WORKER_ID=
HBX_LOCAL_DEEP_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
HBX_LOCAL_DEEP_POLL_BASE_MS=5000
HBX_LOCAL_DEEP_POLL_CAP_MS=300000
HBX_LOCAL_DEEP_LEASE_TTL_SECONDS=900
HBX_LOCAL_DEEP_LAB_TIMEOUT_MS=1200000
HBX_LOCAL_DEEP_MODEL_TIMEOUT_MS=480000
HBX_LOCAL_DEEP_MAX_FAILURES=5

# Proteção automática de recursos; retoma abaixo do limite menos a histerese.
HBX_LOCAL_DEEP_RAM_THROTTLE_PCT=94
HBX_LOCAL_DEEP_CPU_THROTTLE_PCT=95
HBX_LOCAL_DEEP_RESOURCE_HYSTERESIS_PCT=3

# Desentupidor do Local Lab.
HBX_LOCAL_LAB_PORT=3098
HBX_LOCAL_LAB_WATCHDOG_INTERVAL_MS=30000
HBX_LOCAL_LAB_RUNNING_STALE_MS=180000
HBX_LOCAL_LAB_QUEUED_STALE_MS=120000
HBX_LOCAL_LAB_QUARANTINE_AGE_MS=86400000

# Recuperação supervisionada pelo Owner: crawling parado por 5 min reinicia somente o Local Lab.
# Na terceira recuperação dentro de 30 min, abre disjuntor até ação manual.
HBX_LOCAL_DEEP_RECOVERY_SUPERVISOR_PORT=3110
HBX_LOCAL_DEEP_RECOVERY_POLL_MS=30000
HBX_LOCAL_DEEP_RECOVERY_STALE_MS=300000
HBX_LOCAL_DEEP_RECOVERY_WINDOW_MS=1800000
HBX_LOCAL_DEEP_RECOVERY_MAX=3

# Writer restrito via ponta local do túnel; nunca use credencial administrativa.
HBX_LOCAL_ENRICH_DATABASE_URL=postgresql://usuario_executor:senha@127.0.0.1:55432/hbx_prod
HBX_LOCAL_ENRICH_EXPECTED_DATABASE=hbx_prod
HBX_LOCAL_ENRICH_DB_SSL=disable
HBX_LOCAL_ENRICH_DB_ALLOW_SELF_SIGNED=false
HBX_LOCAL_ENRICH_PRIVATE_CHANNEL_CONFIRMED=true

# Backend do produto (Banco de Leads, motores locais, Caça de e-mail). Opcional:
# sem token o painel degrada com aviso, não quebra.
HBX_OWNER_BACKEND_TOKEN=Perspective
HBX_OWNER_COMPANY_ID=2

# Ponte VPS: a coluna VPS da guia Sistema fala com o Ops Control (que já tem SSH).
# O start-owner.ps1 preenche HBX_OWNER_OPS_TOKEN sozinho a partir do .env.ops-control.
HBX_OWNER_OPS_URL=http://127.0.0.1:3099
HBX_OWNER_OPS_TOKEN=
