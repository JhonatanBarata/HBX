# Operational variables for safe production-only commands.
# Copy to .env.production.local and fill real values locally only.
# These values must point to the remote production environment, never localhost.

PROD_BACKEND_URL=https://your-backend.example.com
PROD_FRONTEND_URL=https://your-frontend.example.com
PROD_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=master
INTERNAL_SECRET=
SYSTEM_MASTER_PASSWORD=

# Runtime reminder for backend deploy:
# publish scripts read the PROD_* vars above, but the backend environment must also define
# INTEGRATION_SECRET_KEY, INTERNAL_SECRET and any AUVO_/TAGPLUS_ variables required by the integration contract in use.
# SYSTEM_MASTER_PASSWORD should live only in the deploy provider secret store and is only used for controlled bootstrap/recovery.

# WhatsApp modal engine for the HBX QR-first flow.
WHATSAPP_MODAL_ENABLED=true
WHATSAPP_MODAL_INTERNAL_URL=http://147.15.36.137:8080
WHATSAPP_MODAL_API_KEY=
AUTHENTICATION_API_KEY=
WHATSAPP_MODAL_TIMEOUT_MS=15000
