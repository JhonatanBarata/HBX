# Operational variables for safe production-only commands.
# Copy to .env.production.local and fill real values locally only.
# .env.production.local is local-only and must never be committed.
# These values must point to the remote production environment, never localhost.

PROD_BACKEND_URL=https://api.hbxsystem.com.br
PROD_FRONTEND_URL=https://www.hbxsystem.com.br
PUBLIC_API_BASE_URL=https://api.hbxsystem.com.br
APP_URL=https://www.hbxsystem.com.br
FRONTEND_URL=https://www.hbxsystem.com.br
# Mercado Pago Subscriptions/Preapproval:
# Use MERCADO_PAGO_ACCESS_TOKEN only if not using the MASTER token library in HBX.
MERCADO_PAGO_ACCESS_TOKEN=
# Optional: enables webhook signature validation (x-signature HMAC). When set, MP
# webhooks with an invalid/missing signature are rejected. Get it from the MP
# dashboard (Webhooks > assinatura secreta). Leave empty to keep current behavior.
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Runtime backend examples for Hostinger backend containers.
DATABASE_URL=postgresql://hbx_user:PASSWORD@hbx-postgres:5432/hbx_prod?schema=public&connection_limit=10&pool_timeout=60
DIRECT_URL=postgresql://hbx_user:PASSWORD@hbx-postgres:5432/hbx_prod?schema=public

# Hostinger deploy script.
HOSTINGER_SSH_HOST=187.77.47.18
HOSTINGER_SSH_USER=YOUR_SSH_USER
HOSTINGER_APP_DIR=/path/to/HBX
FORCE_REBOOT_HOSTINGER=false

# Runtime values read by docker-compose.hostinger.yml on the VPS.
POSTGRES_USER=hbx_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hbx_prod
POSTGRES_DATA_VOLUME=hbx-postgres-data
NEXT_PUBLIC_API_URL=https://api.hbxsystem.com.br
NEXT_PUBLIC_PAYMENTS_PROVIDER=mercadopago
WEBSCRAPING_MOCK_MODE=0
GOOGLE_PLACES_API_KEY=
HBX_ENGINE_DEFAULT_COUNT=20
HBX_ENGINE_COUNT=20
# HBX_PUBLISH_ENGINE_COUNT controla quantos motores sobem running no publish.
HBX_PUBLISH_ENGINE_COUNT=1
# HBX_PUBLISH_ENGINE_MAX_COUNT controla a capacidade declarada criada na VPS.
HBX_PUBLISH_ENGINE_MAX_COUNT=20
HBX_ENGINE_MAX_COUNT=20
HBX_ENGINE_HARD_LIMIT=200
HBX_ENGINE_WARM_MIN=1
HBX_ENGINE_WARM_MAX=1
HBX_CLIENT_RESERVED_ENGINES=2
HBX_FACTORY_MIN_ENGINES=1
HBX_FACTORY_MAX_ENGINES=20
HBX_FACTORY_MEMORY_SOFT_PRESSURE_PERCENT=82
HBX_FACTORY_MEMORY_HARD_PRESSURE_PERCENT=85
HBX_FACTORY_MEMORY_PANIC_PRESSURE_PERCENT=88
HBX_ENGINE_GOVERNOR_ENABLED=true
HBX_ENGINE_GOVERNOR_INTERVAL_SECONDS=30
HBX_ENGINE_GOVERNOR_COOLDOWN_SECONDS=120
HBX_ENGINE_DRAIN_TIMEOUT_SECONDS=90
HBX_ENGINE_DOCKER_CLI_PATH=/usr/bin/docker
HBX_RADAR_CLIENT_PRIORITY_START_HOUR=8
HBX_RADAR_CLIENT_PRIORITY_END_HOUR=20
HBX_RADAR_CLIENT_REQUEST_TIMEOUT_MS=25000
HBX_RADAR_CLIENT_FALLBACK_TO_POOL=true
HBX_CAPACITY_ENGINE_2_QUEUE_THRESHOLD=3
HBX_CAPACITY_ENGINE_3_QUEUE_THRESHOLD=10
HBX_CAPACITY_ENGINE_4_QUEUE_THRESHOLD=20
HBX_GOOGLE_EMERGENCY_QUEUE_THRESHOLD=50
HBX_GOOGLE_EMERGENCY_DAILY_LIMIT=500
HBX_GOOGLE_EMERGENCY_MAX_PER_RUN=20
HBX_QUEUE_STUCK_MINUTES=10
HBX_ENGINE_MAX_BUSY_MINUTES=15

# HBX AI Assistant flags (backend only). Keep disabled to preserve the classic Inbox.
HBX_AI_ASSISTANT_VISUAL_ENABLED=false
HBX_AI_SMART_REPLIES_ENABLED=false
HBX_AI_AUTO_SEND_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Webwhats integrated engine.
# Source lives in ./Webwhats inside this HBX repository.
# Set WEBWHATS_DEPLOY_ENABLED=false to skip it for emergency HBX-only deploys.
WEBWHATS_DEPLOY_ENABLED=true
WEBWHATS_SSH_HOST=187.77.47.18
WEBWHATS_SSH_USER=YOUR_SSH_USER
WEBWHATS_SSH_PORT=
WEBWHATS_APP_DIR=
WEBWHATS_RUN_USER=root
WEBWHATS_SYSTEMD_SERVICE=webwhats

INTERNAL_SECRET=
PROD_INTERNAL_SECRET=
SYSTEM_MASTER_PASSWORD=
PROD_TRANSACTIONAL_EMAIL_TEST_ENABLED=false
PROD_TRANSACTIONAL_EMAIL_TEST_TO=

# Runtime reminder for backend deploy:
# The backend environment must also define INTEGRATION_SECRET_KEY, INTERNAL_SECRET
# and any AUVO_/TAGPLUS_ variables required by the integration contract in use.
# SYSTEM_MASTER_PASSWORD should live only in the server secret store and is only
# used for controlled bootstrap/recovery.
# Keep PROD_TRANSACTIONAL_EMAIL_TEST_ENABLED=false by default so deploy retries do not spam the inbox.

# WhatsApp modal engine for the HBX QR-first flow.
WHATSAPP_MODAL_ENABLED=true
WHATSAPP_MODAL_INTERNAL_URL=http://172.18.0.1:8080
WHATSAPP_MODAL_API_KEY=
WHATSAPP_MODAL_TIMEOUT_MS=15000
