# Backend base URL used by the browser and by Next rewrites.
# Local example: http://localhost:3000
# Production example: https://api.hbxsystem.com.br
NEXT_PUBLIC_API_URL=https://api.hbxsystem.com.br

# Mercado Pago public key used by the secure card tokenization UI.
# Local/production value comes from the Mercado Pago app credentials.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
