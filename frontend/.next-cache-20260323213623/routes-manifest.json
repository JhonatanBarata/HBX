{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/hbx/static/:path*",
        "destination": "http://localhost:3000/webscraping/static/:path*",
        "regex": "^/hbx/static(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/hbx/webscraping/:path*",
        "destination": "http://localhost:3000/webscraping/:path*",
        "regex": "^/hbx/webscraping(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/hbx/webscraping",
        "destination": "http://localhost:3000/webscraping",
        "regex": "^/hbx/webscraping(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/dashboard/auto-replies/[id]",
      "regex": "^/dashboard/auto\\-replies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/auto\\-replies/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/importacoes/editar/[id]",
      "regex": "^/dashboard/importacoes/editar/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/importacoes/editar/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
