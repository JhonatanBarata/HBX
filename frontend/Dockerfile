FROM node:24-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_ANDROID_APK_URL
# São DOIS APKs publicados; sem esta ARG o botão do Vendas builda com o
# fallback relativo e os dois botões passam a servir arquivos diferentes só
# por sorte do nginx local — em produção viram o MESMO link, calado.
ARG NEXT_PUBLIC_ANDROID_APK_VENDAS_URL
ARG NEXT_PUBLIC_PAYMENTS_PROVIDER
ARG NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_ANDROID_APK_URL=$NEXT_PUBLIC_ANDROID_APK_URL
ENV NEXT_PUBLIC_ANDROID_APK_VENDAS_URL=$NEXT_PUBLIC_ANDROID_APK_VENDAS_URL
ENV NEXT_PUBLIC_PAYMENTS_PROVIDER=$NEXT_PUBLIC_PAYMENTS_PROVIDER
ENV NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=$NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY

RUN npm run build

EXPOSE 3001

CMD ["npm", "run", "start"]
