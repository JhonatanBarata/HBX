<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- O splash obrigatório do Android 12+ deve parecer o primeiro quadro da
         abertura HBX, não uma tela cinza intermediária do sistema. -->
    <style name="Theme.EntregaShell.NoActionBar" parent="Theme.EntregaShell">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">#050713</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">420</item>
        <item name="android:statusBarColor">#050713</item>
        <item name="android:navigationBarColor">#02040B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
