<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Backup/transfer DESLIGADOS: a credencial pareada, a sessão do WebView e
         os dados locais não podem ir para a nuvem nem migrar para outro aparelho. -->
    <application
        android:name=".HbxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${hbxAppLabel}"
        android:usesCleartextTraffic="${hbxUsesCleartextTraffic}"
        android:theme="@style/Theme.EntregaShell"
        tools:targetApi="s">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Porta do APK: retoma uma rota preparada ou segue para a abertura normal. -->
        <activity
            android:name=".OfflineLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OpeningActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".ClosingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EntregaShell.Closing" />

        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Interface local do flavor. O ticket descartável é consumido pela
             camada nativa e nunca é exposto ao JavaScript empacotado. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".NotificationPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <!-- Ação operacional enviada pelo HBX web: discador ou WhatsApp pessoal.
             Tela privada; cada notificação abre a própria ação e mantém o histórico certo. -->
        <activity
            android:name=".MobileActionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".ChegadaActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EntregaShell.Chegada" />

        <service
            android:name=".RotaService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- FCM só acorda a ponte; telefone, mensagem e lead continuam vindo
             exclusivamente da fila autenticada no VPS. -->
        <service
            android:name=".HbxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reenvia as outboxes SQLite somente quando a rede exigida volta. -->
        <service
            android:name=".TrackingUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".OperationalUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
