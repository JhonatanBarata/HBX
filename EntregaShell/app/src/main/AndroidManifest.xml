<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ALARME EXATO — modo passeio (PasseioAlarme.kt) e despertador da missão
         (MissaoAlarme.kt).

         🔴 USE_EXACT_ALARM SAIU EM 20/08/2026. Ela era declarada aqui com a
         justificativa, escrita neste próprio comentário, de que o app era
         "distribuído fora da Play". Essa premissa morre no dia do upload.
         Na Google Play, USE_EXACT_ALARM é permissão RESTRITA: só se qualifica
         quem É um app de alarme, timer ou calendário. O HBX é um app de ROTA que
         TEM um alarme — o Console barra o upload, e insistir seria declaração
         falsa.

         SCHEDULE_EXACT_ALARM é exatamente a alternativa que a política aponta
         para quem não se qualifica: mesma precisão, sem formulário no Console,
         concedida pelo USUÁRIO. Por isso o `maxSdkVersion="32"` também saiu —
         agora ela vale em todo SDK.

         ⚠️ EM ANDROID 13+ ELA NASCE NEGADA. A queda já era prevista e é suave:
         MissaoAlarme.kt cai em janela de 5 min e PasseioAlarme.kt em 10 min
         quando `canScheduleExactAlarms()` é falso. Quem quiser o minuto certo
         precisa conceder — e o pedido tem que nascer NA TELA ONDE O MOTORISTA
         MARCA A MISSÃO, nunca na abertura: pedir na abertura é o jeito
         conhecido de fazer o usuário negar. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- AGENDADOR DE MISSÃO (02/08): é ela que deixa o despertador da rota
         marcada abrir a tela INTEIRA por cima do bloqueio. Sem ela o alarme
         vira notificação comum — e notificação comum o motorista não vê no
         bolso. Em 14+ o sistema só concede sozinho pra quem é alarme/chamada;
         a notificação leva CATEGORY_ALARM justamente por isso. -->
    <!-- 🔴 USE_FULL_SCREEN_INTENT REMOVIDA EM 20/08/2026 — ela era inútil e cara.
         Desde 22/01/2025 só é pré-concedida a app cujo núcleo é chamada ou alarme; o
         HBX não é nenhum dos dois, e o app NUNCA pedia a permissão ao usuário (o
         caminho ACTION_MANAGE_APP_USE_FULL_SCREEN_INTENT nunca foi implementado).
         Ou seja: em Android 14+ o alarme JÁ caía para notificação heads-up. O que
         sobrava era uma declaração restrita no Play Console em troca de nada.
         O alarme da missão continua vivo por duas vias (MissaoAlarme.kt): notificação
         ongoing que não se dispensa arrastando, e startActivity direto com o app em
         primeiro plano. Perde-se só a tomada de tela cheia em Android <= 13. -->
    <!-- 🔴 REQUEST_INSTALL_PACKAGES SAIU DAQUI EM 20/08/2026.
         Ela habilitava o auto-update (instalar o APK baixado do próprio VPS via
         PackageInstaller) e agora é declarada SÓ em src/canal-site/AndroidManifest.xml.
         Motivo: no Google Play a permissão é restrita a app cujo NÚCLEO é instalar
         apps, e a política diz literalmente que ela "may not be used to perform
         self updates". Estando em main/, ela entrava nos DOIS APKs — inclusive no
         Vendas, onde os métodos já eram no-op e a permissão nunca serviu pra nada.
         Ver docs/Rules/ANDROID-PLAY.md §3.1. -->

    <queries>
        <!-- Android 11+: sem declarar o serviço, a medição nativa pode dizer que
             não há reconhecedor mesmo com o motor de voz instalado. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
    </queries>

    <!-- Backup/transfer DESLIGADOS: a credencial pareada, a sessão do WebView e
         os dados locais não podem ir para a nuvem nem migrar para outro aparelho. -->
    <application
        android:name=".HbxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${hbxAppLabel}"
        android:usesCleartextTraffic="${hbxUsesCleartextTraffic}"
        android:theme="@style/Theme.EntregaShell"
        tools:targetApi="s">

        <!-- 20/08/2026 — MEDIDO NO g15: `NotificationPermissionActivity` apareceu
             DEITADA logo após o login, num aparelho em retrato. Causa: ela, a
             `ClosingActivity` e a `ChegadaActivity` eram as únicas 3 sem trava de
             orientação (vêm assim desde 7308a3d5, 13/07 — não é regressão do
             API 36). Chegada deitada é defeito de campo: é a tela que o motorista
             encara ao parar o caminhão. Agora são 10 de 10 em `portrait`. -->
        <!-- ANDROID 16 IGNORA `screenOrientation` EM TELA >= 600dp (20/08/2026).
             As 10 activities daqui declaram `portrait`, e a casca 2.0 inteira foi
             desenhada, medida e provada em retrato. Sem este opt-out, em tablet,
             dobrável aberto ou Chromebook o app abre em PAISAGEM numa composição
             que nunca foi testada assim — e quem descobre é um testador do teste
             fechado, no pior momento possível.
             É a saída OFICIAL, e ela tem prazo: vale até o app mirar a API 37.
             O conserto definitivo é layout adaptativo; isto é o que segura a
             ponte até lá, e está anotado como dívida em docs/Rules/ANDROID-PLAY.md §6. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Porta do APK: retoma uma rota preparada ou segue para a abertura normal. -->
        <activity
            android:name=".OfflineLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 31/07 (pedido do dono: "queria q o HBX seja reconhecido como app
                 de rota") — LOCALIZAÇÃO VINDA DE FORA. Tocar numa localização
                 recebida no WhatsApp e escolher "Abrir com" dispara um `geo:`;
                 é este filtro que põe o HBX naquela lista, do mesmo jeito que os
                 apps de navegação de mercado. A porta continua sendo esta
                 Activity (sem WebView e sem ponte) — ela só traduz e repassa. -->
            <intent-filter android:label="@string/hbx_abrir_como_rota">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- Link do Google Maps colado/compartilhado. Sem autoVerify: o HBX
                 aparece como OPÇÃO no "Abrir com", nunca sequestra o link. -->
            <intent-filter android:label="@string/hbx_abrir_como_rota">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
            </intent-filter>
            <!-- "Compartilhar → HBX" a partir da conversa. -->
            <intent-filter android:label="@string/hbx_abrir_como_rota">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OpeningActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".ClosingActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EntregaShell.Closing" />

        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Interface local do flavor. O ticket descartável é consumido pela
             camada nativa e nunca é exposto ao JavaScript empacotado. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- `showWhenLocked` na tela principal (02/08, decisão do dono: "faz a 2,
             o celular é de trabalho mesmo").
             Cena: o alarme da missão abre POR CIMA do cadeado, mas o Aceitar caía
             na MainActivity — que ficava presa ATRÁS do bloqueio, sem o sistema
             pedir nada. Da mão do motorista parecia que o botão não fez nada.
             Agora a rota abre direto, sem desbloquear, e voltar pro app com a
             tela apagada também cai na rota.
             ⚠️ TROCA CONSCIENTE, não descuido: quem pegar o aparelho bloqueado vê
             clientes, endereços e a rota do dia. Vale num celular de trabalho
             (foi essa a escolha); num celular pessoal seria vazamento. Se um dia
             o app rodar em aparelho pessoal, esta linha volta a ser decisão. -->

        <!-- Checkout isolado: WebView privada, sem a bridge ampla do shell principal. -->
        <activity
            android:name=".RechargeCheckoutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NotificationPermissionActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <!-- Ação operacional enviada pelo HBX web: discador ou WhatsApp pessoal.
             Tela privada; cada notificação abre a própria ação e mantém o histórico certo. -->
        <activity
            android:name=".MobileActionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".ChegadaActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EntregaShell.Chegada" />

        <!-- AGENDADOR DE MISSÃO (02/08) — o despertador da rota marcada.
             Mesma configuração da ChegadaActivity (acorda a tela, aparece por
             cima do bloqueio, fora dos recentes) porque é o mesmo problema:
             chamar o motorista que não está olhando pro celular. -->
        <activity
            android:name=".MissaoAlarmeActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.EntregaShell.Chegada" />

        <service
            android:name=".RotaService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- FCM só acorda a ponte; telefone, mensagem e lead continuam vindo
             exclusivamente da fila autenticada no VPS. -->
        <service
            android:name=".HbxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reenvia as outboxes SQLite somente quando a rede exigida volta. -->
        <service
            android:name=".TrackingUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".OperationalUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- O auto-update mata o processo ao trocar o pacote e o Android não
             reabre o app sozinho. Este receiver avisa "HBX atualizado — toque
             para abrir". exported=false: MY_PACKAGE_REPLACED é entregue pelo
             sistema ao próprio pacote, ninguém de fora precisa disparar. -->
        <!-- MODO PASSEIO (29/07): dispara a notificação-alarme do tempo-no-lugar.
             exported=false — só o AlarmManager do próprio app dispara. -->
        <receiver
            android:name=".PasseioAlarmReceiver"
            android:exported="false" />

        <!-- AGENDADOR DE MISSÃO (02/08): recebe o alarme da hora marcada.
             exported=false — só o AlarmManager do próprio app dispara. -->
        <receiver
            android:name=".MissaoAlarmReceiver"
            android:exported="false" />

        <!-- Reboot apaga todo alarme agendado no sistema. Sem este receiver,
             reiniciar o celular às 14h fazia a missão das 16:00 sumir CALADA.
             exported=true é exigência do BOOT_COMPLETED (quem entrega é o
             sistema); o filtro aceita só essas ações.

             MY_PACKAGE_REPLACED entrou em 02/08, medido no aparelho: o
             auto-update do APK também apaga os alarmes, e o app atualizado só
             rearmava quando alguém o ABRISSE. Um publish às 15h matava a missão
             das 16:00 em silêncio — o pior tipo de falha que existe aqui. -->
        <receiver
            android:name=".MissaoBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 🔴 O AppAtualizadoReceiver SAIU DAQUI EM 20/08/2026 e agora é declarado
             só em src/canal-site/AndroidManifest.xml — junto da classe, que foi
             para src/canal-site/java/. Ele avisa "HBX atualizado, toque para
             abrir" depois da instalação silenciosa, e num app de loja isso não
             existe: a Play reabre e notifica sozinha.
             O MissaoBootReceiver acima FICA nos dois canais: ele rearma alarme
             depois de reboot/troca de pacote, o que é legítimo em qualquer app. -->

    </application>

</manifest>
