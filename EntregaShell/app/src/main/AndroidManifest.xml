<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- MODO PASSEIO (29/07): alarme EXATO do "tempo no lugar" (PasseioAlarme.kt).
         USE_EXACT_ALARM (33+) é concedida sozinha — app distribuído fora da Play,
         e o alarme é função de despertador de verdade; SCHEDULE_EXACT_ALARM cobre
         as APIs 31-32 (auto-concedida lá). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- AGENDADOR DE MISSÃO (02/08): é ela que deixa o despertador da rota
         marcada abrir a tela INTEIRA por cima do bloqueio. Sem ela o alarme
         vira notificação comum — e notificação comum o motorista não vê no
         bolso. Em 14+ o sistema só concede sozinho pra quem é alarme/chamada;
         a notificação leva CATEGORY_ALARM justamente por isso. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Auto-update (F4): instalar o APK baixado do próprio VPS via PackageInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
    </queries>

    <!-- Backup/transfer DESLIGADOS: a credencial pareada, a sessão do WebView e
         os dados locais não podem ir para a nuvem nem migrar para outro aparelho. -->
    <application
        android:name=".HbxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${hbxAppLabel}"
        android:usesCleartextTraffic="${hbxUsesCleartextTraffic}"
        android:theme="@style/Theme.EntregaShell"
        tools:targetApi="s">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Porta do APK: retoma uma rota preparada ou segue para a abertura normal. -->
        <activity
            android:name=".OfflineLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 31/07 (pedido do dono: "queria q o HBX seja reconhecido como app
                 de rota") — LOCALIZAÇÃO VINDA DE FORA. Tocar numa localização
                 recebida no WhatsApp e escolher "Abrir com" dispara um `geo:`;
                 é este filtro que põe o HBX naquela lista, do mesmo jeito que os
                 apps de navegação de mercado. A porta continua sendo esta
                 Activity (sem WebView e sem ponte) — ela só traduz e repassa. -->
            <intent-filter android:label="@string/hbx_abrir_como_rota">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- Link do Google Maps colado/compartilhado. Sem autoVerify: o HBX
                 aparece como OPÇÃO no "Abrir com", nunca sequestra o link. -->
            <intent-filter android:label="@string/hbx_abrir_como_rota">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
            </intent-filter>
            <!-- "Compartilhar → HBX" a partir da conversa. -->
            <intent-filter android:label="@string/hbx_abrir_como_rota">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OpeningActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".ClosingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EntregaShell.Closing" />

        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Interface local do flavor. O ticket descartável é consumido pela
             camada nativa e nunca é exposto ao JavaScript empacotado. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Checkout isolado: WebView privada, sem a bridge ampla do shell principal. -->
        <activity
            android:name=".RechargeCheckoutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NotificationPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <!-- Ação operacional enviada pelo HBX web: discador ou WhatsApp pessoal.
             Tela privada; cada notificação abre a própria ação e mantém o histórico certo. -->
        <activity
            android:name=".MobileActionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EntregaShell.NoActionBar" />

        <activity
            android:name=".ChegadaActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EntregaShell.Chegada" />

        <!-- AGENDADOR DE MISSÃO (02/08) — o despertador da rota marcada.
             Mesma configuração da ChegadaActivity (acorda a tela, aparece por
             cima do bloqueio, fora dos recentes) porque é o mesmo problema:
             chamar o motorista que não está olhando pro celular. -->
        <activity
            android:name=".MissaoAlarmeActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.EntregaShell.Chegada" />

        <service
            android:name=".RotaService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- FCM só acorda a ponte; telefone, mensagem e lead continuam vindo
             exclusivamente da fila autenticada no VPS. -->
        <service
            android:name=".HbxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reenvia as outboxes SQLite somente quando a rede exigida volta. -->
        <service
            android:name=".TrackingUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".OperationalUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- O auto-update mata o processo ao trocar o pacote e o Android não
             reabre o app sozinho. Este receiver avisa "HBX atualizado — toque
             para abrir". exported=false: MY_PACKAGE_REPLACED é entregue pelo
             sistema ao próprio pacote, ninguém de fora precisa disparar. -->
        <!-- MODO PASSEIO (29/07): dispara a notificação-alarme do tempo-no-lugar.
             exported=false — só o AlarmManager do próprio app dispara. -->
        <receiver
            android:name=".PasseioAlarmReceiver"
            android:exported="false" />

        <!-- AGENDADOR DE MISSÃO (02/08): recebe o alarme da hora marcada.
             exported=false — só o AlarmManager do próprio app dispara. -->
        <receiver
            android:name=".MissaoAlarmReceiver"
            android:exported="false" />

        <!-- Reboot apaga todo alarme agendado no sistema. Sem este receiver,
             reiniciar o celular às 14h fazia a missão das 16:00 sumir CALADA.
             exported=true é exigência do BOOT_COMPLETED (quem entrega é o
             sistema); o filtro aceita só essa ação. -->
        <receiver
            android:name=".MissaoBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AppAtualizadoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
