<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Cores da marca HBX (navy + azul do anel), coerentes com o ícone novo e
         com o fundo da casca (COR_FUNDO na MainActivity). -->
    <style name="Theme.EntregaShell" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">#2E5BFF</item>
        <item name="colorPrimaryDark">#0B1020</item>
        <item name="colorAccent">#2E5BFF</item>
    </style>

    <style name="Theme.EntregaShell.NoActionBar" parent="Theme.EntregaShell">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#050713</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.EntregaShell.Launcher" parent="Theme.EntregaShell.NoActionBar" />

    <style name="Theme.EntregaShell.Closing" parent="Theme.EntregaShell.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- 🔴 `statusBarColor` e `navigationBarColor` SAÍRAM daqui (20/08/2026).
             Em Android 16 (targetSdk 36) os dois são NO-OP: o edge-to-edge é
             obrigatório e quem pinta atrás das barras é o fundo da própria View.
             Deixá-los aqui não quebrava nada — mas atributo que não faz mais
             nada é pior que atributo ausente: no dia em que a moldura escura da
             saída aparecer errada, alguém vai ler estas duas linhas e concluir
             que a cor está resolvida.
             Quem pinta hoje: o `root` da ClosingActivity, com o mesmo #050713
             que estava aqui, cobrindo a tela inteira (ClosingActivity.kt). -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Tela de takeover de chegada (ChegadaActivity) — full-screen, sem status/nav
         bar (o resto é escondido em runtime via WindowInsetsControllerCompat). -->
    <style name="Theme.EntregaShell.Chegada" parent="Theme.EntregaShell.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
