{
	"name": "app-root",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"start": "node index.js",
		"up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
		"down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
		"publish": "node ./scripts/publish.js --yes --message \"Automated publish\"",
		"publish:dry-run": "node ./scripts/publish.js --dry-run",
		"seed:dev": "node ./backend/scripts/seed-dev.js",
		"backup:prod": "node ./scripts/backup-prod.js",
		"verify:prod": "node ./scripts/verify-prod.js"
	}
}

