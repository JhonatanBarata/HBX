{
	"name": "app-root",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"publish": "node ./scripts/ops/publish.js",
		"new": "node ./scripts/release.js",
		"backend:restart": "docker compose -f docker-compose.yml restart backend",
		"backend:logs": "docker compose -f docker-compose.yml logs -f backend",
		"backend:rebuild": "docker compose -f docker-compose.yml up -d --build backend",
		"db:restart": "docker compose -f docker-compose.yml restart db",
		"db:check": "docker compose -f docker-compose.yml exec db pg_isready -U admin -d jhonatan_dev",
		"prisma:generate": "docker compose -f docker-compose.yml exec backend sh -lc \"npx prisma generate --schema=./prisma/schema.prisma\"",
		"prisma:migrate": "docker compose -f docker-compose.yml exec backend sh -lc \"npx prisma migrate deploy --schema=./prisma/schema.prisma\"",
		"front:dev": "cd frontend && npm run dev",
		"git:save": "node ./scripts/commit.js",
		"publish:dry": "node ./scripts/release.js d",
		"diffs:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/watch-diffs.ps1",
		"cleanup:hbx-extra": "node ./scripts/cleanup-hbx-extra-engines-vps.js",
		"up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
		"down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
		"force": "node ./scripts/ops/force.js",
		"verify:prod": "node ./scripts/verify-prod.js",
		"abner": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-abner-firebase.ps1",
		"abner:hosting": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-abner-firebase.ps1 -Only hosting",
		"abner:functions": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-abner-firebase.ps1 -Only functions",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"codex:status": "node ./scripts/codex/hbx-codex-queue.js status",
		"codex:next": "node ./scripts/codex/hbx-codex-queue.js next",
		"codex:show": "node ./scripts/codex/hbx-codex-queue.js show",
		"codex:skip": "node ./scripts/codex/hbx-codex-queue.js skip",
		"master:agent": "node ./hbx-master/local-agent/server.js",
		"master:agent:health": "node ./hbx-master/local-agent/scripts/health-check.js",
		"master:ops": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hbx-master/ops-control/open-hbx-ops-control.ps1",
		"master:ops:start": "docker compose --env-file .env.ops-control -f ./hbx-master/ops-control/docker-compose.yml --project-directory . up -d --build ops-control"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0"
	}
}
